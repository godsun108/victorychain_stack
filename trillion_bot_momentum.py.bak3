# --- metrics v2 bot-aware patch (replaces previous) ---
from collections import defaultdict
from momentum.metrics_hook_v2 import (
    start_metrics as _metrics_start,
    inc_trade as _metrics_inc_trade,
    set_position_size as _metrics_set_position_size,
    set_weekly_pnl as _metrics_set_weekly_pnl,
)
from momentum.weekly_pnl import compute_weekly_pnl as _compute_weekly_pnl
_BOT_ID = os.getenv("BOT_ID", "default")
_METRICS_PORT = int(os.getenv("METRICS_PORT", "9108"))
_LEDGER_FILE = os.getenv("LEDGER_FILE", "runtime/ledger/live_ledger.jsonl")
_EMIT_WEEKLY_PNL = os.getenv("EMIT_WEEKLY_PNL", "1") in ("1", "true", "TRUE")
_metrics_start(_METRICS_PORT, bot_id=_BOT_ID)  # idempotent
_POSITION_SIZE = defaultdict(float)  # signed base units
_last_pnl_emit = 0.0

def _maybe_emit_weekly_pnl():
    if not _EMIT_WEEKLY_PNL:
        return
    global _last_pnl_emit
    now = time.time()
    if now - _last_pnl_emit >= 60:
        try:
            weekly = _compute_weekly_pnl(_LEDGER_FILE)
            _metrics_set_weekly_pnl(weekly, bot_id=_BOT_ID)
        except Exception:
            pass
        _last_pnl_emit = now

def _on_fill_metrics(symbol: str, side: str, qty: float):
    # Normalize symbol to remove '/'
    sym_flat = symbol.replace('/', '')
    # increment trade counter
    _metrics_inc_trade(sym_flat, side, bot_id=_BOT_ID)
    # adjust signed position size
    if side.upper() == 'BUY':
        _POSITION_SIZE[sym_flat] += qty
    else:
        _POSITION_SIZE[sym_flat] -= qty
    _metrics_set_position_size(sym_flat, _POSITION_SIZE[sym_flat], bot_id=_BOT_ID)
    _maybe_emit_weekly_pnl()
# --- end metrics patch v2 ---

