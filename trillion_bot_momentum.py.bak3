#!/usr/bin/env python3
import os

def _snap_for_market(ex, symbol, price, amount, log=None, tag="precheck"):
    try:
        px = float(ex.price_to_precision(symbol, price))
        amt = float(ex.amount_to_precision(symbol, amount))
        info = getattr(ex, "markets", {}).get(symbol, {}) if hasattr(ex, "markets") else {}
        lims = (info.get("limits", {}) or {})
        min_cost = (lims.get("cost", {}) or {}).get("min")
        min_cost = float(min_cost) if min_cost is not None else None
        if min_cost is not None and px * amt < min_cost:
            need = (min_cost / px) * 1.001
            amt = float(ex.amount_to_precision(symbol, need))
        if log: log.info(f"[order-size] {tag} {symbol} amt={amt} px={px} min_cost={min_cost}")
        return px, amt, min_cost
    except Exception as e:
        if log: 
            try: name = type(e).__name__
            except: name = "Exception"
            log.warning(f"[order-size] snap failed ({tag}): {name}: {e}")
        return price, amount, None

