            'confidence': signal.confidence_score,
            'expected_return': signal.expected_return,
            'regime': signal.market_regime.current_regime.value if signal.market_regime else None
        },
        'portfolio_optimization': {
            'assets_count': len(test_assets),
            'quantum_coherence': portfolio_allocation['quantum_coherence'],
            'portfolio_diversity': portfolio_allocation['portfolio_diversity']
        },
        'adaptive_learning': {
            'training_samples': len(training_data),
            'models_trained': len(mcp_system.adaptive_engine.models)
        },
        'system_status': status
    }
    
    with open('next_gen_mcp_demo_results.json', 'w') as f:
        json.dump(demo_results, f, indent=2, default=str)
    
    print(f"\n💾 Demo results saved to next_gen_mcp_demo_results.json")
    print("🏁 Next-Generation MCP Demo Complete!")
    
    return mcp_system, demo_results

if __name__ == "__main__":
    asyncio.run(demo_next_gen_mcp())
