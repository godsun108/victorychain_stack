class MarketRegime(Enum):
    """Advanced market regime classification"""
    BULL_TRENDING = "bull_trending"
    BEAR_TRENDING = "bear_trending"
    RANGE_BOUND = "range_bound"
    HIGH_VOLATILITY = "high_volatility"
    LOW_VOLATILITY = "low_volatility"
    BREAKOUT = "breakout"
    BREAKDOWN = "breakdown"
    ACCUMULATION = "accumulation"
    DISTRIBUTION = "distribution"
    UNKNOWN = "unknown"

class MCPIntelligenceLevel(Enum):
    """MCP intelligence sophistication levels"""
    REACTIVE = "reactive"          # Basic signal following
    ADAPTIVE = "adaptive"          # Learning from performance
    PREDICTIVE = "predictive"      # Forecasting market moves
    PRESCRIPTIVE = "prescriptive"  # Optimal action recommendation
    AUTONOMOUS = "autonomous"      # Full autonomous operation

@dataclass
class MarketRegimeData:
    """Comprehensive market regime analysis"""
    current_regime: MarketRegime
    regime_confidence: float
    regime_duration: int  # Hours in current regime
    regime_transitions: List[Tuple[datetime, MarketRegime]]
    volatility_percentile: float
    trend_strength: float
    momentum_score: float
    mean_reversion_probability: float

