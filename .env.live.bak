MODE=live
EXCHANGE=binanceus
EXCHANGE_ID=binanceus

# --- Exchange auth (Binance.US; keys must be new + IP-whitelisted) ---
BINANCEUS_KEY=pjUvYR6LAv2j0DbpFtoVho99Ao3z38Gc9vblAwGJnoM1bRVFRJawOjX9SaN66I0r
BINANCEUS_SECRET=R7Mdl9VIepvEjK4Swfs0dSlnx06yUYVOzFoEbbNei2TOZSkm7oEDyOjHsKNkY102

# Back-compat shims for adapters that read alt names:
BINANCEUS_API_KEY=${BINANCEUS_KEY}
BINANCEUS_API_SECRET=${BINANCEUS_SECRET}

# Momentum Pack runtime prefs (avoid BTC/ETH in universe, prefer USDT/USD/USDC quotes)
QUOTE_PREFS=USDT,USD,USDC
EXCLUDE_BASES=BTC,ETH
# Lock left empty; dynamic universe will populate
ALLOWED_SYMBOLS=
TIMEFRAME=1m
LOOKBACK_BREAKOUT=20
VOLUME_SURGE_MULT=1.1
RSI_MIN=0
RSI_MAX=85

# --- Fees (bps) ---
TAKER_FEE_BPS=10
MAKER_FEE_BPS=0

# --- Sizing caps ---
MAX_NOTIONAL_PER_ORDER=20
MAX_OPEN_TRADES=1
# 0.2% allocation; keep tiny for launch (earlier 0.9=90% is unsafe)
QUOTE_ALLOC_PCT=0.25
SLIPPAGE_BPS=10
MIN_PROFIT_EXIT_BPS=50
TIMEOUT_MS=20000
ENABLE_RATE_LIMIT=true

# Approvals
APPROVAL_SECRET=choose-a-long-random-string
REQUIRE_APPROVALS=true
APPROVERS=nic@church.example,ops@trust.example
# Auto-renew token (avoid mid-run expiry)
APPROVAL_TTL_SECONDS=300
APPROVAL_RENEW_MARGIN=60
APPROVAL_TOKEN_PATH=runtime/APPROVAL_TOKEN.txt

# ISO banking (legacy knobs)
ISO_BANK_PCT=0.0
ISO_COINS=XRP,XLM,XDC,ALGO,IOTA,HBAR,QNT
ISO_MIN_PROFIT_USD=1.0

# Auto-approval minting (runner will refresh token)
APPROVAL_AUTO_MINT=true

# XRP auto top-up to ensure quote liquidity for entries
AUTO_TOPUP_FROM_XRP=true
TOPUP_XRP_PERCENT=0.90

# Runtime
LEDGER_PATH=./runtime/ledger/live_ledger.jsonl
SMOKE_LOG=./runtime/logs/smoke_live.log
# Exports (chain handoff)
EXPORTS_DIR=runtime/exports
EXPORT_SESSION_CRON_MINUTES=60

# Enable strict rehearsal (dry-run); flip to false when green
DRY_RUN=false

# --- Dynamic trading universe (broad market) ---
DYNAMIC_UNIVERSE=1
UNIVERSE_QUOTES=USDT,USD
UNIVERSE_MIN_24H_USD=2000000     # only trade pairs with >= $2M 24h volume
UNIVERSE_MAX_PAIRS=15
UNIVERSE_EXCLUDE=                # e.g., BTC/USDT,ETH/USDT

# --- Treasury banking (reserves only in XRP + HBAR) ---
TREASURY_PCT=0.25
BANK_ASSETS=XRP,HBAR
BANK_SPLITS=0.5,0.5              # 50/50 split
BANK_MIN_CONVERT_USD=50
ALLOW_WITHDRAWALS=0              # keep 0 until steward/flamekeeper approves
ROLE=member

# VictoryChain Gateway (optional; for make anchor)
VICTORYCHAIN_GATEWAY_URL=http://127.0.0.1:8787
VICTORYCHAIN_API_KEY=dev
VICTORYCHAIN_TIMEOUT_S=15
