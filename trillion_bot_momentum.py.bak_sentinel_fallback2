def _snap_for_market(client, symbol, price, amount, log=None, tag="precheck"):
    """Snap price/amount to precision and enforce min notional.
    Returns (price, amount, min_cost). Safe: falls back to originals on error.
    """
    try:
        # Ensure markets loaded once
        if not getattr(client, 'markets', None):
            try:
                client.load_markets()
            except Exception:
                pass
        px = float(client.price_to_precision(symbol, price)) if price is not None else None
        amt = float(client.amount_to_precision(symbol, amount))
        info = getattr(client, 'markets', {}).get(symbol, {}) if hasattr(client, 'markets') else {}
        lims = (info.get('limits', {}) or {})
        min_cost = (lims.get('cost', {}) or {}).get('min')
        # Fallback: derive min_notional from raw filters if cost.limits absent
        if (min_cost is None) and info.get('info'):
            try:
                for f in info['info'].get('filters', []):
                    if f.get('filterType') in ('MIN_NOTIONAL', 'NOTIONAL'):
                        cand = f.get('minNotional') or f.get('notional')
                        if cand is not None:
                            min_cost = float(cand)
            except Exception:
                pass
        min_cost_f = float(min_cost) if min_cost not in (None, '') else None
        if min_cost_f is not None and px is not None and px * amt < min_cost_f:
            need = (min_cost_f / max(px, 1e-12)) * 1.001
            try:
                amt = float(client.amount_to_precision(symbol, need))
            except Exception:
                amt = need
        if log:
            log.info(f"[order-size] {tag} {symbol} amt={amt} px={px} min_cost={min_cost_f}")
        return px, amt, min_cost_f
    except Exception as e:
        if log:
            try:
                name = type(e).__name__
            except Exception:
                name = 'Exception'
            log.warning(f"[order-size] snap failed ({tag}): {name}: {e}")
        return price, amount, None

