                    },
                    "execution_lessons": {
                        "entry_timing": {"rsi_range": [30, 40], "volume_spike": True},
                        "exit_timing": {"rsi_range": [70, 80], "profit_targets": [0.3, 0.6, 1.2]},
                        "gas_efficiency": {"batch_size": 5, "optimal_hours": [2, 3, 8, 9]},
                        "market_adaptation": {"bull_multiplier": 1.3, "bear_protection": 0.7}
                    },
                    "performance_history": {
                        "bull_market_roi": 3.2,
                        "bear_market_roi": -0.8,
                        "sideways_roi": 0.5,
                        "volatility_handling": 8.5,
                        "gas_efficiency_score": 7.2
                    }
                },
                "MAGIC": {
                    "successful_patterns": {
                        "optimal_allocation_range": [22.0, 32.0],
                        "risk_tolerance": 0.58,
                        "momentum_threshold": 8.1,
                        "volume_confirmation": 1.3,
                        "sector_correlation": 0.92,
                        "nft_integration_weight": 0.90,
                        "community_strength_multiplier": 1.2,
                        "developer_activity_bonus": 1.15
                    },
                    "execution_lessons": {
                        "entry_timing": {"rsi_range": [25, 35], "volume_spike": True},
                        "exit_timing": {"rsi_range": [65, 75], "profit_targets": [0.4, 0.8, 1.5]},
                        "gas_efficiency": {"batch_size": 7, "optimal_hours": [1, 2, 7, 8, 9]},
                        "market_adaptation": {"bull_multiplier": 1.4, "bear_protection": 0.8}
                    },
                    "performance_history": {
                        "bull_market_roi": 4.1,
                        "bear_market_roi": -0.5,
                        "sideways_roi": 0.8,
                        "volatility_handling": 8.8,
                        "gas_efficiency_score": 8.1
                    }
                }
            },
            "learned_patterns": {
                "gaming_sector_multipliers": {
                    "nft_integration_bonus": 1.25,
