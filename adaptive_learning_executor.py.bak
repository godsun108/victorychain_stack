                    "stop_loss_adaptation": {"high_confidence": -8.0, "medium": -12.0, "low": -18.0},
                    "profit_taking_stages": [0.25, 0.5, 1.0, 2.0, 5.0]
                },
                "gas_optimization_insights": {
