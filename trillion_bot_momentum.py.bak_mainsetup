# ---- Utility: risk evaluation ----

def _risk_update_metrics():
    METRIC_DAILY_REAL.labels(BOT_ID).set(RISK.realized_today)
    drawdown = 0.0
    if RISK.peak_realized > 0:
        drawdown = (RISK.peak_realized - RISK.realized_today)/RISK.peak_realized*100.0
    METRIC_DD_PCT.labels(BOT_ID).set(drawdown)
    # clear gauges for reasons first (simple approach: just set current reason=1 else 0 for a small set)
    for reason in ['daily_loss','drawdown']:
        val = 1 if RISK.risk_block_reason==reason else 0
        METRIC_RISK_BLOCK.labels(BOT_ID, reason).set(val)


def _check_day_rollover():
    global TODAY
    cur_day = now_utc().date().isoformat()
    if cur_day != RISK.last_reset_day:
        # rollover
        _write_ledger('DAILY_RESET', {'prev_day': RISK.last_reset_day, 'model_version': MODEL_VERSION})
        audit('DAILY_RESET', {'prev_day':RISK.last_reset_day})
        RISK.realized_today = 0.0
        RISK.peak_realized = 0.0
        RISK.last_reset_day = cur_day
        RISK.risk_block_reason = None
        TODAY = cur_day


def _risk_gate_new_entry() -> bool:
    # returns True if allowed
    _check_day_rollover()
    # evaluate limits
    # daily loss
    if RISK.realized_today <= -CFG['DAILY_MAX_LOSS_USD']:
        if RISK.risk_block_reason != 'daily_loss':
            RISK.risk_block_reason='daily_loss'; RISK.last_block_ts=time.time()
            _write_ledger('RISK_LIMIT_TRIGGER', {'reason':'daily_loss','realized_today':RISK.realized_today})
            audit('RISK_LIMIT_TRIGGER', {'reason':'daily_loss','realized_today':RISK.realized_today})
        return False
    # drawdown
    if RISK.peak_realized > 0:
        dd_pct = (RISK.peak_realized - RISK.realized_today)/RISK.peak_realized*100.0
        if dd_pct >= CFG['INTRADAY_MAX_DRAWDOWN_PCT']:
            if RISK.risk_block_reason != 'drawdown':
                RISK.risk_block_reason='drawdown'; RISK.last_block_ts=time.time()
                _write_ledger('RISK_LIMIT_TRIGGER', {'reason':'drawdown','drawdown_pct':dd_pct})
                audit('RISK_LIMIT_TRIGGER', {'reason':'drawdown','drawdown_pct':dd_pct})
            return False
    # panic file
    if os.path.exists(PAUSE_FILE):
        if RISK.risk_block_reason != 'panic_file':
            RISK.risk_block_reason='panic_file'; RISK.last_block_ts=time.time()
            audit('RISK_LIMIT_TRIGGER', {'reason':'panic_file'})
        return False
    # else clear non-hard reasons
    if RISK.risk_block_reason in ('daily_loss','drawdown','panic_file'):
        # keep until manual day reset or condition clears (for panic remove file)
        if RISK.risk_block_reason=='panic_file' and not os.path.exists(PAUSE_FILE):
            RISK.risk_block_reason=None
        elif RISK.risk_block_reason in ('daily_loss','drawdown'):
            # stay blocked rest of day
            pass
    return RISK.risk_block_reason is None

# ---- Order / Fill Simulation (since fills not streamed) ----

def _estimate_slippage_bps(intended_px: float, exec_px: float) -> float:
    try:
        return abs(exec_px-intended_px)/max(intended_px,1e-12)*10000.0
    except Exception:
        return 0.0


def _record_fill(symbol: str, side: str, qty: float, price: float, is_close: bool):
    # Realized pnl only on close (long only model)
    realized = 0.0
    if is_close:
        pos = POSITIONS.get(symbol)
        if pos:
            realized = (price - pos.entry_price) * qty - (CFG['TAKER_FEE_BPS']/10000.0)*price*qty
            RISK.realized_today += realized
            RISK.peak_realized = max(RISK.peak_realized, RISK.realized_today)
    _write_ledger('FILL', {
        'symbol': symbol,
        'side': side,
        'qty': qty,
        'price': price,
        'realized_pnl_delta': realized,
        'realized_pnl_today': RISK.realized_today,
    })
    audit('FILL', {'symbol':symbol,'side':side,'qty':qty,'price':price,'realized':realized})
    _risk_update_metrics()

# ---- Signal Logic (simplified momentum breakout) ----
# We will fetch recent candles via CCXT if available; fallback to ticker

def _fetch_ohlcv(symbol: str, limit: int) -> Optional[List[List[float]]]:
    try:
        return CLIENT.fetch_ohlcv(symbol, timeframe='5m', limit=limit)
    except Exception:
        return None


def _should_open_long(symbol: str) -> Optional[Dict[str,Any]]:
    candles = _fetch_ohlcv(symbol, CFG['LOOKBACK_BREAKOUT'])
    if not candles or len(candles) < 5:
        return None
    closes = [c[4] for c in candles]
    highs = [c[2] for c in candles]
    last_close = closes[-1]
    prev_high_window = max(highs[-CFG['LOOKBACK_BREAKOUT']:-1]) if len(highs) >= CFG['LOOKBACK_BREAKOUT'] else max(highs[:-1])
    if last_close > prev_high_window:
        return {'price': last_close, 'breakout_ref': prev_high_window}
    return None


def _should_close_long(symbol: str, pos: Position) -> Optional[Dict[str,Any]]:
    candles = _fetch_ohlcv(symbol, 10)
    px = None
    if candles:
        px = candles[-1][4]
        high = max(c[2] for c in candles[-10:])
        pos.last_high = max(pos.last_high, high)
    else:
        try:
            t = CLIENT.fetch_ticker(symbol)
            px = t.get('last') or t.get('close')
        except Exception:
            pass
    if px is None:
        return None
    gain_bps = (px - pos.entry_price)/pos.entry_price*10000.0
    if gain_bps >= CFG['MIN_PROFIT_EXIT_BPS']:
        # trailing stop logic
        trail_trigger = pos.last_high * (1 - CFG['TRAILING_STOP_BPS']/10000.0)
        if px <= trail_trigger:
            return {'price': px, 'reason':'trailing_stop', 'gain_bps':gain_bps}
    return None

# ---- Main trading operations ----
REJECT_COUNTS: Dict[str,int] = {}

def _reject(reason: str, detail: Dict[str,Any]):
    REJECT_COUNTS[reason] = REJECT_COUNTS.get(reason,0)+1
    METRIC_REJECTS.labels(BOT_ID, reason).inc()
    _write_ledger('ORDER_SKIPPED', {'reason':reason, **detail})
    audit('ORDER_SKIPPED', {'reason':reason, **detail})


def place_order(symbol: str, side: str, qty: float, intended_price: float, order_type: str='market') -> Optional[Dict[str,Any]]:
    price_for_create = None if order_type=='market' else intended_price
    price_for_create, qty = _snap(symbol, price_for_create, qty)
    _write_ledger('PRE_ORDER', {'symbol':symbol,'side':side,'qty':qty,'price':price_for_create,'type':order_type})
    audit('PRE_ORDER', {'symbol':symbol,'side':side,'qty':qty,'price':price_for_create,'type':order_type})
    try:
        resp = guarded_create_order(CLIENT, symbol, order_type, side, qty, price_for_create, params=None)
        _write_ledger('ORDER_OK', {'symbol':symbol,'side':side,'qty':qty,'price':price_for_create,'resp_id':resp.get('id')})
        audit('ORDER_OK', {'symbol':symbol,'side':side,'qty':qty,'price':price_for_create})
        exec_price = intended_price if order_type=='market' else price_for_create or intended_price
        sl_bps = _estimate_slippage_bps(intended_price, exec_price)
        METRIC_SLIPPAGE.observe(sl_bps)
        is_close = (side.upper()=='SELL')
        _record_fill(symbol, side, qty, exec_price, is_close=is_close)
        return resp
    except Exception as e:
        _reject('create_error', {'symbol':symbol,'err':str(e)})
        return None


# Basic sizing: fixed notional divided by last price.

def _compute_qty(symbol: str, price: float) -> float:
    notional = min(CFG['MAX_NOTIONAL_PER_ORDER'],  CFG['MAX_NOTIONAL_PER_ORDER'])
    qty = notional / max(price, 1e-12)
    return qty


# ---- Main loop ----
STOP_REQUESTED = False

def _signal_handler(sig, frame):
    global STOP_REQUESTED
    STOP_REQUESTED = True
signal.signal(signal.SIGINT, _signal_handler)
signal.signal(signal.SIGTERM, _signal_handler)


def run_once():
    _risk_update_metrics()
    if STOP_REQUESTED: return False
    if not CFG['SYMBOLS']:
        time.sleep(1); return True
    for symbol in CFG['SYMBOLS']:
        if STOP_REQUESTED: break
        # Existing position? consider exit
        pos = POSITIONS.get(symbol)
        if pos:
            decision = _should_close_long(symbol, pos)
            if decision:
                place_order(symbol, 'SELL', pos.qty, decision['price'])
                with STATE_LOCK:
                    POSITIONS.pop(symbol, None)
                # ledger close marked via FILL realized
                continue
        # Entry logic
        if pos:  # already have position
            continue
        if not _risk_gate_new_entry():
            _reject('risk_limit', {'symbol':symbol,'active_reason':RISK.risk_block_reason})
            continue
        if os.path.exists(PAUSE_FILE):
            _reject('panic_file', {'symbol':symbol})
            continue
        sig = _should_open_long(symbol)
        if not sig:
            continue
        qty = _compute_qty(symbol, sig['price'])
        if qty <= 0:
            _reject('zero_qty', {'symbol':symbol})
            continue
        resp = place_order(symbol, 'BUY', qty, sig['price'])
        if resp:
            with STATE_LOCK:
                POSITIONS[symbol] = Position(symbol=symbol, qty=qty, entry_price=sig['price'], last_high=sig['price'])
    return True


def persist_state():
    try:
        with open(STATE_PATH,'w') as f:
            json.dump({'positions': {s: vars(p) for s,p in POSITIONS.items()}}, f)
    except Exception:
        pass


def main():
    import time, logging, os
    tick = float(os.getenv('TICK_SECONDS','15'))
    logging.info("Main loop starting (tick=%ss)", tick)
    _t0 = time.time()
    try:
        while True:
            try:
                run_once(cfg, state, client, sentinel)
            except Exception as e:
                logging.exception("run_once error: %s", e)
            time.sleep(tick)
    except KeyboardInterrupt:
        logging.info("Bot exit uptime=%.1fs", time.time() - _t0)
        return

    logging.basicConfig(level=logging.INFO, format='%(asctime)s %(levelname)s %(message)s')
    hb_thr.start()
    logging.info('Bot start model_version=%s bot_id=%s dry_run=%s symbols=%s', MODEL_VERSION, BOT_ID, CFG['DRY_RUN'], CFG['SYMBOLS'])
    start_ts = time.time()
    while not STOP_REQUESTED:
        try:
            alive = run_once()
            persist_state()
            if not alive:
                break
        except Exception as e:
            logging.exception('loop_error: %s', e)
        time.sleep(CFG['SLEEP_LOOP_SEC'])
    _shutdown.set()
    logging.info('Bot exit uptime=%.1fs', time.time()-start_ts)

if __name__ == '__main__':
    main()
