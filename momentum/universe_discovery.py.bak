#!/usr/bin/env python3
import os
import ccxt

def discover_universe():
    quotes = [q.strip().upper() for q in os.getenv("UNIVERSE_QUOTES","USDT,USD").split(",") if q.strip()]
    min_usd = float(os.getenv("UNIVERSE_MIN_24H_USD","2000000"))
    max_pairs = int(os.getenv("UNIVERSE_MAX_PAIRS","25"))
    exclude = set(s.strip().upper() for s in os.getenv("UNIVERSE_EXCLUDE","" ).split(",") if s.strip())

    ex = ccxt.binanceus({'enableRateLimit': True, 'options': {'defaultType':'spot'}})
    mkts = ex.load_markets()

    cands = []
    for s, m in mkts.items():
        if not m.get("active"): 
            continue
        if m.get("spot") is not True:
            continue
        if m.get("quote"," ").upper() not in quotes:
            continue
        if s.upper() in exclude:
            continue
        vol = 0.0
        info = m.get("info",{}) or {}
        vol = info.get("quoteVolume") or info.get("volumeUsd") or 0
        try:
            vol = float(vol)
        except Exception:
            vol = 0.0
        if vol >= min_usd:
            cands.append((vol, s))
    cands.sort(reverse=True)
    return [s for _, s in cands[:max_pairs]]
