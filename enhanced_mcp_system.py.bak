class AIModelType(Enum):
    """Enhanced AI model types"""
    TRANSFORMER_SENTIMENT = "transformer_sentiment"
    LSTM_PRICE_PREDICTION = "lstm_price_prediction"
    CNN_PATTERN_RECOGNITION = "cnn_pattern_recognition"
    REINFORCEMENT_LEARNING = "reinforcement_learning"
    ENSEMBLE_FUSION = "ensemble_fusion"
    QUANTUM_INSPIRED = "quantum_inspired"

class MCPEnhancementLevel(Enum):
    """MCP enhancement sophistication levels"""
    BASIC = "basic"
    ADVANCED = "advanced"
    EXPERT = "expert"
    QUANTUM = "quantum"
    SINGULARITY = "singularity"

@dataclass
class EnhancedMCPSignal:
    """Next-generation MCP signal with multi-dimensional analysis"""
    symbol: str
    primary_signal: str  # BUY, SELL, HOLD
    confidence_score: float  # 0-1
    risk_assessment: Dict[str, float]
    sentiment_analysis: Dict[str, Any]
    technical_confluence: Dict[str, float]
    fundamental_strength: float
    market_microstructure: Dict[str, Any]
    cross_asset_correlation: Dict[str, float]
    volatility_regime: str
    liquidity_analysis: Dict[str, float]
    execution_guidance: Dict[str, Any]
    timestamp: datetime
    model_attribution: Dict[str, float]  # Which models contributed
    uncertainty_quantification: Dict[str, float]

@dataclass
class MCPEnhancementConfig:
    """Configuration for enhanced MCP system"""
    enhancement_level: MCPEnhancementLevel = MCPEnhancementLevel.ADVANCED
    enable_transformer_models: bool = True
    enable_sentiment_analysis: bool = True
    enable_cross_chain_analysis: bool = True
    enable_quantum_optimization: bool = False
    
    # Model ensemble weights
    model_weights: Dict[str, float] = field(default_factory=lambda: {
        'technical_analysis': 0.25,
        'sentiment_analysis': 0.20,
        'risk_assessment': 0.20,
        'market_microstructure': 0.15,
        'fundamental_analysis': 0.10,
        'cross_asset_signals': 0.10
    })
    
    # Real-time thresholds
    min_confidence_threshold: float = 0.65
    max_risk_tolerance: float = 7.5
    sentiment_influence_factor: float = 0.3

class SentimentAnalysisEngine:
    """Advanced sentiment analysis for crypto/trading"""
    
    def __init__(self):
        self.sentiment_pipeline = None
        self.crypto_keywords = {
            'bullish': ['moon', 'bull', 'pump', 'rocket', 'diamond hands', 'hodl', 'breakout'],
            'bearish': ['dump', 'bear', 'crash', 'panic', 'sell', 'rug', 'dead cat'],
            'neutral': ['sideways', 'crab', 'consolidation', 'range', 'stable']
        }
        
        if HF_AVAILABLE:
            try:
                self.sentiment_pipeline = pipeline(
                    "sentiment-analysis",
                    model="cardiffnlp/twitter-roberta-base-sentiment-latest"
                )
                print("✅ Transformer sentiment model loaded")
            except Exception as e:
                print(f"⚠️ Transformer model loading failed: {e}")
    
    def analyze_market_sentiment(self, text_data: List[str]) -> Dict[str, Any]:
        """Analyze sentiment from market commentary, news, social media"""
        if not text_data:
            return {'sentiment': 'neutral', 'confidence': 0.5, 'signals': []}
        
        sentiments = []
        
        if self.sentiment_pipeline:
            try:
                # Use transformer model
                results = self.sentiment_pipeline(text_data[:50])  # Limit for performance
                
                sentiment_scores = {
                    'positive': 0,
                    'negative': 0,
                    'neutral': 0
                }
                
                for result in results:
                    label = result['label'].lower()
                    score = result['score']
                    
                    if 'positive' in label:
                        sentiment_scores['positive'] += score
                    elif 'negative' in label:
                        sentiment_scores['negative'] += score
                    else:
                        sentiment_scores['neutral'] += score
                
                # Normalize scores
                total_score = sum(sentiment_scores.values())
                if total_score > 0:
                    sentiment_scores = {k: v/total_score for k, v in sentiment_scores.items()}
                
                # Determine overall sentiment
                if sentiment_scores['positive'] > 0.6:
                    overall_sentiment = 'bullish'
                    confidence = sentiment_scores['positive']
                elif sentiment_scores['negative'] > 0.6:
                    overall_sentiment = 'bearish'
                    confidence = sentiment_scores['negative']
                else:
                    overall_sentiment = 'neutral'
                    confidence = sentiment_scores['neutral']
                
                return {
                    'sentiment': overall_sentiment,
                    'confidence': confidence,
                    'detailed_scores': sentiment_scores,
                    'model_used': 'transformer'
                }
                
            except Exception as e:
                print(f"⚠️ Transformer sentiment analysis failed: {e}")
        
        # Fallback to keyword-based analysis
        return self._keyword_sentiment_analysis(text_data)
    
    def _keyword_sentiment_analysis(self, text_data: List[str]) -> Dict[str, Any]:
        """Fallback keyword-based sentiment analysis"""
        bullish_count = 0
        bearish_count = 0
        total_words = 0
        
        for text in text_data:
            words = text.lower().split()
            total_words += len(words)
            
            for word in words:
                for keyword in self.crypto_keywords['bullish']:
                    if keyword in word:
                        bullish_count += 1
                
                for keyword in self.crypto_keywords['bearish']:
                    if keyword in word:
                        bearish_count += 1
        
        if total_words == 0:
            return {'sentiment': 'neutral', 'confidence': 0.5, 'model_used': 'keyword'}
        
        bullish_ratio = bullish_count / total_words
        bearish_ratio = bearish_count / total_words
        
        if bullish_ratio > bearish_ratio * 1.5:
            sentiment = 'bullish'
            confidence = min(0.8, bullish_ratio * 10)
        elif bearish_ratio > bullish_ratio * 1.5:
            sentiment = 'bearish'
            confidence = min(0.8, bearish_ratio * 10)
        else:
            sentiment = 'neutral'
            confidence = 0.5
        
        return {
            'sentiment': sentiment,
            'confidence': confidence,
            'bullish_signals': bullish_count,
            'bearish_signals': bearish_count,
            'model_used': 'keyword'
        }

class QuantumInspiredOptimizer:
    """Quantum-inspired optimization for trading decisions"""
    
    def __init__(self):
        self.quantum_states = []
        self.entanglement_matrix = None
    
    def quantum_decision_superposition(self, signals: List[Dict]) -> Dict[str, Any]:
        """Create quantum superposition of trading decisions"""
        if not signals:
            return {'decision': 'HOLD', 'confidence': 0.5, 'quantum_coherence': 0}
        
        # Create superposition state
        n_signals = len(signals)
        amplitudes = np.random.random(n_signals)
        amplitudes = amplitudes / np.linalg.norm(amplitudes)  # Normalize
        
        # Calculate quantum interference
        interference_pattern = np.zeros(3)  # BUY, HOLD, SELL
        
        for i, signal in enumerate(signals):
            weight = amplitudes[i] ** 2  # Probability from amplitude squared
            
            if signal.get('action', 'HOLD') == 'BUY':
                interference_pattern[0] += weight
            elif signal.get('action', 'HOLD') == 'SELL':
                interference_pattern[2] += weight
            else:
                interference_pattern[1] += weight
        
        # Quantum collapse to classical decision
        max_prob = np.max(interference_pattern)
        decision_index = np.argmax(interference_pattern)
        
        decisions = ['BUY', 'HOLD', 'SELL']
        final_decision = decisions[decision_index]
        
        # Calculate quantum coherence (measure of superposition quality)
        coherence = 1 - np.sum(interference_pattern ** 2)  # Higher = more uncertain
        
        return {
            'decision': final_decision,
            'confidence': max_prob,
            'quantum_coherence': coherence,
            'interference_pattern': interference_pattern.tolist(),
            'superposition_amplitudes': amplitudes.tolist()
        }
    
    def entanglement_correlation_analysis(self, asset_signals: Dict[str, Dict]) -> Dict[str, float]:
        """Analyze quantum entanglement between asset signals"""
        if len(asset_signals) < 2:
            return {}
        
        assets = list(asset_signals.keys())
        correlations = {}
        
        for i, asset1 in enumerate(assets):
            for asset2 in assets[i+1:]:
                signal1 = asset_signals[asset1]
                signal2 = asset_signals[asset2]
                
                # Calculate entanglement strength
                conf1 = signal1.get('confidence', 0.5)
                conf2 = signal2.get('confidence', 0.5)
                
                action1 = signal1.get('action', 'HOLD')
                action2 = signal2.get('action', 'HOLD')
                
                # Entanglement based on signal agreement and confidence
                if action1 == action2:
                    entanglement = (conf1 + conf2) / 2
                else:
                    entanglement = abs(conf1 - conf2) / 2
                
                correlations[f"{asset1}_{asset2}"] = entanglement
        
        return correlations

class CrossChainIntelligence:
    """Cross-chain analysis and intelligence gathering"""
    
    def __init__(self):
        self.chain_metrics = {}
        self.bridge_flows = {}
    
    def analyze_cross_chain_flows(self, symbol: str) -> Dict[str, Any]:
        """Analyze cross-chain capital flows for a token"""
        # Simulated cross-chain analysis
        chains = ['ethereum', 'bsc', 'polygon', 'avalanche', 'arbitrum']
        
        flows = {}
        total_volume = 0
        
        for chain in chains:
            # Simulate volume distribution across chains
            volume = np.random.lognormal(15, 2)  # Realistic volume distribution
            flows[chain] = {
                'volume_24h': volume,
                'unique_addresses': int(volume / 1000),
                'avg_transaction_size': volume / max(1, volume / 1000),
                'bridge_inflow': np.random.normal(0, volume * 0.1),
                'bridge_outflow': np.random.normal(0, volume * 0.1)
            }
            total_volume += volume
        
        # Calculate chain dominance
        chain_dominance = {chain: flows[chain]['volume_24h'] / total_volume 
                          for chain in chains}
        
        # Detect unusual flows
        unusual_flows = []
        for chain in chains:
            net_bridge_flow = flows[chain]['bridge_inflow'] - flows[chain]['bridge_outflow']
            if abs(net_bridge_flow) > flows[chain]['volume_24h'] * 0.2:
                unusual_flows.append({
                    'chain': chain,
                    'net_flow': net_bridge_flow,
                    'flow_ratio': net_bridge_flow / flows[chain]['volume_24h']
                })
        
        return {
            'total_cross_chain_volume': total_volume,
            'chain_flows': flows,
            'chain_dominance': chain_dominance,
            'unusual_flows': unusual_flows,
            'decentralization_score': 1 - max(chain_dominance.values())  # Higher = more decentralized
        }

class EnhancedMCPSystem:
    """
    🌟 Next-Generation MCP Enhancement System
    
    Revolutionary improvements:
    - Multi-AI model orchestration
    - Quantum-inspired decision making
    - Real-time sentiment analysis
    - Cross-chain intelligence
    - Advanced risk prediction
    """
    
    def __init__(self, config: MCPEnhancementConfig = None):
        self.config = config or MCPEnhancementConfig()
        self.sentiment_engine = SentimentAnalysisEngine()
        self.quantum_optimizer = QuantumInspiredOptimizer()
        self.cross_chain_intel = CrossChainIntelligence()
        
        # Model ensemble
        self.ai_models = {}
        self.performance_metrics = {}
        
        print("🚀 Enhanced MCP System initialized")
        print(f"   Enhancement level: {self.config.enhancement_level.value}")
        print(f"   Transformer models: {'✅' if HF_AVAILABLE else '❌'}")
        print(f"   PyTorch available: {'✅' if TORCH_AVAILABLE else '❌'}")
    
    async def enhanced_signal_generation(self, symbol: str, market_data: Dict[str, Any], 
                                       context: Dict[str, Any] = None) -> EnhancedMCPSignal:
        """Generate enhanced MCP signal with multi-dimensional analysis"""
        start_time = time.time()
        
        # Parallel analysis tasks
        tasks = [
            self._technical_analysis(symbol, market_data),
            self._sentiment_analysis(symbol, context or {}),
            self._risk_assessment(symbol, market_data),
            self._market_microstructure_analysis(symbol, market_data),
            self._cross_chain_analysis(symbol),
            self._fundamental_analysis(symbol, market_data)
        ]
        
        # Execute all analyses in parallel
        results = await asyncio.gather(*tasks, return_exceptions=True)
        
        # Extract results
        technical_result = results[0] if not isinstance(results[0], Exception) else {}
        sentiment_result = results[1] if not isinstance(results[1], Exception) else {}
        risk_result = results[2] if not isinstance(results[2], Exception) else {}
        microstructure_result = results[3] if not isinstance(results[3], Exception) else {}
        cross_chain_result = results[4] if not isinstance(results[4], Exception) else {}
        fundamental_result = results[5] if not isinstance(results[5], Exception) else {}
        
        # Quantum-inspired decision fusion
        individual_signals = [
            {'action': technical_result.get('signal', 'HOLD'), 'confidence': technical_result.get('confidence', 0.5)},
            {'action': sentiment_result.get('signal', 'HOLD'), 'confidence': sentiment_result.get('confidence', 0.5)},
            {'action': risk_result.get('signal', 'HOLD'), 'confidence': risk_result.get('confidence', 0.5)}
        ]
        
        quantum_decision = self.quantum_optimizer.quantum_decision_superposition(individual_signals)
        
        # Calculate overall confidence using ensemble weighting
        weighted_confidence = 0
        for analysis_type, weight in self.config.model_weights.items():
            if 'technical' in analysis_type:
                weighted_confidence += technical_result.get('confidence', 0.5) * weight
            elif 'sentiment' in analysis_type:
                weighted_confidence += sentiment_result.get('confidence', 0.5) * weight
            elif 'risk' in analysis_type:
                weighted_confidence += risk_result.get('confidence', 0.5) * weight
        
        # Combine quantum decision with ensemble confidence
        final_confidence = (quantum_decision['confidence'] + weighted_confidence) / 2
        
        # Generate enhanced signal
        enhanced_signal = EnhancedMCPSignal(
            symbol=symbol,
            primary_signal=quantum_decision['decision'],
            confidence_score=final_confidence,
            risk_assessment=risk_result,
            sentiment_analysis=sentiment_result,
            technical_confluence=technical_result,
            fundamental_strength=fundamental_result.get('strength', 0.5),
            market_microstructure=microstructure_result,
            cross_asset_correlation=cross_chain_result.get('correlations', {}),
            volatility_regime=self._determine_volatility_regime(market_data),
            liquidity_analysis=microstructure_result.get('liquidity', {}),
            execution_guidance=self._generate_execution_guidance(symbol, market_data, quantum_decision),
            timestamp=datetime.now(),
            model_attribution=self.config.model_weights,
            uncertainty_quantification=quantum_decision
        )
        
        processing_time = time.time() - start_time
        print(f"🔮 Enhanced MCP signal generated for {symbol} in {processing_time:.2f}s")
        print(f"   Signal: {enhanced_signal.primary_signal}")
        print(f"   Confidence: {enhanced_signal.confidence_score:.2%}")
        print(f"   Quantum coherence: {quantum_decision.get('quantum_coherence', 0):.3f}")
        
        return enhanced_signal
    
    async def _technical_analysis(self, symbol: str, market_data: Dict) -> Dict[str, Any]:
        """Enhanced technical analysis with multiple timeframes"""
        await asyncio.sleep(0.1)  # Simulate processing
        
        price = market_data.get('price', 100)
        volume = market_data.get('volume_24h', 1000000)
        
        # Simulate advanced technical indicators
        rsi = np.random.uniform(20, 80)
        macd = np.random.uniform(-1, 1)
        bb_position = np.random.uniform(0, 1)
        
        # Multi-timeframe analysis
        timeframes = ['1h', '4h', '1d', '1w']
        timeframe_signals = {}
        
        for tf in timeframes:
            tf_signal = 'BUY' if np.random.random() > 0.5 else 'SELL'
            tf_confidence = np.random.uniform(0.3, 0.9)
            timeframe_signals[tf] = {'signal': tf_signal, 'confidence': tf_confidence}
        
        # Confluence analysis
        buy_count = sum(1 for tf in timeframe_signals.values() if tf['signal'] == 'BUY')
        confluence_strength = buy_count / len(timeframes)
        
        overall_signal = 'BUY' if confluence_strength > 0.6 else 'SELL' if confluence_strength < 0.4 else 'HOLD'
        
        return {
            'signal': overall_signal,
            'confidence': confluence_strength if overall_signal != 'HOLD' else 0.5,
            'rsi': rsi,
            'macd': macd,
            'bollinger_position': bb_position,
            'timeframe_analysis': timeframe_signals,
            'confluence_strength': confluence_strength
        }
    
    async def _sentiment_analysis(self, symbol: str, context: Dict) -> Dict[str, Any]:
        """Enhanced sentiment analysis"""
        await asyncio.sleep(0.1)  # Simulate processing
        
        # Simulate social media and news data
        social_texts = [
            f"{symbol} is looking bullish with strong momentum",
            f"Technical breakout pattern forming on {symbol}",
            f"Market sentiment turning positive for {symbol}",
            f"Some concerns about {symbol} fundamentals",
            f"Strong community support for {symbol}"
        ]
        
        sentiment_result = self.sentiment_engine.analyze_market_sentiment(social_texts)
        
        # Convert sentiment to trading signal
        if sentiment_result['sentiment'] == 'bullish' and sentiment_result['confidence'] > 0.6:
            signal = 'BUY'
        elif sentiment_result['sentiment'] == 'bearish' and sentiment_result['confidence'] > 0.6:
            signal = 'SELL'
        else:
            signal = 'HOLD'
        
        return {
            'signal': signal,
            'confidence': sentiment_result['confidence'],
            'sentiment_breakdown': sentiment_result,
            'social_volume': len(social_texts),
            'news_sentiment': 'positive'  # Simulated
        }
    
    async def _risk_assessment(self, symbol: str, market_data: Dict) -> Dict[str, Any]:
        """Advanced risk assessment"""
        await asyncio.sleep(0.1)  # Simulate processing
        
        price = market_data.get('price', 100)
        volume = market_data.get('volume_24h', 1000000)
        
        # Risk metrics
        volatility_risk = np.random.uniform(0.1, 0.9)
        liquidity_risk = max(0, 1 - (volume / 10000000))  # Higher volume = lower risk
        market_cap_risk = np.random.uniform(0.2, 0.8)
        
        overall_risk = (volatility_risk + liquidity_risk + market_cap_risk) / 3
        
        # Risk-adjusted signal
        if overall_risk < 0.3:
            signal = 'BUY'  # Low risk = favorable
            confidence = 1 - overall_risk
        elif overall_risk > 0.7:
            signal = 'SELL'  # High risk = unfavorable
            confidence = overall_risk
        else:
            signal = 'HOLD'
            confidence = 0.5
        
        return {
            'signal': signal,
            'confidence': confidence,
            'overall_risk_score': overall_risk,
            'volatility_risk': volatility_risk,
            'liquidity_risk': liquidity_risk,
            'market_cap_risk': market_cap_risk,
            'risk_level': 'LOW' if overall_risk < 0.4 else 'MEDIUM' if overall_risk < 0.7 else 'HIGH'
        }
    
    async def _market_microstructure_analysis(self, symbol: str, market_data: Dict) -> Dict[str, Any]:
        """Market microstructure and order flow analysis"""
        await asyncio.sleep(0.1)  # Simulate processing
        
        # Simulate order book analysis
        bid_ask_spread = np.random.uniform(0.001, 0.01)
        order_book_depth = np.random.uniform(0.5, 2.0)
        price_impact = np.random.uniform(0.001, 0.005)
        
        return {
            'bid_ask_spread': bid_ask_spread,
            'order_book_depth': order_book_depth,
            'price_impact': price_impact,
            'liquidity': {
                'tight_spread': bid_ask_spread < 0.005,
                'deep_book': order_book_depth > 1.0,
                'low_impact': price_impact < 0.003
            }
        }
    
    async def _cross_chain_analysis(self, symbol: str) -> Dict[str, Any]:
        """Cross-chain intelligence analysis"""
        await asyncio.sleep(0.1)  # Simulate processing
        
        cross_chain_data = self.cross_chain_intel.analyze_cross_chain_flows(symbol)
        
        # Extract correlations
        correlations = {}
        for i, chain in enumerate(['ethereum', 'bsc', 'polygon']):
            correlation = np.random.uniform(-0.5, 0.8)
            correlations[f"{symbol}_{chain}"] = correlation
        
        return {
            'cross_chain_flows': cross_chain_data,
            'correlations': correlations
        }
    
    async def _fundamental_analysis(self, symbol: str, market_data: Dict) -> Dict[str, Any]:
        """Fundamental analysis"""
        await asyncio.sleep(0.1)  # Simulate processing
        
        # Simulate fundamental metrics
        metrics = {
            'technology_score': np.random.uniform(0.3, 0.9),
            'team_score': np.random.uniform(0.4, 0.9),
            'adoption_score': np.random.uniform(0.2, 0.8),
            'tokenomics_score': np.random.uniform(0.3, 0.9)
        }
        
        overall_strength = np.mean(list(metrics.values()))
        
        return {
            'strength': overall_strength,
            'metrics': metrics,
            'grade': 'A' if overall_strength > 0.8 else 'B' if overall_strength > 0.6 else 'C'
        }
    
    def _determine_volatility_regime(self, market_data: Dict) -> str:
        """Determine current volatility regime"""
        # Simulate volatility analysis
        vol = np.random.uniform(0.1, 0.8)
        
        if vol < 0.2:
            return 'LOW_VOLATILITY'
        elif vol < 0.5:
            return 'MEDIUM_VOLATILITY'
        else:
            return 'HIGH_VOLATILITY'
    
    def _generate_execution_guidance(self, symbol: str, market_data: Dict, 
                                   quantum_decision: Dict) -> Dict[str, Any]:
        """Generate execution guidance based on analysis"""
        return {
            'recommended_order_type': 'limit' if quantum_decision['confidence'] > 0.7 else 'market',
            'position_sizing': min(0.05, quantum_decision['confidence'] * 0.1),  # Max 5% position
            'time_horizon': 'short' if quantum_decision['quantum_coherence'] > 0.5 else 'medium',
            'stop_loss_suggestion': 0.05,  # 5% stop loss
            'take_profit_levels': [0.10, 0.20, 0.35]  # Multiple take profit levels
        }
    
    async def multi_asset_analysis(self, symbols: List[str], market_data: Dict[str, Dict]) -> Dict[str, Any]:
        """Analyze multiple assets with cross-correlations"""
        print(f"🔍 Multi-asset analysis for {len(symbols)} tokens...")
        
        # Generate signals for all assets
        signals = {}
        for symbol in symbols:
            if symbol in market_data:
                signal = await self.enhanced_signal_generation(symbol, market_data[symbol])
                signals[symbol] = {
                    'action': signal.primary_signal,
                    'confidence': signal.confidence_score
                }
        
        # Quantum entanglement analysis
        entanglements = self.quantum_optimizer.entanglement_correlation_analysis(signals)
        
        # Portfolio-level recommendations
        buy_signals = [s for s in signals.values() if s['action'] == 'BUY']
        portfolio_confidence = np.mean([s['confidence'] for s in signals.values()]) if signals else 0
        
        return {
            'individual_signals': signals,
            'quantum_entanglements': entanglements,
            'portfolio_metrics': {
                'total_assets': len(symbols),
                'buy_recommendations': len(buy_signals),
                'overall_confidence': portfolio_confidence,
                'diversification_score': len(set(s['action'] for s in signals.values())) / 3
            }
        }
    
    def get_system_performance_metrics(self) -> Dict[str, Any]:
        """Get enhanced MCP system performance metrics"""
        return {
            'enhancement_level': self.config.enhancement_level.value,
            'active_models': list(self.config.model_weights.keys()),
            'model_availability': {
                'transformers': HF_AVAILABLE,
                'pytorch': TORCH_AVAILABLE,
                'quantum_optimizer': True,
                'cross_chain_intel': True
            },
            'processing_capabilities': {
                'sentiment_analysis': True,
                'quantum_optimization': True,
                'cross_chain_analysis': True,
                'multi_timeframe_analysis': True
            }
        }

async def demo_enhanced_mcp():
    """Demonstrate enhanced MCP capabilities"""
    print("🎭 DEMO: Enhanced MCP System")
    print("=" * 40)
    
    # Initialize enhanced MCP
    config = MCPEnhancementConfig(
        enhancement_level=MCPEnhancementLevel.EXPERT,
        enable_transformer_models=True,
        enable_sentiment_analysis=True,
        enable_cross_chain_analysis=True
    )
    
    mcp_system = EnhancedMCPSystem(config)
    
    # Demo single asset analysis
    print("\n🔮 Single Asset Analysis...")
    test_symbol = "ADAUSDT"
    test_market_data = {
        'price': 0.72,
        'volume_24h': 255467019,
        'price_change_24h': -3.3,
        'high_24h': 0.75,
        'low_24h': 0.68
    }
    
    enhanced_signal = await mcp_system.enhanced_signal_generation(test_symbol, test_market_data)
    
    print(f"\n📊 Enhanced Signal for {test_symbol}:")
    print(f"   Primary Signal: {enhanced_signal.primary_signal}")
    print(f"   Confidence: {enhanced_signal.confidence_score:.2%}")
    print(f"   Risk Level: {enhanced_signal.risk_assessment.get('risk_level', 'UNKNOWN')}")
    print(f"   Sentiment: {enhanced_signal.sentiment_analysis.get('sentiment_breakdown', {}).get('sentiment', 'neutral')}")
    
    # Demo multi-asset analysis
    print("\n🌐 Multi-Asset Analysis...")
    test_symbols = ["ADAUSDT", "SOLUSDT", "DOGEUSDT", "SHIBUSDT"]
    test_market_data_multi = {
        symbol: {
            'price': np.random.uniform(0.1, 100),
            'volume_24h': np.random.uniform(100000, 10000000),
            'price_change_24h': np.random.uniform(-10, 10)
        }
        for symbol in test_symbols
    }
    
    multi_analysis = await mcp_system.multi_asset_analysis(test_symbols, test_market_data_multi)
    
    print(f"📈 Portfolio Analysis:")
    print(f"   Total assets: {multi_analysis['portfolio_metrics']['total_assets']}")
    print(f"   Buy recommendations: {multi_analysis['portfolio_metrics']['buy_recommendations']}")
    print(f"   Overall confidence: {multi_analysis['portfolio_metrics']['overall_confidence']:.2%}")
    
    # Performance metrics
    performance = mcp_system.get_system_performance_metrics()
    print(f"\n⚡ System Performance:")
    print(f"   Enhancement level: {performance['enhancement_level']}")
    print(f"   Active models: {len(performance['active_models'])}")
    print(f"   Model availability: {sum(performance['model_availability'].values())}/{len(performance['model_availability'])}")
    
    # Save results
    demo_results = {
        'timestamp': datetime.now().isoformat(),
        'single_asset_analysis': {
            'symbol': test_symbol,
            'signal': enhanced_signal.primary_signal,
            'confidence': enhanced_signal.confidence_score
        },
        'multi_asset_analysis': multi_analysis,
        'system_performance': performance
    }
    
    with open('enhanced_mcp_demo_results.json', 'w') as f:
        json.dump(demo_results, f, indent=2, default=str)
    
    print(f"\n💾 Demo results saved to enhanced_mcp_demo_results.json")
    print("🏁 Enhanced MCP Demo Complete")

if __name__ == "__main__":
    asyncio.run(demo_enhanced_mcp())
