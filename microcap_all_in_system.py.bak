#!/usr/bin/env python3

"""
💎 MICROCAP ALL-IN ALLOCATION SYSTEM
Advanced system for MAGIC-like gains in microcap tokens
Tight 5% stop loss management with intelligent entry/exit timing
"""

import json
import os
import sys
from datetime import datetime, timedelta
from typing import Dict, List, Tuple, Optional
import statistics
import numpy as np
from dataclasses import dataclass, asdict

# Add project root to path
sys.path.append(os.path.dirname(__file__))

try:
    from binance.client import Client
    from binance.exceptions import BinanceAPIException
    binance_available = True
except ImportError:
    binance_available = False

from dotenv import load_dotenv
load_dotenv(os.path.join(os.path.dirname(__file__), 'config', '.env'))

@dataclass
class MicrocapAllocation:
    """Microcap allocation with MAGIC-like potential"""
    symbol: str
    current_price: float
    magic_similarity_score: float
    gain_potential: float
    allocation_percentage: float
    entry_price: float
    stop_loss_price: float
    take_profit_1: float
    take_profit_2: float
    take_profit_3: float
    risk_score: float
    confidence: float
    momentum_pattern: str
    volume_profile: str
    entry_timing: str
    reasoning: str

class MicrocapAllInSystem:
    """All-in allocation system for microcap tokens with MAGIC patterns"""
    
    def __init__(self):
        # Initialize Binance client
        self.BINANCEUS_KEY = os.getenv('BINANCEUS_KEY')
        self.BINANCEUS_SECRET = os.getenv('BINANCEUS_SECRET')
        self.client = None
        
        if binance_available and self.BINANCEUS_KEY:
            try:
                self.client = Client(self.BINANCEUS_KEY, self.BINANCEUS_SECRET)
                print("✅ Microcap All-In System connected to Binance")
            except Exception as e:
                print(f"⚠️ Binance client error: {e}")
        
        # Load token data
        self.all_tokens = self._load_token_data()
        
        # MAGIC pattern learning from previous analysis
        self.magic_patterns = {
            "double_bottom_recovery": {
                "success_rate": 0.80,
                "avg_gain": 0.157,
                "pattern_signals": ["support_test", "volume_spike", "momentum_reversal"]
            },
            "volume_breakout": {
                "success_rate": 0.75,
                "avg_gain": 0.124,
                "pattern_signals": ["volume_surge", "resistance_break", "momentum_acceleration"]
            },
            "gaming_correlation": {
                "success_rate": 0.70,
                "avg_gain": 0.089,
                "pattern_signals": ["sector_momentum", "ecosystem_growth", "social_sentiment"]
            }
        }
        
        # Microcap criteria
        self.microcap_criteria = {
            "max_price": 0.01,  # Maximum $0.01
            "min_volume": 1000,  # Minimum $1000 daily volume
            "max_market_cap": 50000000,  # Max $50M market cap estimate
            "min_momentum_score": 5.0,  # Minimum momentum score
            "required_volatility": 0.05  # Minimum 5% volatility for gain potential
        }
        
        # Tight risk management
        self.risk_parameters = {
            "stop_loss_percentage": 0.05,  # 5% stop loss
            "position_sizing": {
                "high_confidence": 0.4,   # 40% for high confidence
                "medium_confidence": 0.3, # 30% for medium confidence
                "low_confidence": 0.2     # 20% for low confidence
            },
            "profit_taking": {
                "target_1": 0.25,  # 25% gain
                "target_2": 0.50,  # 50% gain
                "target_3": 1.00   # 100% gain (MAGIC-like)
            }
        }
    
    def _load_token_data(self) -> List[Dict]:
        """Load comprehensive token data"""
        try:
            with open('comprehensive_token_analysis_20250805_155947.json', 'r') as f:
                return json.load(f)
        except FileNotFoundError:
            print("⚠️ Token analysis file not found")
            return []
    
    def filter_microcap_tokens(self) -> List[Dict]:
        """Filter tokens that meet microcap criteria"""
        microcaps = []
        
        for token in self.all_tokens:
            price = token.get('price', 0)
            volume = token.get('volume_24h_usdt', 0)
            momentum_score = token.get('momentum_score', 0)
            volatility = token.get('volatility', 0)
            
            # Apply microcap filters
            if (price <= self.microcap_criteria["max_price"] and
                volume >= self.microcap_criteria["min_volume"] and
                momentum_score >= self.microcap_criteria["min_momentum_score"] and
                volatility >= self.microcap_criteria["required_volatility"]):
                
                microcaps.append(token)
        
        print(f"📊 Found {len(microcaps)} tokens meeting microcap criteria")
        return microcaps
    
    def calculate_magic_similarity(self, token: Dict) -> float:
        """Calculate similarity to MAGIC token patterns"""
        
        price = token.get('price', 0)
        volume = token.get('volume_24h_usdt', 0)
        change_24h = token.get('price_change_24h', 0)
        momentum_score = token.get('momentum_score', 0)
        volatility = token.get('volatility', 0)
        sector = token.get('sector', 'general')
        
        similarity_score = 0
        
        # Pattern 1: Double bottom recovery potential
        if change_24h < -5 and volume > 5000:  # Dip with volume
            similarity_score += 30
        elif change_24h < -2:
            similarity_score += 15
        
        # Pattern 2: Volume breakout setup
        if volume > 20000 and momentum_score > 5.5:
            similarity_score += 25
        elif volume > 10000:
            similarity_score += 15
        
        # Pattern 3: Gaming/sector correlation
        if sector in ['gaming', 'nft', 'metaverse']:
            similarity_score += 20
        elif sector in ['defi', 'layer1']:
            similarity_score += 10
        
        # Pattern 4: Technical setup
        if 0.05 <= volatility <= 0.15:  # Optimal volatility
            similarity_score += 15
        
        # Pattern 5: Momentum building
        if momentum_score > 6:
            similarity_score += 10
        elif momentum_score > 5:
            similarity_score += 5
        
        return min(similarity_score, 100)
    
    def calculate_gain_potential(self, token: Dict, magic_similarity: float) -> float:
        """Calculate potential gains based on MAGIC patterns"""
        
        # Base gain from MAGIC patterns
        base_gain = 0.5  # 50% base expectation
        
        # Adjust based on similarity score
        similarity_multiplier = magic_similarity / 100
        
        # Volatility boost
        volatility = token.get('volatility', 0.05)
        volatility_boost = min(volatility * 5, 2.0)  # Up to 2x boost
        
        # Volume confidence
        volume = token.get('volume_24h_usdt', 0)
        volume_multiplier = 1.0 + min(volume / 50000, 1.0)
        
        # Sector boost
        sector = token.get('sector', 'general')
        sector_multipliers = {
            'gaming': 1.3, 'nft': 1.2, 'metaverse': 1.25, 
            'defi': 1.15, 'meme': 1.4, 'general': 1.0
        }
        sector_boost = sector_multipliers.get(sector, 1.0)
        
        # Calculate total potential
        total_potential = base_gain * similarity_multiplier * volatility_boost * volume_multiplier * sector_boost
        
        # Cap at realistic maximum (500% for microcaps)
        return min(total_potential, 5.0)
    
    def assess_risk_score(self, token: Dict) -> float:
        """Assess risk score for tight stop loss management"""
        
        volume = token.get('volume_24h_usdt', 0)
        volatility = token.get('volatility', 0)
        momentum_score = token.get('momentum_score', 0)
        change_24h = token.get('price_change_24h', 0)
        
        risk_score = 0
        
        # Volume risk (lower volume = higher risk)
        if volume < 5000:
            risk_score += 40
        elif volume < 20000:
            risk_score += 25
        elif volume < 50000:
            risk_score += 15
        else:
            risk_score += 5
        
        # Volatility risk
        if volatility > 0.2:  # >20% volatility
            risk_score += 30
        elif volatility > 0.15:
            risk_score += 20
        elif volatility > 0.1:
            risk_score += 10
        else:
            risk_score += 5
        
        # Momentum risk
        if momentum_score < 4:
            risk_score += 20
        elif momentum_score < 5:
            risk_score += 10
        else:
            risk_score += 0
        
        # Price action risk
        if abs(change_24h) > 15:  # Extreme moves
            risk_score += 10
        elif abs(change_24h) > 10:
            risk_score += 5
        
        return min(risk_score, 100)
    
    def determine_entry_timing(self, token: Dict, magic_similarity: float) -> Tuple[str, str]:
        """Determine optimal entry timing"""
        
        change_24h = token.get('price_change_24h', 0)
        volume = token.get('volume_24h_usdt', 0)
        momentum_score = token.get('momentum_score', 0)
        
        # Entry timing logic
        if change_24h < -8 and magic_similarity > 70:
            timing = "BUY_THE_DIP_AGGRESSIVE"
            reasoning = "Strong dip with high MAGIC similarity - aggressive entry"
        elif change_24h < -5 and volume > 10000:
            timing = "BUY_THE_DIP"
            reasoning = "Dip with volume support - good entry opportunity"
        elif change_24h > 5 and momentum_score > 6:
            timing = "MOMENTUM_BREAKOUT"
            reasoning = "Strong momentum breakout - chase with tight stops"
        elif change_24h > 0 and volume > 20000:
            timing = "MOMENTUM_ENTRY"
            reasoning = "Positive momentum with volume - safe entry"
        elif abs(change_24h) < 3:
            timing = "ACCUMULATION_ZONE"
            reasoning = "Consolidation phase - gradual accumulation"
        else:
            timing = "WAIT_AND_WATCH"
            reasoning = "Wait for better entry opportunity"
        
        return timing, reasoning
    
    def calculate_position_levels(self, token: Dict, confidence: float) -> Tuple[float, float, float, float, float]:
        """Calculate entry, stop loss, and take profit levels"""
        
        price = token['price']
        
        # Entry price (slight discount for better execution)
        entry_price = price * 0.998
        
        # Stop loss (tight 5%)
        stop_loss = entry_price * (1 - self.risk_parameters["stop_loss_percentage"])
        
        # Take profit levels
        tp1 = entry_price * (1 + self.risk_parameters["profit_taking"]["target_1"])
        tp2 = entry_price * (1 + self.risk_parameters["profit_taking"]["target_2"])
        tp3 = entry_price * (1 + self.risk_parameters["profit_taking"]["target_3"])
        
        return entry_price, stop_loss, tp1, tp2, tp3
    
    def generate_allocation_plan(self) -> List[MicrocapAllocation]:
        """Generate comprehensive allocation plan for microcaps"""
        
        print("💎 Generating Microcap All-In Allocation Plan...")
        
        # Filter microcap tokens
        microcaps = self.filter_microcap_tokens()
        
        if not microcaps:
            print("❌ No microcap tokens found meeting criteria")
            return []
        
        allocations = []
        
        for token in microcaps:
            try:
                # Calculate MAGIC similarity
                magic_similarity = self.calculate_magic_similarity(token)
                
                # Calculate gain potential
                gain_potential = self.calculate_gain_potential(token, magic_similarity)
                
                # Assess risk
                risk_score = self.assess_risk_score(token)
                
                # Determine confidence
                confidence = (magic_similarity + (100 - risk_score)) / 200
                
                # Skip low confidence tokens
                if confidence < 0.4:
                    continue
                
                # Determine entry timing
                entry_timing, reasoning = self.determine_entry_timing(token, magic_similarity)
                
                # Skip if timing is not favorable
                if entry_timing == "WAIT_AND_WATCH":
                    continue
                
                # Calculate position levels
                entry_price, stop_loss, tp1, tp2, tp3 = self.calculate_position_levels(token, confidence)
                
                # Determine allocation percentage
                if confidence >= 0.8:
                    allocation_pct = self.risk_parameters["position_sizing"]["high_confidence"]
                elif confidence >= 0.6:
                    allocation_pct = self.risk_parameters["position_sizing"]["medium_confidence"]
                else:
                    allocation_pct = self.risk_parameters["position_sizing"]["low_confidence"]
                
                # Create allocation
                allocation = MicrocapAllocation(
                    symbol=token['symbol'],
                    current_price=token['price'],
                    magic_similarity_score=magic_similarity,
                    gain_potential=gain_potential,
                    allocation_percentage=allocation_pct,
                    entry_price=entry_price,
                    stop_loss_price=stop_loss,
                    take_profit_1=tp1,
                    take_profit_2=tp2,
                    take_profit_3=tp3,
                    risk_score=risk_score,
                    confidence=confidence,
                    momentum_pattern=self._identify_momentum_pattern(token),
                    volume_profile=self._assess_volume_profile(token),
                    entry_timing=entry_timing,
                    reasoning=reasoning
                )
                
                allocations.append(allocation)
                
            except Exception as e:
                print(f"⚠️ Error processing {token.get('symbol', 'unknown')}: {e}")
        
        # Sort by confidence and magic similarity
        allocations.sort(key=lambda x: (x.confidence * x.magic_similarity_score), reverse=True)
        
        return allocations
    
    def _identify_momentum_pattern(self, token: Dict) -> str:
        """Identify momentum pattern similar to MAGIC"""
        
        change_24h = token.get('price_change_24h', 0)
        momentum_score = token.get('momentum_score', 0)
        volume = token.get('volume_24h_usdt', 0)
        
        if change_24h < -5 and volume > 10000:
            return "DOUBLE_BOTTOM_SETUP"
        elif momentum_score > 6 and volume > 15000:
            return "VOLUME_BREAKOUT"
        elif change_24h > 3 and momentum_score > 5.5:
            return "MOMENTUM_ACCELERATION"
        else:
            return "ACCUMULATION_PHASE"
    
    def _assess_volume_profile(self, token: Dict) -> str:
        """Assess volume profile"""
        
        volume = token.get('volume_24h_usdt', 0)
        
        if volume > 50000:
            return "HIGH_LIQUIDITY"
        elif volume > 20000:
            return "MODERATE_LIQUIDITY"
        elif volume > 5000:
            return "LOW_LIQUIDITY"
        else:
            return "VERY_LOW_LIQUIDITY"


def main():
    """Main execution function"""
    
    print("💎 MICROCAP ALL-IN ALLOCATION SYSTEM")
    print("=" * 60)
    print("Target: MAGIC-like gains with 5% stop loss protection")
    print()
    
    system = MicrocapAllInSystem()
    
    # Generate allocation plan
    allocations = system.generate_allocation_plan()
    
    if not allocations:
        print("❌ No suitable microcap allocations found")
        return
    
    # Print summary
    total_allocation = sum(a.allocation_percentage for a in allocations)
    avg_gain_potential = statistics.mean([a.gain_potential for a in allocations])
    avg_confidence = statistics.mean([a.confidence for a in allocations])
    
    print(f"📊 ALLOCATION SUMMARY")
    print(f"Microcap Opportunities Found: {len(allocations)}")
    print(f"Total Portfolio Allocation: {total_allocation:.1%}")
    print(f"Average Gain Potential: {avg_gain_potential*100:.1f}%")
    print(f"Average Confidence: {avg_confidence:.1%}")
    
    # Print top allocations
    print(f"\n🎯 TOP MICROCAP ALL-IN ALLOCATIONS")
    print("=" * 80)
    
    for i, allocation in enumerate(allocations[:10], 1):
        print(f"\n{i}. {allocation.symbol} - ${allocation.current_price:.6f}")
        print(f"   🎯 MAGIC Similarity: {allocation.magic_similarity_score:.1f}/100")
        print(f"   📈 Gain Potential: {allocation.gain_potential*100:.1f}%")
        print(f"   💰 Allocation: {allocation.allocation_percentage:.1%} of portfolio")
        print(f"   🔍 Confidence: {allocation.confidence:.1%}")
        print(f"   ⚠️ Risk Score: {allocation.risk_score:.1f}/100")
        
        print(f"\n   📊 Trading Levels:")
        print(f"      Entry: ${allocation.entry_price:.6f}")
        print(f"      Stop Loss: ${allocation.stop_loss_price:.6f} (-5.0%)")
        print(f"      Take Profit 1: ${allocation.take_profit_1:.6f} (+25%)")
        print(f"      Take Profit 2: ${allocation.take_profit_2:.6f} (+50%)")
        print(f"      Take Profit 3: ${allocation.take_profit_3:.6f} (+100%)")
        
        print(f"\n   🎨 Pattern Analysis:")
        print(f"      Momentum Pattern: {allocation.momentum_pattern}")
        print(f"      Volume Profile: {allocation.volume_profile}")
        print(f"      Entry Timing: {allocation.entry_timing}")
        print(f"      Reasoning: {allocation.reasoning}")
    
    # Generate execution plan
    print(f"\n⚡ EXECUTION PLAN")
    print("=" * 60)
    
    immediate_buys = [a for a in allocations if a.entry_timing in ["BUY_THE_DIP_AGGRESSIVE", "BUY_THE_DIP"]]
    momentum_entries = [a for a in allocations if a.entry_timing in ["MOMENTUM_BREAKOUT", "MOMENTUM_ENTRY"]]
    accumulation = [a for a in allocations if a.entry_timing == "ACCUMULATION_ZONE"]
    
    if immediate_buys:
        print(f"🔥 IMMEDIATE OPPORTUNITIES ({len(immediate_buys)}):")
        for allocation in immediate_buys[:3]:
            print(f"   • {allocation.symbol}: {allocation.allocation_percentage:.1%} allocation - {allocation.reasoning}")
    
    if momentum_entries:
        print(f"\n📈 MOMENTUM ENTRIES ({len(momentum_entries)}):")
        for allocation in momentum_entries[:3]:
            print(f"   • {allocation.symbol}: {allocation.allocation_percentage:.1%} allocation - {allocation.reasoning}")
    
    if accumulation:
        print(f"\n🔄 ACCUMULATION TARGETS ({len(accumulation)}):")
        for allocation in accumulation[:3]:
            print(f"   • {allocation.symbol}: {allocation.allocation_percentage:.1%} allocation - {allocation.reasoning}")
    
    # Risk management rules
    print(f"\n🛡️ RISK MANAGEMENT RULES")
    print("=" * 60)
    print(f"• STOP LOSS: Strict 5% stop loss on ALL positions")
    print(f"• POSITION SIZING: Max 40% per token (high confidence)")
    print(f"• PROFIT TAKING: Scale out at 25%, 50%, 100% gains")
    print(f"• MONITORING: Daily price/volume checks required")
    print(f"• REBALANCING: Weekly review of allocations")
    
    # Save allocation plan
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    filename = f"microcap_all_in_allocation_{timestamp}.json"
    
    allocation_data = {
        "timestamp": datetime.now().isoformat(),
        "strategy": "Microcap All-In with MAGIC Patterns",
        "total_allocation": total_allocation,
        "stop_loss_percentage": 5.0,
        "allocations": [asdict(a) for a in allocations]
    }
    
    with open(filename, 'w') as f:
        json.dump(allocation_data, f, indent=2)
    
    print(f"\n💾 Allocation plan saved: {filename}")
    print(f"\n🎯 MICROCAP ALL-IN SYSTEM READY!")


if __name__ == "__main__":
    main()
