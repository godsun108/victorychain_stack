#!/usr/bin/env python3
"""
Micro Allocation Booster - Make Small Amounts COUNT! 💪
Specifically designed to work with small USDT balances
"""

import os
import json
import time
from datetime import datetime
from binance.client import Client
from dotenv import load_dotenv

class MicroAllocationBooster:
    def __init__(self):
        load_dotenv()
        
        self.client = Client(
            api_key=os.getenv('BINANCEUS_KEY'),
            api_secret=os.getenv('BINANCEUS_SECRET'),
            tld='us'
        )

    def get_usdt_balance(self):
        """Get exact USDT balance"""
        try:
            account = self.client.get_account()
            for balance in account['balances']:
                if balance['asset'] == 'USDT':
                    return float(balance['free'])
            return 0
        except Exception as e:
            print(f"Error getting USDT: {e}")
            return 0

    def get_best_performers(self):
        """Get your best performing tokens"""
        try:
            account = self.client.get_account()
            performers = []
            
            for balance in account['balances']:
                amount = float(balance['free']) + float(balance['locked'])
                
                if amount > 0.001 and balance['asset'] != 'USDT':
                    try:
                        symbol = balance['asset'] + 'USDT'
                        ticker = self.client.get_ticker(symbol=symbol)
                        momentum = float(ticker['priceChangePercent'])
                        price = float(ticker['lastPrice'])
                        usd_value = amount * price
                        
                        if usd_value > 1:  # Only meaningful positions
                            performers.append({
                                'asset': balance['asset'],
                                'symbol': symbol,
                                'momentum': momentum,
                                'usd_value': usd_value,
                                'amount': amount
                            })
                    except:
                        continue
            
            return sorted(performers, key=lambda x: x['momentum'], reverse=True)
            
        except Exception as e:
            print(f"Error getting performers: {e}")
            return []

    def micro_buy(self, symbol, usd_amount):
        """Execute micro buy order"""
        try:
            print(f"🔹 MICRO BUY: {symbol} for ${usd_amount:.2f}")
            
            order = self.client.order_market_buy(
                symbol=symbol,
                quoteOrderQty=usd_amount
            )
            
            print(f"✅ SUCCESS! Order ID: {order['orderId']}")
            
            # Get filled quantity for confirmation
            filled_qty = float(order.get('executedQty', 0))
            print(f"📦 Received: {filled_qty:.8f} {symbol.replace('USDT', '')}")
            
            return True
            
        except Exception as e:
            print(f"❌ FAILED: {e}")
            return False

    def run_micro_boost(self):
        """Run micro allocation boost"""
        print("💪 MICRO ALLOCATION BOOSTER")
        print("=" * 40)
        print("🎯 Making small amounts COUNT!")
        print()
        
        # Check USDT balance
        usdt = self.get_usdt_balance()
        print(f"💵 Available USDT: ${usdt:.2f}")
        
        if usdt < 0.5:
            print("❌ Need at least $0.50 for micro boost")
            print("💡 Try depositing more USDT or wait for balance to grow!")
            return
        
        # Get best performers
        performers = self.get_best_performers()
        
        if not performers:
            print("❌ No performers found")
            return
        
        print("\n🏆 YOUR BEST PERFORMERS:")
        print("-" * 50)
        for i, perf in enumerate(performers[:5], 1):
            print(f"{i}. {perf['asset']:8s} | {perf['momentum']:+6.2f}% | ${perf['usd_value']:7.2f}")
        
        # Micro strategies
        print(f"\n💪 MICRO BOOST STRATEGIES (${usdt:.2f} available):")
        print("1. 🎯 ALL-IN on best performer")
        print("2. 🔥 50/50 split on top 2")
        print("3. 📊 Equal split on top 3")
        
        choice = input("\nChoose micro strategy (1-3): ").strip()
        
        success = False
        
        if choice == "1":
            # All-in on best
            best = performers[0]
            amount = usdt * 0.99  # Leave tiny buffer for fees
            
            print(f"\n🎯 MICRO ALL-IN: {best['asset']}")
            print(f"Amount: ${amount:.2f}")
            print(f"Current momentum: {best['momentum']:+.2f}%")
            
            if self.micro_buy(best['symbol'], amount):
                success = True
                
        elif choice == "2" and len(performers) >= 2:
            # 50/50 split
            amount_each = (usdt * 0.99) / 2
            
            if amount_each >= 0.25:  # Minimum per trade
                print(f"\n🔥 MICRO 50/50 SPLIT: ${amount_each:.2f} each")
                
                for perf in performers[:2]:
                    print(f"\n{perf['asset']} ({perf['momentum']:+.2f}%)")
                    if self.micro_buy(perf['symbol'], amount_each):
                        success = True
                        time.sleep(1)
            else:
                print("❌ Amount too small for 50/50 split")
                
        elif choice == "3" and len(performers) >= 3:
            # Three-way split
            amount_each = (usdt * 0.99) / 3
            
            if amount_each >= 0.15:  # Minimum per trade
                print(f"\n📊 MICRO 3-WAY SPLIT: ${amount_each:.2f} each")
                
                for perf in performers[:3]:
                    print(f"\n{perf['asset']} ({perf['momentum']:+.2f}%)")
                    if self.micro_buy(perf['symbol'], amount_each):
                        success = True
                        time.sleep(1)
            else:
                print("❌ Amount too small for 3-way split")
        else:
            print("❌ Invalid choice or insufficient performers")
            return
        
        if success:
            print("\n🎉 MICRO BOOST COMPLETE!")
            print("💪 Small amount = BIG IMPACT!")
            print("📈 YOUR NUMBERS WILL GROW!")
            
            # Show final message
            print("\n💡 MICRO BOOST TIPS:")
            print("• Every dollar counts in crypto!")
            print("• Small consistent additions compound over time")
            print("• Your best performers deserve more allocation")
            print("• Run this regularly with any spare USDT")
            
            # Save record
            boost_record = {
                'timestamp': datetime.now().isoformat(),
                'strategy': f'Micro Boost Strategy {choice}',
                'usdt_used': usdt,
                'performers_targeted': len(performers[:int(choice)])
            }
            
            filename = f"micro_boost_{datetime.now().strftime('%Y%m%d_%H%M%S')}.json"
            with open(filename, 'w') as f:
                json.dump(boost_record, f, indent=2, default=str)
            
            print(f"💾 Boost record: {filename}")
        else:
            print("❌ Micro boost failed")

def main():
    booster = MicroAllocationBooster()
    booster.run_micro_boost()

if __name__ == "__main__":
    main()
