            print(f"\n📊 POSITION SIZING RECOMMENDATION:")
            print(f"   Conservative: $50 (21% of available funds)")
            print(f"   Moderate: $75 (32% of available funds)")
            print(f"   Aggressive: $100 (42% of available funds)")

def main():
    analyzer = SimpleStatisticalAnalyzer()
    results = analyzer.run_complete_analysis()
    analyzer.display_results(results)
    
