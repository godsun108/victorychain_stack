        print(f"📈 Found {len(results)} statistically favorable opportunities:\n")
        
        for i, token in enumerate(results, 1):
            risk_emoji = "🟢" if token['risk_score'] <= 40 else "🟡" if token['risk_score'] <= 60 else "🔴"
            
            print(f"{i}. {token['symbol']} 📊")
