#!/usr/bin/env python3
"""Generate JWT for FastAPI agent roles.
Usage:
  export JWT_SECRET=...; python3 scripts/token_gen.py steward
  Roles: member | steward | flamekeeper
"""
import os, sys
from jose import jwt

ALGO = "HS256"
secret = os.getenv("JWT_SECRET")
if not secret:
    print("JWT_SECRET env required", file=sys.stderr)
    sys.exit(1)
role = (sys.argv[1] if len(sys.argv) > 1 else "member").lower()
if role not in {"member","steward","flamekeeper"}:
    print("invalid role", file=sys.stderr)
    sys.exit(2)
print(jwt.encode({"role": role}, secret, algorithm=ALGO))
