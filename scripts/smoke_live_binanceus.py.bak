#!/usr/bin/env python3
import os, sys, time, json
from libs.exchange_adapters.binance_us import guarded_create_order, guarded_cancel_order

MODE = os.getenv('MODE','paper').lower()
if MODE != 'live':
    print('GO_LIVE_BLOCKED:MODE_not_live')
    sys.exit(2)

required = ['APPROVAL_SECRET','BINANCEUS_API_KEY','BINANCEUS_API_SECRET']
missing = [k for k in required if not os.getenv(k)]
if missing:
    print('GO_LIVE_BLOCKED:missing_env:' + ','.join(missing))
    sys.exit(2)

symbol = os.getenv('SMOKE_SYMBOL','BTC/USDT')
amount = float(os.getenv('SMOKE_AMOUNT','0.0001'))

try:
    res = guarded_create_order(symbol, 'buy', 'market', amount)
    oid = (res or {}).get('id') if isinstance(res, dict) else None
    time.sleep(1)
    if oid:
        try:
            cr = guarded_cancel_order(oid, symbol)
        except Exception:
            cr = {'note':'cancel_failed_or_not_needed'}
    else:
        cr = {'note':'no_order_id'}
    print('LIVE_SMOKE_TEST_OK', json.dumps({'order_id': oid, 'cancel': cr}, default=str))
except Exception as e:
    print('LIVE_SMOKE_TEST_FAIL', str(e))
    sys.exit(1)
