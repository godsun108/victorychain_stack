o);\n}\n\nfn main() {\n    // Calling the method is still fine, as i32 implements Debug.\n    some_func(5i32);\n\n    // This would fail to compile now:\n    // struct WithoutDebug;\n    // some_func(WithoutDebug);\n}\n```\n\nRust only looks at the signature of the called function, as such it must\nalready specify all requirements that will be used for every type parameter.\n"},"level":"error","spans":[{"file_name":"backend/src/websocket.rs","byte_start":1662,"byte_end":1678,"line_start":52,"line_end":52,"column_start":39,"column_end":55,"is_primary":true,"text":[{"text":"        tokio::try_join!(ticker_task, mini_ticker_task)?;","highlight_start":39,"highlight_end":55}],"label":"`Result<(), anyhow::Error>` is not a future","suggested_replacement":null,"suggestion_applicability":null,"expansion":null},{"file_name":"/Users/nicholaskramer/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/tokio-1.47.1/src/macros/try_join.rs","byte_start":7190,"byte_end":7200,"line_start":191,"line_end":191,"column_start":32,"column_end":42,"is_primary":false,"text":[{"text":"        let mut futures = ( $( maybe_done($e), )* );","highlight_start":32,"highlight_end":42}],"label":"required by a bound introduced by this call","suggested_replacement":null,"suggestion_applicability":null,"expansion":{"span":{"file_name":"/Users/nicholaskramer/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/tokio-1.47.1/src/macros/try_join.rs","byte_start":10204,"byte_end":10296,"line_start":268,"line_end":268,"column_start":7,"column_end":99,"is_primary":false,"text":[{"text":"      $crate::try_join!(@{ rotator=$rotator; ($($s)* _) ($($n)* + 1) $($t)* ($($s)*) $e, } $($r)*)","highlight_start":7,"highlight_end":99}],"label":null,"suggested_replacement":null,"suggestion_applicability":null,"expansion":{"span":{"file_name":"/Users/nicholaskramer/.cargo/registry/src/index.crates.io-1949cf8c6b5b557f/tokio-1.47.1/src/macros/try_join.rs","byte_start":10204,"byte_end":10296,"line_start":268,"line_end":268,"c