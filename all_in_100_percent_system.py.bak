#!/usr/bin/env python3

"""
🚀 100% ALL-IN MICROCAP ALLOCATION SYSTEM
Ultimate all-in strategy for maximum MAGIC-like gains
Single token, maximum allocation with 5% stop loss protection
"""

import json
import os
import sys
from datetime import datetime, timedelta
from typing import Dict, List, Tuple, Optional
import statistics
import numpy as np
from dataclasses import dataclass, asdict

# Add project root to path
sys.path.append(os.path.dirname(__file__))

try:
    from binance.client import Client
    from binance.exceptions import BinanceAPIException
    binance_available = True
except ImportError:
    binance_available = False

from dotenv import load_dotenv
load_dotenv(os.path.join(os.path.dirname(__file__), 'config', '.env'))

@dataclass
class AllInPosition:
    """100% all-in position details"""
    symbol: str
    current_price: float
    entry_price: float
    stop_loss_price: float
    take_profit_levels: List[float]
    allocation_percentage: float
    position_value: float
    shares_to_buy: float
    magic_similarity_score: float
    gain_potential: float
    confidence_score: float
    risk_assessment: Dict
    execution_plan: Dict
    monitoring_alerts: List[str]
    exit_strategy: Dict
    reasoning: str

class AllInMicrocapSystem:
    """100% All-in allocation system for ultimate microcap plays"""
    
    def __init__(self, portfolio_value: float = 10000):
        # Initialize Binance client
        self.BINANCEUS_KEY = os.getenv('BINANCEUS_KEY')
        self.BINANCEUS_SECRET = os.getenv('BINANCEUS_SECRET')
        self.client = None
        
        if binance_available and self.BINANCEUS_KEY:
            try:
                self.client = Client(self.BINANCEUS_KEY, self.BINANCEUS_SECRET)
                print("✅ 100% All-In System connected to Binance")
            except Exception as e:
                print(f"⚠️ Binance client error: {e}")
        
        self.portfolio_value = portfolio_value
        self.all_tokens = self._load_token_data()
        
        # MAGIC-proven patterns for maximum gains
        self.magic_success_patterns = {
            "double_bottom_recovery": {
                "success_rate": 0.80,
                "avg_gain": 1.57,  # 157% gain
                "max_observed": 3.50,  # 350% max
                "confidence_threshold": 0.75
            },
            "volume_breakout_surge": {
                "success_rate": 0.75,
                "avg_gain": 1.24,  # 124% gain
                "max_observed": 2.80,  # 280% max
                "confidence_threshold": 0.70
            },
            "gaming_momentum_wave": {
                "success_rate": 0.70,
                "avg_gain": 0.89,  # 89% gain
                "max_observed": 2.20,  # 220% max
                "confidence_threshold": 0.65
            }
        }
        
        # Ultra-tight risk management for 100% allocation
        self.risk_config = {
            "stop_loss_percentage": 0.05,  # 5% maximum loss
            "position_size": 1.0,  # 100% allocation
            "profit_scaling": [0.25, 0.35, 0.40],  # 25%, 35%, 40% profit taking
            "profit_targets": [0.50, 1.00, 2.00],  # 50%, 100%, 200% targets
            "trailing_stop": 0.10,  # 10% trailing stop after 50% gain
            "max_holding_period": 90  # 90 days max hold
        }
    
    def _load_token_data(self) -> List[Dict]:
        """Load comprehensive token data"""
        try:
            with open('comprehensive_token_analysis_20250805_155947.json', 'r') as f:
                return json.load(f)
        except FileNotFoundError:
            print("⚠️ Token analysis file not found")
            return []
    
    def find_ultimate_microcap(self) -> Optional[Dict]:
        """Find the single best microcap for 100% allocation"""
        
        print("🔍 Searching for ultimate microcap opportunity...")
        
        # Ultra-strict microcap criteria for 100% allocation
        candidates = []
        
        for token in self.all_tokens:
            price = token.get('price', 0)
            volume = token.get('volume_24h_usdt', 0)
            momentum_score = token.get('momentum_score', 0)
            volatility = token.get('volatility', 0)
            change_24h = token.get('price_change_24h', 0)
            
            # Strict filtering criteria
            if (0.00001 <= price <= 0.01 and  # Microcap price range
                volume >= 5000 and  # Minimum liquidity
                momentum_score >= 5.0 and  # Strong momentum
                volatility >= 0.05 and  # Sufficient volatility for gains
                abs(change_24h) <= 20):  # Not in extreme move
                
                # Calculate comprehensive scoring
                score = self._calculate_ultimate_score(token)
                candidates.append((token, score))
        
        if not candidates:
            print("❌ No suitable candidates found for 100% allocation")
            return None
        
        # Sort by score and return the best
        candidates.sort(key=lambda x: x[1], reverse=True)
        best_token, best_score = candidates[0]
        
        print(f"🎯 Ultimate microcap selected: {best_token['symbol']} (Score: {best_score:.1f}/100)")
        return best_token
    
    def _calculate_ultimate_score(self, token: Dict) -> float:
        """Calculate ultimate scoring for 100% allocation decision"""
        
        price = token.get('price', 0)
        volume = token.get('volume_24h_usdt', 0)
        change_24h = token.get('price_change_24h', 0)
        momentum_score = token.get('momentum_score', 0)
        volatility = token.get('volatility', 0)
        sector = token.get('sector', 'general')
        
        total_score = 0
        
        # 1. MAGIC Pattern Similarity (25 points)
        magic_score = 0
        if change_24h < -5 and volume > 10000:  # Double bottom setup
            magic_score += 15
        if momentum_score > 6:  # Strong momentum
            magic_score += 10
        total_score += min(magic_score, 25)
        
        # 2. Volume Quality (20 points)
        if volume > 50000:
            volume_score = 20
        elif volume > 20000:
            volume_score = 15
        elif volume > 10000:
            volume_score = 10
        else:
            volume_score = 5
        total_score += volume_score
        
        # 3. Volatility Potential (20 points)
        if 0.08 <= volatility <= 0.15:  # Sweet spot for gains
            volatility_score = 20
        elif 0.05 <= volatility <= 0.20:
            volatility_score = 15
        else:
            volatility_score = 5
        total_score += volatility_score
        
        # 4. Momentum Strength (15 points)
        momentum_points = min(momentum_score * 2.5, 15)
        total_score += momentum_points
        
        # 5. Sector Advantage (10 points)
        sector_points = {
            'gaming': 10, 'meme': 10, 'defi': 8, 'nft': 8,
            'metaverse': 7, 'layer1': 6, 'general': 3
        }.get(sector, 3)
        total_score += sector_points
        
        # 6. Price Position (10 points)
        # Lower price = higher potential
        if price < 0.001:
            price_score = 10
        elif price < 0.005:
            price_score = 8
        else:
            price_score = 5
        total_score += price_score
        
        return min(total_score, 100)
    
    def calculate_position_details(self, token: Dict) -> AllInPosition:
        """Calculate detailed 100% allocation position"""
        
        symbol = token['symbol']
        current_price = token['price']
        
        # Entry price (slight discount for better execution)
        entry_price = current_price * 0.999
        
        # Stop loss (strict 5%)
        stop_loss_price = entry_price * 0.95
        
        # Take profit levels
        tp_levels = [
            entry_price * (1 + target) for target in self.risk_config["profit_targets"]
        ]
        
        # Position sizing
        position_value = self.portfolio_value * self.risk_config["position_size"]
        shares_to_buy = position_value / entry_price
        
        # Calculate MAGIC similarity and gain potential
        magic_similarity = self._calculate_magic_similarity(token)
        gain_potential = self._estimate_gain_potential(token, magic_similarity)
        confidence = self._calculate_confidence(token, magic_similarity)
        
        # Risk assessment
        risk_assessment = self._assess_all_in_risk(token)
        
        # Execution plan
        execution_plan = self._create_execution_plan(token, entry_price, shares_to_buy)
        
        # Monitoring alerts
        monitoring_alerts = self._setup_monitoring_alerts(token, entry_price)
        
        # Exit strategy
        exit_strategy = self._design_exit_strategy(token, entry_price, tp_levels)
        
        # Reasoning
        reasoning = self._generate_all_in_reasoning(token, magic_similarity, confidence)
        
        return AllInPosition(
            symbol=symbol,
            current_price=current_price,
            entry_price=entry_price,
            stop_loss_price=stop_loss_price,
            take_profit_levels=tp_levels,
            allocation_percentage=1.0,
            position_value=position_value,
            shares_to_buy=shares_to_buy,
            magic_similarity_score=magic_similarity,
            gain_potential=gain_potential,
            confidence_score=confidence,
            risk_assessment=risk_assessment,
            execution_plan=execution_plan,
            monitoring_alerts=monitoring_alerts,
            exit_strategy=exit_strategy,
            reasoning=reasoning
        )
    
    def _calculate_magic_similarity(self, token: Dict) -> float:
        """Calculate similarity to proven MAGIC patterns"""
        
        change_24h = token.get('price_change_24h', 0)
        volume = token.get('volume_24h_usdt', 0)
        momentum_score = token.get('momentum_score', 0)
        volatility = token.get('volatility', 0)
        sector = token.get('sector', 'general')
        
        similarity = 0
        
        # Double bottom recovery pattern
        if change_24h < -8 and volume > 15000:
            similarity += 35  # Strong dip with volume
        elif change_24h < -5:
            similarity += 20
        
        # Volume breakout pattern
        if volume > 30000 and momentum_score > 6:
            similarity += 30
        elif volume > 15000:
            similarity += 15
        
        # Gaming/sector momentum
        if sector in ['gaming', 'meme', 'nft']:
            similarity += 20
        elif sector in ['defi', 'layer1']:
            similarity += 10
        
        # Technical setup
        if 0.08 <= volatility <= 0.15:
            similarity += 15
        
        return min(similarity, 100)
    
    def _estimate_gain_potential(self, token: Dict, magic_similarity: float) -> float:
        """Estimate gain potential based on MAGIC patterns"""
        
        # Base gain from proven MAGIC patterns
        if magic_similarity >= 80:
            base_gain = 2.5  # 250% potential
        elif magic_similarity >= 60:
            base_gain = 1.5  # 150% potential
        elif magic_similarity >= 40:
            base_gain = 1.0  # 100% potential
        else:
            base_gain = 0.5  # 50% potential
        
        # Volatility multiplier
        volatility = token.get('volatility', 0.05)
        vol_multiplier = min(volatility * 8, 2.0)
        
        # Volume confidence multiplier
        volume = token.get('volume_24h_usdt', 0)
        volume_multiplier = 1.0 + min(volume / 50000, 1.0)
        
        # Sector multiplier
        sector = token.get('sector', 'general')
        sector_multipliers = {
            'meme': 1.5, 'gaming': 1.3, 'nft': 1.2, 'defi': 1.1, 'general': 1.0
        }
        sector_mult = sector_multipliers.get(sector, 1.0)
        
        total_potential = base_gain * vol_multiplier * volume_multiplier * sector_mult
        return min(total_potential, 5.0)  # Cap at 500%
    
    def _calculate_confidence(self, token: Dict, magic_similarity: float) -> float:
        """Calculate confidence score for 100% allocation"""
        
        volume = token.get('volume_24h_usdt', 0)
        momentum_score = token.get('momentum_score', 0)
        volatility = token.get('volatility', 0)
        
        # Base confidence from MAGIC similarity
        base_confidence = magic_similarity / 100
        
        # Volume confidence
        volume_conf = min(volume / 30000, 1.0)
        
        # Momentum confidence
        momentum_conf = min(momentum_score / 8, 1.0)
        
        # Volatility confidence (not too high, not too low)
        if 0.05 <= volatility <= 0.15:
            volatility_conf = 1.0
        else:
            volatility_conf = 0.7
        
        total_confidence = (base_confidence + volume_conf + momentum_conf + volatility_conf) / 4
        return min(total_confidence, 0.95)
    
    def _assess_all_in_risk(self, token: Dict) -> Dict:
        """Assess risks for 100% allocation"""
        
        return {
            "liquidity_risk": "LOW" if token.get('volume_24h_usdt', 0) > 20000 else "HIGH",
            "volatility_risk": "MODERATE" if token.get('volatility', 0) <= 0.15 else "HIGH",
            "concentration_risk": "VERY_HIGH",  # 100% allocation
            "stop_loss_risk": "MANAGED",  # 5% stop loss
            "max_loss": f"${self.portfolio_value * 0.05:,.0f}",
            "recommended_monitoring": "HOURLY"
        }
    
    def _create_execution_plan(self, token: Dict, entry_price: float, shares: float) -> Dict:
        """Create detailed execution plan"""
        
        return {
            "execution_method": "LIMIT_ORDER",
            "order_type": "BUY_LIMIT",
            "entry_price": entry_price,
            "quantity": shares,
            "estimated_cost": shares * entry_price,
            "slippage_tolerance": 0.5,  # 0.5%
            "execution_timeframe": "IMMEDIATE",
            "backup_plan": "MARKET_ORDER if limit not filled in 30 minutes"
        }
    
    def _setup_monitoring_alerts(self, token: Dict, entry_price: float) -> List[str]:
        """Setup comprehensive monitoring alerts"""
        
        return [
            f"STOP LOSS: Alert if price drops to ${entry_price * 0.95:.6f}",
            f"TAKE PROFIT 1: Alert at ${entry_price * 1.5:.6f} (+50%)",
            f"TAKE PROFIT 2: Alert at ${entry_price * 2.0:.6f} (+100%)",
            f"TAKE PROFIT 3: Alert at ${entry_price * 3.0:.6f} (+200%)",
            f"VOLUME SPIKE: Alert if volume exceeds {token.get('volume_24h_usdt', 0) * 2:.0f}",
            f"MOMENTUM CHANGE: Alert if momentum score changes by >1.0",
            f"SECTOR NEWS: Monitor gaming/meme sector developments"
        ]
    
    def _design_exit_strategy(self, token: Dict, entry_price: float, tp_levels: List[float]) -> Dict:
        """Design comprehensive exit strategy"""
        
        return {
            "stop_loss_strategy": "HARD_STOP at -5%",
            "profit_taking_strategy": "SCALED_EXIT",
            "scaling_plan": {
                "25% at +50% gain": tp_levels[0],
                "35% at +100% gain": tp_levels[1],
                "40% at +200% gain": tp_levels[2]
            },
            "trailing_stop": "ACTIVATE at +50% gain with 10% trail",
            "time_based_exit": "REVIEW position after 90 days",
            "emergency_exit": "MARKET_SELL if stop loss triggered"
        }
    
    def _generate_all_in_reasoning(self, token: Dict, magic_similarity: float, confidence: float) -> str:
        """Generate reasoning for 100% allocation decision"""
        
        symbol = token['symbol']
        change_24h = token.get('price_change_24h', 0)
        volume = token.get('volume_24h_usdt', 0)
        sector = token.get('sector', 'general')
        
        reasoning_parts = [
            f"{symbol} selected for 100% allocation based on:",
            f"• MAGIC Pattern Similarity: {magic_similarity:.1f}/100",
            f"• Overall Confidence: {confidence:.1%}",
            f"• Current dip of {change_24h:.1f}% creates entry opportunity",
            f"• Strong volume support at ${volume:,.0f}",
            f"• {sector.title()} sector positioning",
            f"• Proven MAGIC-like gain patterns identified",
            f"• Risk managed with strict 5% stop loss"
        ]
        
        return " ".join(reasoning_parts)


def main():
    """Main execution function"""
    
    print("🚀 100% ALL-IN MICROCAP ALLOCATION SYSTEM")
    print("=" * 70)
    print("ULTIMATE STRATEGY: Maximum allocation for maximum gains")
    print("RISK MANAGEMENT: Strict 5% stop loss protection")
    print()
    
    # Initialize system
    portfolio_value = 10000  # $10,000 default portfolio
    system = AllInMicrocapSystem(portfolio_value)
    
    # Find the ultimate microcap
    best_token = system.find_ultimate_microcap()
    
    if not best_token:
        print("❌ No suitable token found for 100% allocation")
        return
    
    # Calculate position details
    position = system.calculate_position_details(best_token)
    
    # Print comprehensive analysis
    print(f"🎯 100% ALL-IN POSITION SELECTED")
    print("=" * 70)
    print(f"TOKEN: {position.symbol}")
    print(f"CURRENT PRICE: ${position.current_price:.8f}")
    print(f"MAGIC SIMILARITY: {position.magic_similarity_score:.1f}/100")
    print(f"GAIN POTENTIAL: {position.gain_potential*100:.1f}%")
    print(f"CONFIDENCE: {position.confidence_score:.1%}")
    
    print(f"\n💰 POSITION DETAILS")
    print("=" * 70)
    print(f"Portfolio Value: ${position.position_value:,.0f}")
    print(f"Allocation: {position.allocation_percentage:.0%}")
    print(f"Shares to Buy: {position.shares_to_buy:,.0f}")
    print(f"Entry Price: ${position.entry_price:.8f}")
    print(f"Position Cost: ${position.position_value:,.0f}")
    
    print(f"\n🛡️ RISK MANAGEMENT")
    print("=" * 70)
    print(f"Stop Loss: ${position.stop_loss_price:.8f} (-5.0%)")
    print(f"Maximum Loss: {position.risk_assessment['max_loss']}")
    print(f"Liquidity Risk: {position.risk_assessment['liquidity_risk']}")
    print(f"Monitoring: {position.risk_assessment['recommended_monitoring']}")
    
    print(f"\n🎯 PROFIT TARGETS")
    print("=" * 70)
    for i, target in enumerate(position.take_profit_levels, 1):
        gain_pct = ((target / position.entry_price) - 1) * 100
        print(f"Take Profit {i}: ${target:.8f} (+{gain_pct:.0f}%)")
    
    print(f"\n⚡ EXECUTION PLAN")
    print("=" * 70)
    exec_plan = position.execution_plan
    print(f"Order Type: {exec_plan['order_type']}")
    print(f"Entry Price: ${exec_plan['entry_price']:.8f}")
    print(f"Quantity: {exec_plan['quantity']:,.0f}")
    print(f"Total Cost: ${exec_plan['estimated_cost']:,.0f}")
    print(f"Execution: {exec_plan['execution_timeframe']}")
    
    print(f"\n📱 MONITORING ALERTS")
    print("=" * 70)
    for alert in position.monitoring_alerts:
        print(f"• {alert}")
    
    print(f"\n🚪 EXIT STRATEGY")
    print("=" * 70)
    exit_strategy = position.exit_strategy
    print(f"Stop Loss: {exit_strategy['stop_loss_strategy']}")
    print(f"Profit Taking: {exit_strategy['profit_taking_strategy']}")
    print("Scaling Plan:")
    for plan, price in exit_strategy['scaling_plan'].items():
        print(f"  • {plan}: ${price:.8f}")
    print(f"Trailing Stop: {exit_strategy['trailing_stop']}")
    
    print(f"\n💭 REASONING")
    print("=" * 70)
    print(position.reasoning)
    
    # Calculate potential outcomes
    print(f"\n📊 POTENTIAL OUTCOMES")
    print("=" * 70)
    
    # Best case scenario
    best_case_gain = position.gain_potential
    best_case_value = portfolio_value * (1 + best_case_gain)
    print(f"🟢 BEST CASE: {best_case_gain*100:.0f}% gain = ${best_case_value:,.0f}")
    
    # Conservative case
    conservative_gain = 0.5  # 50%
    conservative_value = portfolio_value * 1.5
    print(f"🟡 CONSERVATIVE: 50% gain = ${conservative_value:,.0f}")
    
    # Stop loss case
    stop_loss_value = portfolio_value * 0.95
    print(f"🔴 STOP LOSS: -5% loss = ${stop_loss_value:,.0f}")
    
    # Save position details
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    filename = f"100_percent_all_in_position_{timestamp}.json"
    
    position_data = {
        "timestamp": datetime.now().isoformat(),
        "strategy": "100% All-In Microcap",
        "position": asdict(position),
        "portfolio_value": portfolio_value,
        "risk_parameters": system.risk_config
    }
    
    with open(filename, 'w') as f:
        json.dump(position_data, f, indent=2)
    
    print(f"\n💾 Position details saved: {filename}")
    
    print(f"\n🚨 FINAL WARNINGS")
    print("=" * 70)
    print("• This is a 100% allocation strategy - EXTREMELY HIGH RISK")
    print("• Only suitable for experienced traders with high risk tolerance")
    print("• Monitor position constantly - set up all alerts immediately")
    print("• Stick to the 5% stop loss - NO EXCEPTIONS")
    print("• Take profits according to the scaling plan")
    print("• Never add to losing positions")
    
    print(f"\n🎯 100% ALL-IN SYSTEM READY FOR EXECUTION!")


if __name__ == "__main__":
    main()
