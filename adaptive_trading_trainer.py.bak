#!/usr/bin/env python3
"""
ADAPTIVE TRADING PARAMETER TRAINER
==================================

Trains Claude to analyze and adjust trading parameters with every trade execution.
Implements machine learning for continuous parameter optimization and scaling adjustment.
"""

import json
import logging
import asyncio
import numpy as np
from datetime import datetime
from typing import Dict, List, Tuple, Optional
from dataclasses import dataclass, asdict
import pickle
import os
from sklearn.ensemble import RandomForestRegressor
from sklearn.preprocessing import StandardScaler
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_error, r2_score

# Configure logging
logging.basicConfig(
    level=logging.INFO,
    format='%(asctime)s - %(levelname)s - %(message)s',
    handlers=[
        logging.FileHandler('adaptive_trading_trainer.log'),
        logging.StreamHandler()
    ]
)
logger = logging.getLogger(__name__)

@dataclass
class TradeExecution:
    """Individual trade execution record"""
    timestamp: str
    symbol: str
    action: str  # BUY, SELL, HOLD
    position_size: float
    entry_price: float
    exit_price: Optional[float]
    expected_profit: float
    actual_profit: float
    gas_fees: float
    execution_time: float
    market_conditions: Dict
    success_score: float  # 0-1 rating

@dataclass
class TradingParameters:
    """Current trading parameter set"""
    min_profit_threshold: float
    max_gas_ratio: float
    position_size_multiplier: float
    risk_tolerance: float
    urgency_threshold: float
    confidence_threshold: float
    market_volatility_factor: float
    scaling_factor: float
    profit_target_multiplier: float
    stop_loss_percentage: float

class AdaptiveTradingTrainer:
    """
    Adaptive Learning System for Trading Parameter Optimization
    
    Features:
    - Continuous learning from trade outcomes
    - Parameter adjustment based on performance
    - Scaling optimization for position sizing
    - Performance prediction and optimization
    """
    
    def __init__(self):
        self.trade_history: List[TradeExecution] = []
        self.current_parameters = TradingParameters(
            min_profit_threshold=100.0,
            max_gas_ratio=0.10,
            position_size_multiplier=1.0,
            risk_tolerance=0.75,
            urgency_threshold=0.80,
            confidence_threshold=0.70,
            market_volatility_factor=1.0,
            scaling_factor=1.0,
            profit_target_multiplier=1.2,
            stop_loss_percentage=0.05
        )
        
        # ML Models for parameter optimization
        self.profit_predictor = RandomForestRegressor(n_estimators=100, random_state=42)
        self.risk_predictor = RandomForestRegressor(n_estimators=100, random_state=42)
        self.scaling_optimizer = RandomForestRegressor(n_estimators=100, random_state=42)
        self.scaler = StandardScaler()
        
        # Performance tracking
        self.performance_metrics = {
            'total_trades': 0,
            'successful_trades': 0,
            'total_profit': 0.0,
            'average_profit_per_trade': 0.0,
            'win_rate': 0.0,
            'parameter_adjustments': 0,
            'learning_iterations': 0
        }
        
        # Load existing data if available
        self.load_training_data()
    
    def record_trade_execution(self, trade: TradeExecution):
        """Record a completed trade for learning"""
        logger.info(f"📝 Recording trade execution: {trade.symbol} - {trade.action}")
        
        # Calculate success score based on actual vs expected performance
        if trade.expected_profit > 0:
            success_ratio = trade.actual_profit / trade.expected_profit
            trade.success_score = min(1.0, max(0.0, success_ratio))
        else:
            trade.success_score = 1.0 if trade.actual_profit > 0 else 0.0
        
        self.trade_history.append(trade)
        self.update_performance_metrics(trade)
        
        # Trigger learning if we have enough data
        if len(self.trade_history) >= 5:
            self.train_models()
            self.optimize_parameters()
        
        logger.info(f"✅ Trade recorded. Success score: {trade.success_score:.2f}")
    
    def update_performance_metrics(self, trade: TradeExecution):
        """Update overall performance metrics"""
        self.performance_metrics['total_trades'] += 1
        
        if trade.success_score >= 0.7:
            self.performance_metrics['successful_trades'] += 1
        
        self.performance_metrics['total_profit'] += trade.actual_profit
        self.performance_metrics['average_profit_per_trade'] = (
            self.performance_metrics['total_profit'] / self.performance_metrics['total_trades']
        )
        self.performance_metrics['win_rate'] = (
            self.performance_metrics['successful_trades'] / self.performance_metrics['total_trades']
        )
    
    def extract_features(self, trade: TradeExecution) -> List[float]:
        """Extract features for machine learning"""
        market_conditions = trade.market_conditions
        
        features = [
            trade.position_size,
            trade.expected_profit,
            trade.gas_fees,
            self.current_parameters.min_profit_threshold,
            self.current_parameters.max_gas_ratio,
            self.current_parameters.position_size_multiplier,
            self.current_parameters.risk_tolerance,
            self.current_parameters.scaling_factor,
            market_conditions.get('volatility', 0.5),
            market_conditions.get('volume', 0.5),
            market_conditions.get('momentum', 0.5),
            market_conditions.get('trend_strength', 0.5),
            len(self.trade_history),  # Experience factor
            self.performance_metrics['win_rate']
        ]
        
        return features
    
    def train_models(self):
        """Train machine learning models on historical data"""
        if len(self.trade_history) < 5:
            return
        
        logger.info("🧠 Training adaptive learning models...")
        
        # Prepare training data
        features = []
        profit_targets = []
        risk_scores = []
        scaling_targets = []
        
        for trade in self.trade_history[-50:]:  # Use last 50 trades
            feature_vector = self.extract_features(trade)
            features.append(feature_vector)
            
            # Target values
            profit_targets.append(trade.actual_profit)
            risk_scores.append(1.0 - trade.success_score)  # Higher risk = lower success
            
            # Optimal scaling based on performance
            optimal_scaling = self.calculate_optimal_scaling(trade)
            scaling_targets.append(optimal_scaling)
        
        features_array = np.array(features)
        
        # Scale features
        if len(features) > 1:
            features_scaled = self.scaler.fit_transform(features_array)
            
            # Train models
            self.profit_predictor.fit(features_scaled, profit_targets)
            self.risk_predictor.fit(features_scaled, risk_scores)
            self.scaling_optimizer.fit(features_scaled, scaling_targets)
            
            # Evaluate model performance
            if len(features) > 2:
                X_train, X_test, y_train, y_test = train_test_split(
                    features_scaled, profit_targets, test_size=0.3, random_state=42
                )
                y_pred = self.profit_predictor.predict(X_test)
                r2 = r2_score(y_test, y_pred)
                
                logger.info(f"📊 Model Performance - R² Score: {r2:.3f}")
                self.performance_metrics['learning_iterations'] += 1
    
    def calculate_optimal_scaling(self, trade: TradeExecution) -> float:
        """Calculate optimal scaling factor based on trade performance"""
        # Higher success = should have used larger position
        # Lower success = should have used smaller position
        
        base_scaling = 1.0
        
        if trade.success_score > 0.8:
            # Great trade - could have scaled up
            optimal_scaling = base_scaling * (1.0 + trade.success_score * 0.5)
        elif trade.success_score < 0.5:
            # Poor trade - should have scaled down
            optimal_scaling = base_scaling * (0.5 + trade.success_score * 0.5)
        else:
            # Moderate performance - slight adjustment
            optimal_scaling = base_scaling
        
        return min(2.0, max(0.1, optimal_scaling))  # Limit scaling range
    
    def optimize_parameters(self):
        """Optimize trading parameters based on learned patterns"""
        if len(self.trade_history) < 10:
            return
        
        logger.info("⚙️ Optimizing trading parameters based on learning...")
        
        # Analyze recent performance
        recent_trades = self.trade_history[-10:]
        avg_success = np.mean([t.success_score for t in recent_trades])
        avg_profit = np.mean([t.actual_profit for t in recent_trades])
        
        # Adjust parameters based on performance
        adjustments_made = []
        
        # 1. Adjust minimum profit threshold
        if avg_profit < self.current_parameters.min_profit_threshold * 0.5:
            # Profits too low - reduce threshold
            new_threshold = self.current_parameters.min_profit_threshold * 0.9
            self.current_parameters.min_profit_threshold = max(50.0, new_threshold)
            adjustments_made.append(f"Min profit threshold: {new_threshold:.1f}")
        elif avg_profit > self.current_parameters.min_profit_threshold * 2:
            # Profits high - increase threshold for quality
            new_threshold = self.current_parameters.min_profit_threshold * 1.1
            self.current_parameters.min_profit_threshold = min(500.0, new_threshold)
            adjustments_made.append(f"Min profit threshold: {new_threshold:.1f}")
        
        # 2. Adjust gas ratio tolerance
        avg_gas_ratio = np.mean([t.gas_fees / max(t.actual_profit, 1) for t in recent_trades])
        if avg_gas_ratio > self.current_parameters.max_gas_ratio:
            # Gas costs too high - tighten ratio
            new_ratio = self.current_parameters.max_gas_ratio * 0.9
            self.current_parameters.max_gas_ratio = max(0.01, new_ratio)
            adjustments_made.append(f"Max gas ratio: {new_ratio:.3f}")
        
        # 3. Adjust scaling factor based on ML prediction
        if hasattr(self.scaling_optimizer, 'feature_importances_'):
            # Use current market conditions to predict optimal scaling
            current_features = self.get_current_market_features()
            if len(current_features) > 0:
                features_scaled = self.scaler.transform([current_features])
                optimal_scaling = self.scaling_optimizer.predict(features_scaled)[0]
                
                # Gradually adjust towards optimal
                adjustment_rate = 0.1
                new_scaling = (
                    self.current_parameters.scaling_factor * (1 - adjustment_rate) +
                    optimal_scaling * adjustment_rate
                )
                self.current_parameters.scaling_factor = new_scaling
                adjustments_made.append(f"Scaling factor: {new_scaling:.2f}")
        
        # 4. Adjust risk tolerance based on success rate
        if avg_success > 0.8:
            # High success rate - can increase risk tolerance
            new_tolerance = min(0.95, self.current_parameters.risk_tolerance * 1.05)
            self.current_parameters.risk_tolerance = new_tolerance
            adjustments_made.append(f"Risk tolerance: {new_tolerance:.2f}")
        elif avg_success < 0.6:
            # Low success rate - decrease risk tolerance
            new_tolerance = max(0.5, self.current_parameters.risk_tolerance * 0.95)
            self.current_parameters.risk_tolerance = new_tolerance
            adjustments_made.append(f"Risk tolerance: {new_tolerance:.2f}")
        
        # 5. Adjust position size multiplier
        if avg_success > 0.8 and avg_profit > 200:
            # Great performance - can increase position sizes
            new_multiplier = min(2.0, self.current_parameters.position_size_multiplier * 1.1)
            self.current_parameters.position_size_multiplier = new_multiplier
            adjustments_made.append(f"Position multiplier: {new_multiplier:.2f}")
        elif avg_success < 0.5:
            # Poor performance - reduce position sizes
            new_multiplier = max(0.5, self.current_parameters.position_size_multiplier * 0.9)
            self.current_parameters.position_size_multiplier = new_multiplier
            adjustments_made.append(f"Position multiplier: {new_multiplier:.2f}")
        
        if adjustments_made:
            self.performance_metrics['parameter_adjustments'] += 1
            logger.info(f"📈 Parameter adjustments made: {', '.join(adjustments_made)}")
        
        # Save updated parameters
        self.save_training_data()
    
    def get_current_market_features(self) -> List[float]:
        """Get current market features for prediction"""
        # Simulated current market conditions
        # In real implementation, would fetch from live data
        return [
            1000.0,  # position_size
            200.0,   # expected_profit
            5.0,     # gas_fees
            self.current_parameters.min_profit_threshold,
            self.current_parameters.max_gas_ratio,
            self.current_parameters.position_size_multiplier,
            self.current_parameters.risk_tolerance,
            self.current_parameters.scaling_factor,
            0.6,     # volatility
            0.7,     # volume
            0.8,     # momentum
            0.75,    # trend_strength
            len(self.trade_history),
            self.performance_metrics['win_rate']
        ]
    
    def predict_trade_outcome(self, symbol: str, position_size: float, expected_profit: float, 
                            gas_fees: float, market_conditions: Dict) -> Dict:
        """Predict trade outcome using trained models"""
        if not hasattr(self.profit_predictor, 'feature_importances_'):
            # Models not trained yet
            return {
                'predicted_profit': expected_profit,
                'predicted_risk': 0.3,
                'optimal_scaling': 1.0,
                'confidence': 0.5
            }
        
        # Create feature vector
        features = [
            position_size,
            expected_profit,
            gas_fees,
            self.current_parameters.min_profit_threshold,
            self.current_parameters.max_gas_ratio,
            self.current_parameters.position_size_multiplier,
            self.current_parameters.risk_tolerance,
            self.current_parameters.scaling_factor,
            market_conditions.get('volatility', 0.5),
            market_conditions.get('volume', 0.5),
            market_conditions.get('momentum', 0.5),
            market_conditions.get('trend_strength', 0.5),
            len(self.trade_history),
            self.performance_metrics['win_rate']
        ]
        
        features_scaled = self.scaler.transform([features])
        
        # Make predictions
        predicted_profit = self.profit_predictor.predict(features_scaled)[0]
        predicted_risk = self.risk_predictor.predict(features_scaled)[0]
        optimal_scaling = self.scaling_optimizer.predict(features_scaled)[0]
        
        # Calculate confidence based on model performance
        confidence = min(1.0, self.performance_metrics['win_rate'] + 0.2)
        
        return {
            'predicted_profit': predicted_profit,
            'predicted_risk': max(0.0, min(1.0, predicted_risk)),
            'optimal_scaling': max(0.1, min(2.0, optimal_scaling)),
            'confidence': confidence
        }
    
    def get_optimized_position_size(self, base_position_size: float, symbol: str, 
                                  expected_profit: float, market_conditions: Dict) -> float:
        """Get optimized position size using adaptive scaling"""
        gas_fees = base_position_size * 0.001  # Estimate gas fees
        
        prediction = self.predict_trade_outcome(
            symbol, base_position_size, expected_profit, gas_fees, market_conditions
        )
        
        # Apply adaptive scaling
        scaling_factor = prediction['optimal_scaling']
        risk_adjustment = 1.0 - (prediction['predicted_risk'] * 0.5)
        confidence_adjustment = prediction['confidence']
        
        # Combine all factors
        final_scaling = (
            scaling_factor * 
            risk_adjustment * 
            confidence_adjustment * 
            self.current_parameters.position_size_multiplier
        )
        
        optimized_size = base_position_size * final_scaling
        
        logger.info(f"📊 Position optimization for {symbol}:")
        logger.info(f"   Base size: ${base_position_size:.2f}")
        logger.info(f"   Scaling factor: {scaling_factor:.2f}")
        logger.info(f"   Risk adjustment: {risk_adjustment:.2f}")
        logger.info(f"   Confidence: {confidence_adjustment:.2f}")
        logger.info(f"   Final size: ${optimized_size:.2f}")
        
        return optimized_size
    
    def analyze_parameter_effectiveness(self) -> Dict:
        """Analyze which parameters are most effective"""
        if len(self.trade_history) < 5:
            return {"message": "Insufficient data for analysis"}
        
        # Group trades by parameter ranges and analyze success
        analysis = {
            'total_trades_analyzed': len(self.trade_history),
            'current_parameters': asdict(self.current_parameters),
            'parameter_effectiveness': {},
            'recommendations': []
        }
        
        # Analyze scaling factor effectiveness
        high_scaling_trades = [t for t in self.trade_history if t.market_conditions.get('scaling', 1.0) > 1.2]
        low_scaling_trades = [t for t in self.trade_history if t.market_conditions.get('scaling', 1.0) < 0.8]
        
        if high_scaling_trades:
            high_scaling_success = np.mean([t.success_score for t in high_scaling_trades])
            analysis['parameter_effectiveness']['high_scaling_success'] = high_scaling_success
            
            if high_scaling_success > 0.7:
                analysis['recommendations'].append("Consider increasing scaling factor for profitable opportunities")
        
        if low_scaling_trades:
            low_scaling_success = np.mean([t.success_score for t in low_scaling_trades])
            analysis['parameter_effectiveness']['low_scaling_success'] = low_scaling_success
            
            if low_scaling_success < 0.5:
                analysis['recommendations'].append("Reduce position sizes for uncertain trades")
        
        # Performance summary
        analysis['performance_summary'] = self.performance_metrics.copy()
        
        return analysis
    
    def save_training_data(self):
        """Save training data and models"""
        data = {
            'trade_history': [asdict(trade) for trade in self.trade_history],
            'current_parameters': asdict(self.current_parameters),
            'performance_metrics': self.performance_metrics,
            'timestamp': datetime.now().isoformat()
        }
        
        with open('adaptive_trading_data.json', 'w') as f:
            json.dump(data, f, indent=2)
        
        # Save ML models
        if hasattr(self.profit_predictor, 'feature_importances_'):
            with open('trading_models.pkl', 'wb') as f:
                pickle.dump({
                    'profit_predictor': self.profit_predictor,
                    'risk_predictor': self.risk_predictor,
                    'scaling_optimizer': self.scaling_optimizer,
                    'scaler': self.scaler
                }, f)
    
    def load_training_data(self):
        """Load existing training data and models"""
        try:
            if os.path.exists('adaptive_trading_data.json'):
                with open('adaptive_trading_data.json', 'r') as f:
                    data = json.load(f)
                
                # Load trade history
                self.trade_history = [
                    TradeExecution(**trade) for trade in data.get('trade_history', [])
                ]
                
                # Load parameters
                if 'current_parameters' in data:
                    self.current_parameters = TradingParameters(**data['current_parameters'])
                
                # Load performance metrics
                if 'performance_metrics' in data:
                    self.performance_metrics.update(data['performance_metrics'])
                
                logger.info(f"✅ Loaded {len(self.trade_history)} historical trades")
            
            # Load ML models
            if os.path.exists('trading_models.pkl'):
                with open('trading_models.pkl', 'rb') as f:
                    models = pickle.load(f)
                    self.profit_predictor = models['profit_predictor']
                    self.risk_predictor = models['risk_predictor']
                    self.scaling_optimizer = models['scaling_optimizer']
                    self.scaler = models['scaler']
                
                logger.info("✅ Loaded trained ML models")
                
        except Exception as e:
            logger.warning(f"Could not load existing data: {e}")

async def simulate_trade_execution():
    """Simulate trade execution and learning"""
    trainer = AdaptiveTradingTrainer()
    
    logger.info("🚀 Starting adaptive trading parameter training simulation")
    
    # Simulate several trades with different outcomes
    simulated_trades = [
        {
            'symbol': 'NEAR',
            'action': 'BUY',
            'position_size': 3898.0,
            'entry_price': 5.2,
            'expected_profit': 811.0,
            'actual_profit': 845.0,  # Better than expected
            'gas_fees': 2.1,
            'market_conditions': {'volatility': 0.6, 'volume': 0.8, 'momentum': 0.9, 'trend_strength': 0.85}
        },
        {
            'symbol': 'MNGO',
            'action': 'BUY',
            'position_size': 3856.0,
            'entry_price': 0.045,
            'expected_profit': 713.0,
            'actual_profit': 689.0,  # Slightly worse
            'gas_fees': 2.3,
            'market_conditions': {'volatility': 0.7, 'volume': 0.6, 'momentum': 0.7, 'trend_strength': 0.75}
        },
        {
            'symbol': 'RAY',
            'action': 'BUY',
            'position_size': 3813.0,
            'entry_price': 2.8,
            'expected_profit': 412.0,
            'actual_profit': 456.0,  # Better than expected
            'gas_fees': 1.9,
            'market_conditions': {'volatility': 0.5, 'volume': 0.9, 'momentum': 0.8, 'trend_strength': 0.8}
        },
        {
            'symbol': 'ILV',
            'action': 'BUY',
            'position_size': 3732.0,
            'entry_price': 52.0,
            'expected_profit': 500.0,
            'actual_profit': 234.0,  # Much worse than expected
            'gas_fees': 2.8,
            'market_conditions': {'volatility': 0.9, 'volume': 0.4, 'momentum': 0.3, 'trend_strength': 0.4}
        },
        {
            'symbol': 'COPE',
            'action': 'BUY',
            'position_size': 3723.0,
            'entry_price': 0.85,
            'expected_profit': 197.0,
            'actual_profit': -45.0,  # Lost money
            'gas_fees': 3.2,
            'market_conditions': {'volatility': 0.8, 'volume': 0.3, 'momentum': 0.2, 'trend_strength': 0.3}
        }
    ]
    
    # Process each simulated trade
    for i, trade_data in enumerate(simulated_trades):
        logger.info(f"\n📊 Processing trade {i+1}/5: {trade_data['symbol']}")
        
        trade = TradeExecution(
            timestamp=datetime.now().isoformat(),
            symbol=trade_data['symbol'],
            action=trade_data['action'],
            position_size=trade_data['position_size'],
            entry_price=trade_data['entry_price'],
            exit_price=trade_data['entry_price'] * 1.1,  # Simulated exit
            expected_profit=trade_data['expected_profit'],
            actual_profit=trade_data['actual_profit'],
            gas_fees=trade_data['gas_fees'],
            execution_time=0.5,
            market_conditions=trade_data['market_conditions'],
            success_score=0.0  # Will be calculated
        )
        
        trainer.record_trade_execution(trade)
        
        # Show parameter optimization after each trade
        if i >= 2:  # Start optimizing after 3 trades
            logger.info("\n⚙️ Current optimized parameters:")
            for param, value in asdict(trainer.current_parameters).items():
                logger.info(f"   {param}: {value}")
        
        await asyncio.sleep(1)  # Simulate time between trades
    
    # Test prediction system
    logger.info("\n🔮 Testing trade outcome prediction:")
    
    test_prediction = trainer.predict_trade_outcome(
        symbol='TEST',
        position_size=5000.0,
        expected_profit=600.0,
        gas_fees=3.0,
        market_conditions={'volatility': 0.6, 'volume': 0.7, 'momentum': 0.8, 'trend_strength': 0.75}
    )
    
    logger.info(f"   Predicted profit: ${test_prediction['predicted_profit']:.2f}")
    logger.info(f"   Predicted risk: {test_prediction['predicted_risk']:.2%}")
    logger.info(f"   Optimal scaling: {test_prediction['optimal_scaling']:.2f}")
    logger.info(f"   Confidence: {test_prediction['confidence']:.2%}")
    
    # Test position size optimization
    optimized_size = trainer.get_optimized_position_size(
        base_position_size=4000.0,
        symbol='TEST',
        expected_profit=500.0,
        market_conditions={'volatility': 0.6, 'volume': 0.7, 'momentum': 0.8, 'trend_strength': 0.75}
    )
    
    # Generate analysis report
    analysis = trainer.analyze_parameter_effectiveness()
    
    # Save comprehensive report
    report = {
        'timestamp': datetime.now().isoformat(),
        'training_summary': {
            'total_trades_processed': len(trainer.trade_history),
            'current_parameters': asdict(trainer.current_parameters),
            'performance_metrics': trainer.performance_metrics,
            'model_predictions': test_prediction,
            'position_optimization_demo': {
                'base_size': 4000.0,
                'optimized_size': optimized_size,
                'improvement_factor': optimized_size / 4000.0
            }
        },
        'parameter_analysis': analysis,
        'learning_effectiveness': {
            'models_trained': hasattr(trainer.profit_predictor, 'feature_importances_'),
            'parameter_adjustments_made': trainer.performance_metrics['parameter_adjustments'],
            'win_rate_improvement': trainer.performance_metrics['win_rate']
        }
    }
    
    with open('adaptive_training_report.json', 'w') as f:
        json.dump(report, f, indent=2)
    
    logger.info("\n🎯 ADAPTIVE TRAINING COMPLETED")
    logger.info("=" * 60)
    logger.info(f"📊 Total trades processed: {len(trainer.trade_history)}")
    logger.info(f"🎯 Current win rate: {trainer.performance_metrics['win_rate']:.1%}")
    logger.info(f"💰 Average profit per trade: ${trainer.performance_metrics['average_profit_per_trade']:.2f}")
    logger.info(f"⚙️ Parameter adjustments made: {trainer.performance_metrics['parameter_adjustments']}")
    logger.info(f"🧠 Learning iterations: {trainer.performance_metrics['learning_iterations']}")
    logger.info(f"📝 Report saved to: adaptive_training_report.json")
    
    return trainer

