APP_NAME=VictoryChain Impact Token API
APP_ENV=dev
SOVEREIGN_MODE=true
ENABLE_EXTERNAL_STRIPE_WEBHOOKS=false
ENABLE_EXTERNAL_WALLETCONNECT=false
ENFORCE_INTERNAL_ENDPOINTS_IN_SOVEREIGN_MODE=true
DATABASE_URL=postgresql+psycopg2://victory:victory@db:5432/victory_impact
TREASURY_WIDOW_WALLET=WIDOW_TREASURY_PLACEHOLDER
TREASURY_ELDER_WALLET=ELDER_TREASURY_PLACEHOLDER
TREASURY_ORPHAN_WALLET=ORPHAN_TREASURY_PLACEHOLDER
TREASURY_MERCY_WALLET=MERCY_TREASURY_PLACEHOLDER
TREASURY_EARTH_WALLET=EARTH_TREASURY_PLACEHOLDER
LEGAL_REVIEW_TAX_RECEIPTS_ENABLED=false
DONATION_LARGE_AMOUNT_USD_THRESHOLD=10000
STRIPE_WEBHOOK_SECRET=set-me
VUSD_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
EVM_RPC_URL=http://localhost:8545
EVM_REQUIRED_CONFIRMATIONS=1
INHOUSE_PAYMENT_GATEWAY_BASE_URL=https://payments.local
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_INTERVAL_SECONDS=300
WEBHOOK_RETRY_MAX_DELAY_SECONDS=21600
WEBHOOK_RETRY_JITTER_RATIO=0.2
AUDIT_PROOF_SECRET=set-me-audit-proof-secret
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLE_DEMO_SEED_DATA=true
