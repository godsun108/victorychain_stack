@dataclass
class AggressiveConfig:
    """Ultra-aggressive trading configuration"""
    max_leverage: float = 3.0  # Maximum 3x leverage for amplified returns
    momentum_threshold: float = 0.02  # 2% momentum for entry
    volatility_target: float = 0.15  # Target 15% daily volatility
    confidence_multiplier: float = 2.0  # Scale positions by AI confidence
    rapid_entry_threshold: float = 0.01  # 1% for rapid entries
    news_sentiment_weight: float = 0.3  # 30% weight on news sentiment
    arbitrage_spread_min: float = 0.005  # 0.5% minimum arbitrage spread
    max_daily_trades: int = 50  # Up to 50 trades per day
    ai_confidence_threshold: float = 0.75  # 75% AI confidence required

class UltraAggressiveLiveTrader:
    """
    Ultra-Aggressive Live Trading System
    
    ⚠️  EXTREME RISK: Designed for maximum ROI with high risk tolerance
    🎯 Goal: Maximize daily returns toward $1T target
    """
    
    def __init__(self):
        self.config = AggressiveConfig()
        self.binance_client = None
        self.portfolio_value = 100000.0  # Starting $100k
        self.target_value = 1000000000000.0  # $1T target
        
        # Aggressive strategy components
        self.momentum_scanner = MomentumScanner()
        self.volatility_exploiter = VolatilityExploiter()
        self.news_sentiment_analyzer = NewsSentimentAnalyzer()
        self.arbitrage_detector = ArbitrageDetector()
        self.ai_confidence_engine = AIConfidenceEngine()
        
        # Performance tracking
        self.trades_today = 0
        self.daily_roi = 0.0
        self.total_roi = 0.0
        self.win_rate = 0.0
        self.avg_roi_per_trade = 0.0
        
        # Risk management (even in aggressive mode)
        self.daily_loss_limit = 5000.0  # $5k max daily loss
        self.total_stop_loss = 15000.0  # $15k total stop loss
        self.position_limit = 8  # Max 8 concurrent positions
        
        logger.warning("🚨 ULTRA-AGGRESSIVE LIVE TRADER INITIALIZED")
        logger.warning("🎯 TARGET: $1 TRILLION")
        logger.warning("⚠️  HIGH RISK - REAL MONEY TRADING")
    
    def initialize_binance_connection(self) -> bool:
        """Initialize connection to Binance with trading permissions"""
        try:
            api_key = os.getenv('BINANCEUS_KEY')
            api_secret = os.getenv('BINANCE_API_SECRET')
            
            if not api_key or not api_secret:
                logger.error("❌ Binance API credentials not found!")
                return False
            
            self.binance_client = ccxt.binance({
                'apiKey': api_key,
                'secret': api_secret,
                'sandbox': False,  # LIVE TRADING - NOT SANDBOX
                'enableRateLimit': True,
                'options': {
                    'defaultType': 'spot',  # Spot trading for maximum safety
                }
            })
            
            # Test connection
            balance = self.binance_client.fetch_balance()
            logger.info(f"✅ Binance connection established")
            logger.info(f"💰 Available balance: ${balance['USDT']['free']:.2f}")
            
            return True
            
        except Exception as e:
            logger.error(f"❌ Failed to connect to Binance: {e}")
            return False
    
    async def ultra_aggressive_trading_loop(self):
        """Main ultra-aggressive trading loop - Maximum ROI focus"""
        logger.warning("🚀 STARTING ULTRA-AGGRESSIVE LIVE TRADING")
        logger.warning("🎯 GOAL: MAXIMIZE DAILY ROI AND ROI PER TRADE")
        
        while True:
            try:
                # Reset daily metrics
                if self.should_reset_daily_metrics():
                    self.reset_daily_metrics()
                
                # Check safety limits first
                if not self.check_safety_limits():
                    logger.error("🛑 SAFETY LIMITS BREACHED - STOPPING TRADING")
                    break
                
                # 1. MOMENTUM SCANNING - Find rapid price movements
                momentum_opportunities = await self.momentum_scanner.scan_momentum_opportunities()
                
                # 2. VOLATILITY EXPLOITATION - Profit from high volatility
                volatility_trades = await self.volatility_exploiter.find_volatility_trades()
                
                # 3. NEWS SENTIMENT TRADING - React to news events
                sentiment_signals = await self.news_sentiment_analyzer.get_sentiment_signals()
                
                # 4. ARBITRAGE DETECTION - Cross-exchange opportunities
                arbitrage_opportunities = await self.arbitrage_detector.find_arbitrage()
                
                # 5. AI CONFIDENCE ANALYSIS - High-confidence trades only
                all_opportunities = momentum_opportunities + volatility_trades + sentiment_signals + arbitrage_opportunities
                high_confidence_trades = await self.ai_confidence_engine.filter_high_confidence(all_opportunities)
                
                # 6. EXECUTE ULTRA-AGGRESSIVE TRADES
                for trade in high_confidence_trades:
                    if self.trades_today < self.config.max_daily_trades:
                        await self.execute_aggressive_trade(trade)
                
                # 7. MANAGE EXISTING POSITIONS AGGRESSIVELY
                await self.manage_aggressive_positions()
                
                # 8. UPDATE PERFORMANCE METRICS
                self.update_performance_metrics()
                
                # 9. LOG AGGRESSIVE PROGRESS
                self.log_aggressive_progress()
                
                # High-frequency loop - check every 5 seconds for opportunities
                await asyncio.sleep(5)
                
            except Exception as e:
                logger.error(f"❌ Error in aggressive trading loop: {e}")
                await asyncio.sleep(10)
    
    async def execute_aggressive_trade(self, trade: Dict):
        """Execute trade with aggressive position sizing and leverage"""
        try:
            symbol = trade['symbol']
            side = trade['side']
            confidence = trade['confidence']
            expected_roi = trade['expected_roi']
            
            # AGGRESSIVE POSITION SIZING
            base_position_size = min(
                self.portfolio_value * 0.15,  # Up to 15% of portfolio per trade
                trade['max_safe_size']
            )
            
            # Scale by AI confidence (higher confidence = larger position)
            position_size = base_position_size * (confidence * self.config.confidence_multiplier)
            
            # Apply leverage for amplified returns (where safe)
            if trade['leverage_safe'] and confidence > 0.85:
                effective_position_size = position_size * min(self.config.max_leverage, trade['max_leverage'])
            else:
                effective_position_size = position_size
            
            # Execute the trade
            if side == 'buy':
                order = self.binance_client.create_market_buy_order(symbol, effective_position_size / trade['price'])
            else:
                order = self.binance_client.create_market_sell_order(symbol, effective_position_size / trade['price'])
            
            # Set aggressive profit targets and stop losses
            profit_target = trade['price'] * (1 + expected_roi * 1.5)  # 1.5x expected ROI
            stop_loss = trade['price'] * (1 - expected_roi * 0.5)  # Tight stop loss
            
            logger.info(f"🚀 AGGRESSIVE TRADE EXECUTED:")
            logger.info(f"   Symbol: {symbol}")
            logger.info(f"   Side: {side}")
            logger.info(f"   Size: ${effective_position_size:.2f}")
            logger.info(f"   Confidence: {confidence:.2%}")
            logger.info(f"   Expected ROI: {expected_roi:.2%}")
            logger.info(f"   Profit Target: ${profit_target:.4f}")
            
            self.trades_today += 1
            
            # Track the position for aggressive management
            self.track_aggressive_position(order, trade, profit_target, stop_loss)
            
        except Exception as e:
            logger.error(f"❌ Failed to execute aggressive trade: {e}")
    
    def check_safety_limits(self) -> bool:
        """Check if we've hit any safety limits (even in aggressive mode)"""
        # Daily loss limit
        daily_loss = self.calculate_daily_pnl()
        if daily_loss < -self.daily_loss_limit:
            logger.error(f"🛑 DAILY LOSS LIMIT HIT: ${daily_loss:.2f}")
            return False
        
        # Total portfolio stop loss
        total_loss = self.portfolio_value - 100000.0  # Starting value
        if total_loss < -self.total_stop_loss:
            logger.error(f"🛑 TOTAL STOP LOSS HIT: ${total_loss:.2f}")
            return False
        
        return True
    
    def update_performance_metrics(self):
        """Update aggressive performance tracking"""
        current_value = self.get_current_portfolio_value()
        
        # Daily ROI
        daily_start_value = self.get_daily_start_value()
        self.daily_roi = (current_value - daily_start_value) / daily_start_value
        
        # Total ROI
        self.total_roi = (current_value - 100000.0) / 100000.0
        
        # ROI per trade
        if self.trades_today > 0:
            daily_profit = current_value - daily_start_value
            self.avg_roi_per_trade = daily_profit / self.trades_today / current_value
        
        # Update portfolio value
        self.portfolio_value = current_value
    
    def log_aggressive_progress(self):
        """Log ultra-aggressive trading progress"""
        progress_to_target = (self.portfolio_value / self.target_value) * 100
        
        logger.info("=" * 80)
        logger.info("🚀 ULTRA-AGGRESSIVE TRADING STATUS")
        logger.info("=" * 80)
        logger.info(f"💰 Portfolio Value: ${self.portfolio_value:,.2f}")
        logger.info(f"🎯 Target Value: ${self.target_value:,.2f}")
        logger.info(f"📈 Progress to $1T: {progress_to_target:.8f}%")
        logger.info(f"📊 Daily ROI: {self.daily_roi:.4%}")
        logger.info(f"📊 Total ROI: {self.total_roi:.4%}")
        logger.info(f"📊 ROI per Trade: {self.avg_roi_per_trade:.4%}")
        logger.info(f"🔥 Trades Today: {self.trades_today}")
        logger.info(f"🎲 Win Rate: {self.win_rate:.2%}")
        
        if self.daily_roi > 0:
            days_to_target = np.log(self.target_value / self.portfolio_value) / np.log(1 + self.daily_roi)
            logger.info(f"⏱️  Days to $1T at current rate: {days_to_target:.0f}")
        
        logger.info("=" * 80)


