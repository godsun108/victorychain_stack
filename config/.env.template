# Binance US API Keys (REQUIRED)
BINANCEUS_API_KEY=your_binance_us_api_key_here
BINANCEUS_API_SECRET=your_binance_us_secret_key_here

# AI API Keys (OPTIONAL - for AI-enhanced trading)
# Get Claude API key from: https://console.anthropic.com/
CLAUDE_API_KEY=your_claude_api_key_here

# Get HuggingFace API key from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Governance approval gate
# Secret used to sign approval tokens (HMAC-SHA256). Keep private.
APPROVAL_SECRET=change_me_use_secure_random
# Execution mode: defaults to 'paper'. Set MODE=live only with a valid approval token.
MODE=paper
# Optional: approval token for live mode (base64url of action|expiry|params_json|signature)
APPROVAL_TOKEN=

# Trading Configuration
RUST_LOG=info  # Set to 'debug' for more detailed logs
