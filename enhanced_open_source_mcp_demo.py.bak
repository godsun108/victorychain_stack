            print(f"   Strategy Uptime: {performance_data['strategy_uptime']:.1%}")
            
            # MCP Performance
            async with EnhancedMCPClient() as client:
                print("\n⚡ MCP Performance Test...")
                
                # Measure response times
                start_time = datetime.now()
