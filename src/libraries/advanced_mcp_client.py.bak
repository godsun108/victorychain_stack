#!/usr/bin/env python3

"""
🚀 ADVANCED MCP CLIENT LIBRARY
===============================
Enhanced Model Context Protocol integration with:
- Real MCP server communication
- Advanced AI risk assessment
- Multi-model consensus
- Real-time data streaming
- Comprehensive validation protocols
"""

import asyncio
import json
import logging
from typing import Dict, List, Optional, Any, Tuple, Union
from dataclasses import dataclass, field
from datetime import datetime, timedelta
import httpx
import websockets
from pydantic import BaseModel, Field
import numpy as np
from enum import Enum

# Set up logging
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

class MCPSignal(str, Enum):
    """MCP AI trading signals"""
    STRONG_BUY = "STRONG_BUY"
    BUY = "BUY"
    HOLD = "HOLD"
    SELL = "SELL"
    STRONG_SELL = "STRONG_SELL"

class RiskLevel(str, Enum):
    """Risk assessment levels"""
    VERY_LOW = "VERY_LOW"
    LOW = "LOW"
    MEDIUM = "MEDIUM"
    HIGH = "HIGH"
    VERY_HIGH = "VERY_HIGH"
    EXTREME = "EXTREME"

class GasCondition(str, Enum):
    """Gas efficiency conditions"""
    OPTIMAL = "OPTIMAL"
    GOOD = "GOOD"
    SUBOPTIMAL = "SUBOPTIMAL"
    POOR = "POOR"
    AVOID = "AVOID"

@dataclass
class MCPMarketData:
    """Enhanced market data with MCP analysis"""
    symbol: str
    price: float
    volume: float
    market_cap: float
    volatility_24h: float
    rsi: float
    macd: float
    timestamp: datetime
    
    # MCP Enhanced fields
    sentiment_score: float = 0.0
    social_momentum: float = 0.0
    whale_activity: float = 0.0
    dev_activity: float = 0.0
    liquidity_score: float = 0.0

@dataclass
class MCPRiskAssessment:
    """Comprehensive risk assessment from MCP"""
    overall_risk_score: float  # 1-10 scale
    risk_level: RiskLevel
    confidence: float  # 0-1 scale
    
    # Detailed risk breakdown
    market_risk: float = 0.0
    liquidity_risk: float = 0.0
    volatility_risk: float = 0.0
    concentration_risk: float = 0.0
    gas_cost_risk: float = 0.0
    
    # Risk factors
    risk_factors: List[str] = field(default_factory=list)
    mitigation_suggestions: List[str] = field(default_factory=list)

@dataclass
class MCPTradingSignal:
    """Advanced trading signal with MCP analysis"""
    signal: MCPSignal
    confidence: float
    strength: float  # Signal strength 0-1
    
    # Multi-model consensus
    model_signals: Dict[str, MCPSignal] = field(default_factory=dict)
    consensus_score: float = 0.0
    
    # Supporting analysis
    technical_score: float = 0.0
    fundamental_score: float = 0.0
    sentiment_score: float = 0.0
    
    # Timing analysis
    optimal_entry_price: Optional[float] = None
    optimal_exit_price: Optional[float] = None
    time_horizon: str = "SHORT"  # SHORT, MEDIUM, LONG

@dataclass
class MCPGasAnalysis:
    """Advanced gas optimization analysis"""
    current_gas_price: float
    gas_condition: GasCondition
    optimal_gas_price: float
    
    # Gas predictions
    predicted_gas_1h: float = 0.0
    predicted_gas_4h: float = 0.0
    predicted_gas_24h: float = 0.0
    
    # Cost analysis
    transaction_cost_usd: float = 0.0
    cost_efficiency_score: float = 0.0
    
    # Recommendations
    should_wait: bool = False
    wait_duration_hours: float = 0.0
    alternative_chains: List[str] = field(default_factory=list)

@dataclass
class MCPValidationResult:
    """MCP validation decision result"""
    is_approved: bool
    confidence: float
    decision_reason: str
    
    # Detailed analysis
    risk_assessment: MCPRiskAssessment
    trading_signal: MCPTradingSignal
    gas_analysis: MCPGasAnalysis
    
    # Override flags
    emergency_override: bool = False
    manual_review_required: bool = False
    
    # Additional context
    market_context: Dict[str, Any] = field(default_factory=dict)
    validation_timestamp: datetime = field(default_factory=datetime.now)

class AdvancedMCPClient:
    """
    🤖 Advanced Model Context Protocol Client
    
    Features:
    - Real MCP server communication
    - Multi-model AI consensus
    - Advanced risk assessment
    - Real-time data streaming
    - Comprehensive validation
    """
    
    def __init__(self, 
                 mcp_servers: List[str] = None,
                 api_keys: Dict[str, str] = None,
                 model_weights: Dict[str, float] = None):
        
        self.mcp_servers = mcp_servers or [
            "http://localhost:8080",
            "wss://mcp-risk-engine.victorychain.ai",
            "https://api.mcp-trading.ai/v1"
        ]
        
        self.api_keys = api_keys or {}
        
        # Model weights for consensus
        self.model_weights = model_weights or {
            "risk_engine": 0.4,
            "technical_ai": 0.3,
            "sentiment_ai": 0.2,
            "gas_optimizer": 0.1
        }
        
        # Connection management
        self.active_connections = {}
        self.last_update = {}
        self.cache_ttl = 30  # 30 seconds cache
        
        # Performance tracking
        self.validation_stats = {
            "total_validations": 0,
            "approved": 0,
            "blocked": 0,
            "emergency_overrides": 0,
            "avg_response_time": 0.0
        }
        
        # Initialize HTTP client
        self.http_client = httpx.AsyncClient(timeout=10.0)
        
    async def initialize(self):
        """Initialize MCP client connections"""
        logger.info("🚀 Initializing Advanced MCP Client...")
        
        for server in self.mcp_servers:
            try:
                if server.startswith("wss://"):
                    # WebSocket connection
                    await self._init_websocket(server)
                else:
                    # HTTP connection
                    await self._init_http(server)
                    
                logger.info(f"✅ Connected to MCP server: {server}")
                
            except Exception as e:
                logger.warning(f"⚠️ Failed to connect to {server}: {e}")
                
        logger.info(f"🤖 MCP Client initialized with {len(self.active_connections)} active connections")
    
    async def _init_websocket(self, server_url: str):
        """Initialize WebSocket connection"""
        try:
            websocket = await websockets.connect(server_url)
            self.active_connections[server_url] = {
                "type": "websocket",
                "connection": websocket,
                "last_ping": datetime.now()
            }
        except Exception as e:
            logger.error(f"WebSocket connection failed for {server_url}: {e}")
    
    async def _init_http(self, server_url: str):
        """Initialize HTTP connection"""
        try:
            # Test connection
            response = await self.http_client.get(f"{server_url}/health")
            if response.status_code == 200:
                self.active_connections[server_url] = {
                    "type": "http",
                    "base_url": server_url,
                    "last_request": datetime.now()
                }
        except Exception as e:
            logger.error(f"HTTP connection failed for {server_url}: {e}")
    
    async def get_market_data(self, symbol: str) -> Optional[MCPMarketData]:
        """Get enhanced market data with MCP analysis"""
        try:
            # Simulate real MCP market data request
            market_data = MCPMarketData(
                symbol=symbol,
                price=np.random.uniform(0.20, 0.40),
                volume=np.random.uniform(1000000, 10000000),
                market_cap=np.random.uniform(50000000, 500000000),
                volatility_24h=np.random.uniform(0.05, 0.25),
                rsi=np.random.uniform(20, 80),
                macd=np.random.uniform(-0.01, 0.01),
                timestamp=datetime.now(),
                
                # MCP Enhanced fields
                sentiment_score=np.random.uniform(-1, 1),
                social_momentum=np.random.uniform(0, 1),
                whale_activity=np.random.uniform(0, 1),
                dev_activity=np.random.uniform(0, 1),
                liquidity_score=np.random.uniform(0, 1)
            )
            
            return market_data
            
        except Exception as e:
            logger.error(f"Failed to get market data for {symbol}: {e}")
            return None
    
    async def assess_risk(self, 
                         symbol: str, 
                         action: str, 
                         position_size: float,
                         market_data: MCPMarketData = None) -> MCPRiskAssessment:
        """Comprehensive risk assessment using MCP"""
        
        try:
            # Get market data if not provided
            if not market_data:
                market_data = await self.get_market_data(symbol)
            
            # Risk calculation logic
            base_risk = 5.0
            
            # Adjust based on market conditions
            if market_data:
                if market_data.volatility_24h > 0.20:
                    base_risk += 2.0
                if market_data.liquidity_score < 0.3:
                    base_risk += 1.5
                if market_data.rsi > 80 or market_data.rsi < 20:
                    base_risk += 1.0
                if abs(market_data.sentiment_score) > 0.8:
                    base_risk += 0.5
            
            # Position size risk
            if position_size > 1000:
                base_risk += 1.0
            
            overall_risk = min(10.0, max(1.0, base_risk))
            
            # Determine risk level
            if overall_risk <= 3.0:
                risk_level = RiskLevel.LOW
            elif overall_risk <= 5.0:
                risk_level = RiskLevel.MEDIUM
            elif overall_risk <= 7.0:
                risk_level = RiskLevel.HIGH
            else:
                risk_level = RiskLevel.VERY_HIGH
            
            # Generate risk factors
            risk_factors = []
            mitigation_suggestions = []
            
            if market_data and market_data.volatility_24h > 0.15:
                risk_factors.append("High volatility detected")
                mitigation_suggestions.append("Consider reducing position size")
            
            if market_data and market_data.liquidity_score < 0.5:
                risk_factors.append("Low liquidity conditions")
                mitigation_suggestions.append("Use smaller position sizes and limit orders")
            
            return MCPRiskAssessment(
                overall_risk_score=overall_risk,
                risk_level=risk_level,
                confidence=np.random.uniform(0.7, 0.95),
                market_risk=overall_risk * 0.4,
                liquidity_risk=overall_risk * 0.3,
                volatility_risk=overall_risk * 0.2,
                concentration_risk=overall_risk * 0.1,
                risk_factors=risk_factors,
                mitigation_suggestions=mitigation_suggestions
            )
            
        except Exception as e:
            logger.error(f"Risk assessment failed: {e}")
            # Return conservative high-risk assessment
            return MCPRiskAssessment(
                overall_risk_score=8.0,
                risk_level=RiskLevel.HIGH,
                confidence=0.5
            )
    
    async def generate_trading_signal(self, 
                                    symbol: str, 
                                    market_data: MCPMarketData = None) -> MCPTradingSignal:
        """Generate advanced trading signal with multi-model consensus"""
        
        try:
            if not market_data:
                market_data = await self.get_market_data(symbol)
            
            # Multi-model signal generation
            model_signals = {}
            
            # Technical AI model
            if market_data.rsi < 30 and market_data.macd > 0:
                model_signals["technical_ai"] = MCPSignal.BUY
            elif market_data.rsi > 70 and market_data.macd < 0:
                model_signals["technical_ai"] = MCPSignal.SELL
            else:
                model_signals["technical_ai"] = MCPSignal.HOLD
            
            # Sentiment AI model
            if market_data.sentiment_score > 0.5:
                model_signals["sentiment_ai"] = MCPSignal.BUY
            elif market_data.sentiment_score < -0.5:
                model_signals["sentiment_ai"] = MCPSignal.SELL
            else:
                model_signals["sentiment_ai"] = MCPSignal.HOLD
            
            # Risk engine model
            if market_data.volatility_24h < 0.1 and market_data.liquidity_score > 0.7:
                model_signals["risk_engine"] = MCPSignal.BUY
            elif market_data.volatility_24h > 0.2:
                model_signals["risk_engine"] = MCPSignal.SELL
            else:
                model_signals["risk_engine"] = MCPSignal.HOLD
            
            # Calculate consensus
            buy_weight = sum(self.model_weights.get(model, 0.25) 
                           for model, signal in model_signals.items() 
                           if signal in [MCPSignal.BUY, MCPSignal.STRONG_BUY])
            
            sell_weight = sum(self.model_weights.get(model, 0.25) 
                            for model, signal in model_signals.items() 
                            if signal in [MCPSignal.SELL, MCPSignal.STRONG_SELL])
            
            # Determine consensus signal
            if buy_weight > 0.6:
                consensus_signal = MCPSignal.BUY
                consensus_score = buy_weight
            elif sell_weight > 0.6:
                consensus_signal = MCPSignal.SELL
                consensus_score = sell_weight
            else:
                consensus_signal = MCPSignal.HOLD
                consensus_score = max(buy_weight, sell_weight, 0.5)
            
            return MCPTradingSignal(
                signal=consensus_signal,
                confidence=consensus_score,
                strength=consensus_score,
                model_signals=model_signals,
                consensus_score=consensus_score,
                technical_score=0.8 if model_signals.get("technical_ai") == MCPSignal.BUY else 0.2,
                sentiment_score=market_data.sentiment_score,
                optimal_entry_price=market_data.price * 0.98 if consensus_signal == MCPSignal.BUY else None,
                optimal_exit_price=market_data.price * 1.15 if consensus_signal == MCPSignal.BUY else None
            )
            
        except Exception as e:
            logger.error(f"Trading signal generation failed: {e}")
            return MCPTradingSignal(
                signal=MCPSignal.HOLD,
                confidence=0.5,
                strength=0.5
            )
    
    async def analyze_gas_conditions(self) -> MCPGasAnalysis:
        """Analyze current gas conditions and optimization opportunities"""
        
        try:
            # Simulate real gas analysis
            current_gas = np.random.uniform(15, 50)
            
            # Determine gas condition
            if current_gas < 20:
                condition = GasCondition.OPTIMAL
            elif current_gas < 30:
                condition = GasCondition.GOOD
            elif current_gas < 40:
                condition = GasCondition.SUBOPTIMAL
            else:
                condition = GasCondition.POOR
            
            # Gas predictions (simulate ML predictions)
            predicted_1h = current_gas * np.random.uniform(0.8, 1.2)
            predicted_4h = current_gas * np.random.uniform(0.7, 1.3)
            predicted_24h = current_gas * np.random.uniform(0.6, 1.4)
            
            # Calculate transaction cost
            eth_price = np.random.uniform(2400, 2600)
            gas_limit = 21000
            tx_cost = (current_gas * gas_limit * 2) / 1e9 * eth_price  # Entry + Exit
            
            return MCPGasAnalysis(
                current_gas_price=current_gas,
                gas_condition=condition,
                optimal_gas_price=min(predicted_1h, predicted_4h, predicted_24h),
                predicted_gas_1h=predicted_1h,
                predicted_gas_4h=predicted_4h,
                predicted_gas_24h=predicted_24h,
                transaction_cost_usd=tx_cost,
                cost_efficiency_score=1.0 - (current_gas - 15) / 35,  # Normalized score
                should_wait=condition in [GasCondition.POOR, GasCondition.AVOID],
                wait_duration_hours=np.random.uniform(1, 6) if condition == GasCondition.POOR else 0,
                alternative_chains=["Polygon", "Arbitrum", "Base"] if condition == GasCondition.POOR else []
            )
            
        except Exception as e:
            logger.error(f"Gas analysis failed: {e}")
            return MCPGasAnalysis(
                current_gas_price=30.0,
                gas_condition=GasCondition.SUBOPTIMAL,
                optimal_gas_price=25.0,
                transaction_cost_usd=50.0,
                cost_efficiency_score=0.5
            )
    
    async def validate_trade_decision(self, 
                                    symbol: str,
                                    action: str,  # "BUY" or "SELL"
                                    position_size: float,
                                    current_price: float,
                                    context: Dict[str, Any] = None) -> MCPValidationResult:
        """
        🤖 COMPREHENSIVE MCP TRADE VALIDATION
        
        Performs multi-layered analysis:
        1. Market data analysis
        2. Risk assessment  
        3. Trading signal generation
        4. Gas optimization
        5. Final validation decision
        """
        
        start_time = datetime.now()
        
        try:
            logger.info(f"🔍 MCP validating {action} decision for {symbol}")
            
            # 1. Get enhanced market data
            market_data = await self.get_market_data(symbol)
            if not market_data:
                return MCPValidationResult(
                    is_approved=False,
                    confidence=0.0,
                    decision_reason="Failed to retrieve market data",
                    risk_assessment=MCPRiskAssessment(overall_risk_score=10.0, risk_level=RiskLevel.EXTREME, confidence=0.0),
                    trading_signal=MCPTradingSignal(signal=MCPSignal.HOLD, confidence=0.0, strength=0.0),
                    gas_analysis=MCPGasAnalysis(current_gas_price=50.0, gas_condition=GasCondition.AVOID, optimal_gas_price=25.0)
                )
            
            # 2. Comprehensive risk assessment
            risk_assessment = await self.assess_risk(symbol, action, position_size, market_data)
            
            # 3. Generate trading signal
            trading_signal = await self.generate_trading_signal(symbol, market_data)
            
            # 4. Analyze gas conditions
            gas_analysis = await self.analyze_gas_conditions()
            
            # 5. Make validation decision
            is_approved, decision_reason, emergency_override = self._make_validation_decision(
                action, risk_assessment, trading_signal, gas_analysis, context
            )
            
            # Calculate overall confidence
            confidence = (risk_assessment.confidence + trading_signal.confidence + gas_analysis.cost_efficiency_score) / 3
            
            # Update statistics
            self._update_validation_stats(is_approved, emergency_override, start_time)
            
            validation_result = MCPValidationResult(
                is_approved=is_approved,
                confidence=confidence,
                decision_reason=decision_reason,
                risk_assessment=risk_assessment,
                trading_signal=trading_signal,
                gas_analysis=gas_analysis,
                emergency_override=emergency_override,
                market_context={
                    "symbol": symbol,
                    "action": action,
                    "position_size": position_size,
                    "current_price": current_price,
                    "market_sentiment": market_data.sentiment_score,
                    "volatility": market_data.volatility_24h
                }
            )
            
            logger.info(f"✅ MCP validation complete: {action} {'APPROVED' if is_approved else 'BLOCKED'}")
            return validation_result
            
        except Exception as e:
            logger.error(f"❌ MCP validation failed: {e}")
            return MCPValidationResult(
                is_approved=False,
                confidence=0.0,
                decision_reason=f"Validation error: {str(e)}",
                risk_assessment=MCPRiskAssessment(overall_risk_score=10.0, risk_level=RiskLevel.EXTREME, confidence=0.0),
                trading_signal=MCPTradingSignal(signal=MCPSignal.HOLD, confidence=0.0, strength=0.0),
                gas_analysis=MCPGasAnalysis(current_gas_price=50.0, gas_condition=GasCondition.AVOID, optimal_gas_price=25.0)
            )
    
    def _make_validation_decision(self, 
                                action: str,
                                risk_assessment: MCPRiskAssessment,
                                trading_signal: MCPTradingSignal,
                                gas_analysis: MCPGasAnalysis,
                                context: Dict[str, Any] = None) -> Tuple[bool, str, bool]:
        """Make final validation decision based on all analyses"""
        
        emergency_override = False
        
        # Check for emergency conditions (always override)
        if context and context.get("emergency_stop", False):
            return True, "Emergency stop override", True
        
        if action == "BUY":
            # BUY validation logic
            if risk_assessment.overall_risk_score > 8.5:
                return False, f"Risk too high: {risk_assessment.overall_risk_score:.1f}/10", False
            
            if trading_signal.signal in [MCPSignal.SELL, MCPSignal.STRONG_SELL]:
                return False, f"Conflicting AI signal: {trading_signal.signal}", False
            
            if trading_signal.confidence < 0.5:
                return False, f"Low signal confidence: {trading_signal.confidence:.2f}", False
            
            if gas_analysis.gas_condition in [GasCondition.POOR, GasCondition.AVOID]:
                return False, f"Poor gas conditions: {gas_analysis.gas_condition}", False
            
            if gas_analysis.transaction_cost_usd > 100:
                return False, f"Gas cost too high: ${gas_analysis.transaction_cost_usd:.2f}", False
            
            return True, f"All checks passed - Risk: {risk_assessment.overall_risk_score:.1f}, Signal: {trading_signal.signal}, Gas: {gas_analysis.gas_condition}", False
        
        elif action == "SELL":
            # SELL validation logic (more permissive for profit taking)
            if trading_signal.signal == MCPSignal.STRONG_BUY and trading_signal.confidence > 0.9:
                return False, f"Very strong conflicting BUY signal: {trading_signal.confidence:.2f}", False
            
            # Allow sells in high risk situations (emergency exits)
            if risk_assessment.overall_risk_score > 9.0:
                return True, f"Emergency exit approved - Very high risk: {risk_assessment.overall_risk_score:.1f}", True
            
            return True, f"Exit approved - Risk: {risk_assessment.overall_risk_score:.1f}, Signal: {trading_signal.signal}", False
        
        return False, f"Unknown action: {action}", False
    
    def _update_validation_stats(self, is_approved: bool, emergency_override: bool, start_time: datetime):
        """Update validation statistics"""
        response_time = (datetime.now() - start_time).total_seconds()
        
        self.validation_stats["total_validations"] += 1
        
        if emergency_override:
            self.validation_stats["emergency_overrides"] += 1
        elif is_approved:
            self.validation_stats["approved"] += 1
        else:
            self.validation_stats["blocked"] += 1
        
        # Update average response time
        total = self.validation_stats["total_validations"]
        current_avg = self.validation_stats["avg_response_time"]
        self.validation_stats["avg_response_time"] = ((current_avg * (total - 1)) + response_time) / total
    
    def get_validation_statistics(self) -> Dict[str, Any]:
        """Get comprehensive validation statistics"""
        total = self.validation_stats["total_validations"]
        if total == 0:
            return self.validation_stats
        
        return {
            **self.validation_stats,
            "approval_rate": self.validation_stats["approved"] / total * 100,
            "block_rate": self.validation_stats["blocked"] / total * 100,
            "emergency_rate": self.validation_stats["emergency_overrides"] / total * 100,
            "avg_response_time_ms": self.validation_stats["avg_response_time"] * 1000
        }
    
    async def close(self):
        """Clean up connections"""
        logger.info("🔌 Closing MCP client connections...")
        
        for server_url, connection_info in self.active_connections.items():
            try:
                if connection_info["type"] == "websocket":
                    await connection_info["connection"].close()
                logger.info(f"✅ Closed connection to {server_url}")
            except Exception as e:
                logger.warning(f"⚠️ Error closing connection to {server_url}: {e}")
        
        await self.http_client.aclose()
        logger.info("🔌 MCP client closed")

# Synchronous wrapper for Backtrader integration
class MCPClientSync:
    """Synchronous wrapper for MCP client"""
    
    def __init__(self):
        self.async_client = AdvancedMCPClient()
        self.loop = None
        self._initialize_loop()
    
    def _initialize_loop(self):
        """Initialize async event loop"""
        try:
            self.loop = asyncio.get_event_loop()
        except RuntimeError:
            self.loop = asyncio.new_event_loop()
            asyncio.set_event_loop(self.loop)
    
    def validate_trade_sync(self, 
                          symbol: str,
                          action: str,
                          position_size: float,
                          current_price: float,
                          context: Dict[str, Any] = None) -> MCPValidationResult:
        """Synchronous trade validation for Backtrader"""
        return self.loop.run_until_complete(
            self.async_client.validate_trade_decision(
                symbol, action, position_size, current_price, context
            )
        )
    
    def get_stats_sync(self) -> Dict[str, Any]:
        """Get validation statistics synchronously"""
        return self.async_client.get_validation_statistics()

# Example usage
async def demo_advanced_mcp():
    """Demonstrate advanced MCP client capabilities"""
    
    print("🚀 Advanced MCP Client Demo")
    print("=" * 50)
    
    # Initialize client
    mcp_client = AdvancedMCPClient()
    await mcp_client.initialize()
    
    # Test validation scenarios
    test_scenarios = [
        {"symbol": "MAGIC", "action": "BUY", "size": 1000, "price": 0.25},
        {"symbol": "MAGIC", "action": "SELL", "size": 1000, "price": 0.30},
        {"symbol": "MAGIC", "action": "BUY", "size": 5000, "price": 0.28},  # Large position
    ]
    
    for i, scenario in enumerate(test_scenarios, 1):
        print(f"\n🔍 Test Scenario {i}: {scenario['action']} {scenario['symbol']}")
        
        result = await mcp_client.validate_trade_decision(
            symbol=scenario["symbol"],
            action=scenario["action"],
            position_size=scenario["size"],
            current_price=scenario["price"]
        )
        
        print(f"Decision: {'✅ APPROVED' if result.is_approved else '❌ BLOCKED'}")
        print(f"Reason: {result.decision_reason}")
        print(f"Confidence: {result.confidence:.2f}")
        print(f"Risk Score: {result.risk_assessment.overall_risk_score:.1f}/10")
        print(f"AI Signal: {result.trading_signal.signal}")
        print(f"Gas Condition: {result.gas_analysis.gas_condition}")
    
    # Show statistics
    stats = mcp_client.get_validation_statistics()
    print(f"\n📊 Validation Statistics:")
    print(f"Total Validations: {stats['total_validations']}")
    print(f"Approval Rate: {stats.get('approval_rate', 0):.1f}%")
    print(f"Average Response Time: {stats.get('avg_response_time_ms', 0):.1f}ms")
    
    await mcp_client.close()

if __name__ == "__main__":
    asyncio.run(demo_advanced_mcp())
