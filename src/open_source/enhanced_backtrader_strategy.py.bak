        print("✅ Enhanced Backtrader MCP Strategy demo completed!")
    else:
        print("⚠️  Backtrader not available - running in demo mode")
        strategy = EnhancedVictoryChainMCPStrategy()
        print("✅ Enhanced Backtrader MCP Strategy demo completed!")
