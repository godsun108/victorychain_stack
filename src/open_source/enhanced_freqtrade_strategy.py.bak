#!/usr/bin/env python3

"""
🚀 ENHANCED FREQTRADE MCP STRATEGY
Advanced FreqTrade strategy with real-time MCP integration
Features: AI signals, risk management, dynamic parameters, live updates
"""

import logging
from typing import Dict, List, Optional, Tuple
from freqtrade.strategy import IStrategy, merge_informative_pair
from freqtrade.strategy import DecimalParameter, IntParameter, BooleanParameter, CategoricalParameter
import talib.abstract as ta
import freqtrade.vendor.qtpylib.indicators as qtpylib
import pandas as pd
import numpy as np
import asyncio
import sys
import os
from functools import reduce
from datetime import datetime, timedelta

# Add the project root to Python path
sys.path.append(os.path.dirname(os.path.dirname(os.path.dirname(__file__))))

try:
    from src.open_source.enhanced_mcp_client import EnhancedMCPClient, get_global_mcp_client
except ImportError:
    # Fallback if import fails
    EnhancedMCPClient = None
    get_global_mcp_client = None

logger = logging.getLogger(__name__)

class EnhancedVictoryChainMCPStrategy(IStrategy):
    """
    Enhanced FreqTrade strategy powered by VictoryChain MCP server
    Features:
    - Real-time AI signal integration
    - Dynamic risk management
    - Adaptive parameters based on market conditions
    - Multi-timeframe analysis
    - Advanced portfolio optimization
    """
    
    INTERFACE_VERSION = 3
    
    # Strategy metadata
    timeframe = '5m'  # Primary timeframe
    informative_timeframes = ['1h', '4h', '1d']  # Additional timeframes
    
    # Dynamic ROI table (updated based on market conditions)
    minimal_roi = {
        "0": 0.30,    # 30% initial target
        "15": 0.20,   # 20% after 15 minutes
        "30": 0.15,   # 15% after 30 minutes
        "60": 0.10,   # 10% after 1 hour
        "120": 0.05,  # 5% after 2 hours
        "240": 0.02   # 2% after 4 hours
    }
    
    # Dynamic stoploss (adjusted by AI)
    stoploss = -0.12  # Base 12% stop loss
    
    # Trailing stop
    trailing_stop = True
    trailing_stop_positive = 0.05
    trailing_stop_positive_offset = 0.08
    trailing_only_offset_is_reached = True
    
    # MCP Configuration
    mcp_server_url = "http://localhost:8080"
    
    # === Strategy Parameters ===
    
    # Technical Analysis Parameters
    rsi_period = IntParameter(10, 20, default=14, space="buy")
    rsi_buy_threshold = IntParameter(20, 40, default=30, space="buy")
    rsi_sell_threshold = IntParameter(60, 85, default=75, space="sell")
    
    macd_fast = IntParameter(8, 16, default=12, space="buy")
    macd_slow = IntParameter(20, 30, default=26, space="buy")
    macd_signal = IntParameter(6, 12, default=9, space="buy")
    
    bb_period = IntParameter(15, 25, default=20, space="buy")
    bb_std = DecimalParameter(1.5, 2.5, default=2.0, space="buy")
    
    # Volume Parameters
    volume_factor = DecimalParameter(1.0, 3.0, default=1.5, space="buy")
    
    # MCP AI Parameters\n    ai_signal_weight = DecimalParameter(0.1, 1.0, default=0.7, space="buy")\n    ai_confidence_threshold = DecimalParameter(0.5, 0.9, default=0.65, space="buy")\n    \n    # Risk Management Parameters\n    max_risk_score = DecimalParameter(6.0, 9.0, default=7.5, space="risk")\n    max_concentration = DecimalParameter(0.6, 0.9, default=0.8, space="risk")\n    portfolio_heat = DecimalParameter(0.1, 0.4, default=0.25, space="risk")\n    \n    # Market Condition Parameters\n    volatility_threshold = DecimalParameter(0.02, 0.08, default=0.05, space="buy")\n    trend_strength_min = DecimalParameter(0.3, 0.7, default=0.5, space="buy")\n    \n    # Strategy Mode\n    strategy_mode = CategoricalParameter(\n        ["conservative", "balanced", "aggressive"], \n        default="balanced", \n        space="buy"\n    )\n    \n    # Feature toggles\n    use_ai_signals = BooleanParameter(default=True, space="buy")\n    use_ai_risk_management = BooleanParameter(default=True, space="risk")\n    use_dynamic_parameters = BooleanParameter(default=True, space="buy")\n    use_multi_timeframe = BooleanParameter(default=True, space="buy")\n    \n    def __init__(self, config: dict) -> None:\n        super().__init__(config)\n        \n        # MCP client setup\n        self.mcp_client = None\n        self.mcp_cache = {}\n        self.last_mcp_update = {}\n        self.ai_signals_cache = {}\n        \n        # Performance tracking\n        self.trades_analysis = {}\n        self.market_conditions = {}\n        \n        # Dynamic parameters\n        self.dynamic_params = {}\n        self.last_param_update = 0\n        \n        # Initialize MCP connection\n        self._init_mcp_connection()\n    \n    def _init_mcp_connection(self):\n        """Initialize MCP connection for AI integration"""\n        try:\n            if EnhancedMCPClient:\n                # Use global client for efficiency\n                self.mcp_client = get_global_mcp_client()\n                if self.mcp_client:\n                    # Connect in background\n                    asyncio.create_task(self._ensure_mcp_connection())\n            else:\n                logger.warning("Enhanced MCP client not available - using fallback mode")\n        except Exception as e:\n            logger.error(f"Failed to initialize MCP connection: {e}")\n    \n    async def _ensure_mcp_connection(self):\n        """Ensure MCP connection is established"""\n        try:\n            if not self.mcp_client.connected:\n                await self.mcp_client.connect()\n        except Exception as e:\n            logger.error(f"MCP connection error: {e}")\n    \n    def get_mcp_data_sync(self, method: str, **kwargs) -> Optional[Dict]:\n        """Synchronous wrapper for MCP data retrieval"""\n        try:\n            if self.mcp_client:\n                return self.mcp_client.sync_call(\n                    self._get_mcp_data_async(method, **kwargs)\n                )\n            return None\n        except Exception as e:\n            logger.error(f"MCP sync call failed: {e}")\n            return None\n    \n    async def _get_mcp_data_async(self, method: str, **kwargs) -> Optional[Dict]:\n        """Async MCP data retrieval"""\n        try:\n            if method == "market_analysis":\n                symbol = kwargs.get("symbol", "MAGIC")\n                return await self.mcp_client.get_market_data(symbol)\n                \n            elif method == "trading_signal":\n                return await self.mcp_client.generate_trading_signal(\n                    symbol=kwargs.get("symbol", "MAGIC"),\n                    strategy=kwargs.get("strategy", "momentum"),\n                    risk_tolerance=str(self.strategy_mode.value)\n                )\n                \n            elif method == "risk_metrics":\n                return await self.mcp_client.get_risk_metrics()\n                \n            elif method == "portfolio_optimization":\n                return await self.mcp_client.optimize_portfolio(\n                    target_risk=float(self.portfolio_heat.value),\n                    max_position_size=float(self.max_concentration.value)\n                )\n                \n            return None\n        except Exception as e:\n            logger.error(f"MCP async call failed: {e}")\n            return None\n    \n    def update_dynamic_parameters(self, dataframe: pd.DataFrame):\n        """Update strategy parameters based on market conditions"""\n        if not self.use_dynamic_parameters.value:\n            return\n            \n        current_time = datetime.now().timestamp()\n        if current_time - self.last_param_update < 300:  # Update every 5 minutes\n            return\n            \n        try:\n            # Calculate market volatility\n            returns = dataframe['close'].pct_change().dropna()\n            volatility = returns.std() * np.sqrt(288)  # 5-min to daily\n            \n            # Adjust parameters based on volatility\n            if volatility > self.volatility_threshold.value * 1.5:\n                # High volatility - more conservative\n                self.dynamic_params['rsi_buy'] = min(35, self.rsi_buy_threshold.value + 5)\n                self.dynamic_params['ai_confidence'] = min(0.8, self.ai_confidence_threshold.value + 0.1)\n            elif volatility < self.volatility_threshold.value * 0.5:\n                # Low volatility - more aggressive\n                self.dynamic_params['rsi_buy'] = max(25, self.rsi_buy_threshold.value - 3)\n                self.dynamic_params['ai_confidence'] = max(0.5, self.ai_confidence_threshold.value - 0.05)\n            \n            # Get AI market analysis\n            market_analysis = self.get_mcp_data_sync("market_analysis")\n            if market_analysis:\n                market_trend = market_analysis.get('trend', {}).get('direction', 'neutral')\n                \n                if market_trend == 'bullish':\n                    self.dynamic_params['strategy_bias'] = 'aggressive'\n                elif market_trend == 'bearish':\n                    self.dynamic_params['strategy_bias'] = 'conservative'\n                else:\n                    self.dynamic_params['strategy_bias'] = 'balanced'\n            \n            self.last_param_update = current_time\n            \n        except Exception as e:\n            logger.error(f"Dynamic parameter update failed: {e}")\n    \n    def populate_indicators(self, dataframe: pd.DataFrame, metadata: dict) -> pd.DataFrame:\n        """Add technical indicators and AI-powered features"""\n        \n        # Update dynamic parameters\n        self.update_dynamic_parameters(dataframe)\n        \n        # === Basic Technical Indicators ===\n        \n        # RSI\n        dataframe['rsi'] = ta.RSI(dataframe, timeperiod=self.rsi_period.value)\n        \n        # MACD\n        macd_result = ta.MACD(dataframe, \n                             fastperiod=self.macd_fast.value,\n                             slowperiod=self.macd_slow.value, \n                             signalperiod=self.macd_signal.value)\n        dataframe['macd'] = macd_result['macd']\n        dataframe['macdsignal'] = macd_result['macdsignal']\n        dataframe['macdhist'] = macd_result['macdhist']\n        \n        # Bollinger Bands\n        bollinger = qtpylib.bollinger_bands(\n            qtpylib.typical_price(dataframe), \n            window=self.bb_period.value, \n            stds=self.bb_std.value\n        )\n        dataframe['bb_lowerband'] = bollinger['lower']\n        dataframe['bb_middleband'] = bollinger['mid']\n        dataframe['bb_upperband'] = bollinger['upper']\n        dataframe['bb_percent'] = (\n            (dataframe['close'] - dataframe['bb_lowerband']) / \n            (dataframe['bb_upperband'] - dataframe['bb_lowerband'])\n        )\n        \n        # Volume indicators\n        dataframe['volume_sma'] = ta.SMA(dataframe['volume'], timeperiod=20)\n        dataframe['volume_ratio'] = dataframe['volume'] / dataframe['volume_sma']\n        \n        # Price momentum\n        dataframe['mom'] = ta.MOM(dataframe, timeperiod=10)\n        dataframe['roc'] = ta.ROC(dataframe, timeperiod=10)\n        \n        # Trend indicators\n        dataframe['ema_fast'] = ta.EMA(dataframe, timeperiod=12)\n        dataframe['ema_slow'] = ta.EMA(dataframe, timeperiod=26)\n        dataframe['trend_strength'] = abs(dataframe['ema_fast'] - dataframe['ema_slow']) / dataframe['close']\n        \n        # === AI-Powered Indicators ===\n        \n        if self.use_ai_signals.value:\n            # Initialize AI columns\n            dataframe['ai_signal'] = 0.0\n            dataframe['ai_confidence'] = 0.0\n            dataframe['ai_risk_score'] = 5.0\n            dataframe['ai_market_regime'] = 0  # 0=neutral, 1=bullish, -1=bearish\n            \n            # Get AI analysis (update every few rows to avoid overloading)\n            if len(dataframe) % 5 == 0:  # Update every 5th candle\n                self._update_ai_indicators(dataframe)\n        \n        # === Multi-timeframe Analysis ===\n        \n        if self.use_multi_timeframe.value:\n            # Add higher timeframe data\n            dataframe = self._add_informative_indicators(dataframe, metadata)\n        \n        return dataframe\n    \n    def _update_ai_indicators(self, dataframe: pd.DataFrame):\n        """Update AI-powered indicators"""\n        try:\n            # Get trading signal from AI\n            ai_signal_data = self.get_mcp_data_sync(\n                "trading_signal", \n                symbol=self.config.get('pair', 'MAGIC/USDT').replace('/', ''),\n                strategy=str(self.strategy_mode.value)\n            )\n            \n            if ai_signal_data:\n                signal_value = ai_signal_data.get('signal_strength', 0.0)\n                confidence = ai_signal_data.get('confidence', 0.0)\n                \n                # Update last rows with AI data\n                dataframe.loc[dataframe.index[-5:], 'ai_signal'] = signal_value\n                dataframe.loc[dataframe.index[-5:], 'ai_confidence'] = confidence\n            \n            # Get risk metrics\n            if self.use_ai_risk_management.value:\n                risk_data = self.get_mcp_data_sync("risk_metrics")\n                if risk_data:\n                    risk_score = risk_data.get('overall_risk_score', 5.0)\n                    dataframe.loc[dataframe.index[-5:], 'ai_risk_score'] = risk_score\n            \n            # Cache for performance\n            self.ai_signals_cache = {\n                'signal': signal_value if 'signal_value' in locals() else 0.0,\n                'confidence': confidence if 'confidence' in locals() else 0.0,\n                'timestamp': datetime.now().timestamp()\n            }\n            \n        except Exception as e:\n            logger.error(f"AI indicator update failed: {e}")\n    \n    def _add_informative_indicators(self, dataframe: pd.DataFrame, metadata: dict) -> pd.DataFrame:\n        """Add higher timeframe indicators"""\n        try:\n            # 1-hour timeframe\n            informative_1h = self.dp.get_pair_dataframe(pair=metadata['pair'], timeframe='1h')\n            informative_1h['rsi_1h'] = ta.RSI(informative_1h, timeperiod=14)\n            informative_1h['ema_50_1h'] = ta.EMA(informative_1h, timeperiod=50)\n            \n            dataframe = merge_informative_pair(dataframe, informative_1h, self.timeframe, '1h', ffill=True)\n            \n            # 4-hour timeframe\n            informative_4h = self.dp.get_pair_dataframe(pair=metadata['pair'], timeframe='4h')\n            informative_4h['trend_4h'] = ta.EMA(informative_4h, timeperiod=20)\n            \n            dataframe = merge_informative_pair(dataframe, informative_4h, self.timeframe, '4h', ffill=True)\n            \n        except Exception as e:\n            logger.error(f"Informative timeframe error: {e}")\n        \n        return dataframe\n    \n    def populate_entry_trend(self, dataframe: pd.DataFrame, metadata: dict) -> pd.DataFrame:\n        """Define enhanced entry signals"""\n        \n        conditions = []\n        \n        # === Technical Analysis Conditions ===\n        \n        # RSI oversold with dynamic threshold\n        rsi_threshold = self.dynamic_params.get('rsi_buy', self.rsi_buy_threshold.value)\n        conditions.append(dataframe['rsi'] < rsi_threshold)\n        \n        # MACD bullish momentum\n        conditions.append(\n            (dataframe['macd'] > dataframe['macdsignal']) &\n            (dataframe['macdhist'] > dataframe['macdhist'].shift(1))\n        )\n        \n        # Bollinger Band bounce\n        conditions.append(\n            (dataframe['close'] <= dataframe['bb_lowerband']) |\n            (dataframe['bb_percent'] < 0.2)\n        )\n        \n        # Volume confirmation\n        conditions.append(dataframe['volume_ratio'] >= self.volume_factor.value)\n        \n        # Trend strength\n        conditions.append(dataframe['trend_strength'] >= self.trend_strength_min.value)\n        \n        # === AI Signal Integration ===\n        \n        if self.use_ai_signals.value:\n            ai_confidence_threshold = self.dynamic_params.get(\n                'ai_confidence', \n                self.ai_confidence_threshold.value\n            )\n            \n            # AI bullish signal with confidence\n            conditions.append(\n                (dataframe['ai_signal'] > 0) &\n                (dataframe['ai_confidence'] >= ai_confidence_threshold)\n            )\n            \n            # Weighted AI signal\n            ai_weight = self.ai_signal_weight.value\n            conditions.append(\n                dataframe['ai_signal'] * ai_weight >= 0.3\n            )\n        \n        # === Risk Management Conditions ===\n        \n        if self.use_ai_risk_management.value:\n            # AI risk score filter\n            conditions.append(dataframe['ai_risk_score'] <= self.max_risk_score.value)\n        \n        # === Multi-timeframe Conditions ===\n        \n        if self.use_multi_timeframe.value and 'rsi_1h' in dataframe.columns:\n            # Higher timeframe confirmation\n            conditions.append(dataframe['rsi_1h'] < 60)  # Not overbought on 1h\n            \n            if 'trend_4h' in dataframe.columns:\n                conditions.append(dataframe['close'] > dataframe['trend_4h'])  # Above 4h trend\n        \n        # === Strategy Mode Adjustments ===\n        \n        strategy_bias = self.dynamic_params.get('strategy_bias', self.strategy_mode.value)\n        \n        if strategy_bias == 'conservative':\n            # Add extra confirmation for conservative mode\n            conditions.append(dataframe['rsi'] < 25)  # Deeper oversold\n            conditions.append(dataframe['volume_ratio'] >= 2.0)  # Higher volume\n            \n        elif strategy_bias == 'aggressive':\n            # Relax some conditions for aggressive mode\n            # Remove one of the less critical conditions\n            if len(conditions) > 3:\n                conditions = conditions[:-1]\n        \n        # Combine all conditions\n        if conditions:\n            dataframe.loc[\n                reduce(lambda x, y: x & y, conditions),\n                'enter_long'\n            ] = 1\n        \n        return dataframe\n    \n    def populate_exit_trend(self, dataframe: pd.DataFrame, metadata: dict) -> pd.DataFrame:\n        """Define enhanced exit signals"""\n        \n        conditions = []\n        \n        # === Technical Exit Conditions ===\n        \n        # RSI overbought\n        conditions.append(dataframe['rsi'] > self.rsi_sell_threshold.value)\n        \n        # MACD bearish crossover\n        conditions.append(\n            (dataframe['macd'] < dataframe['macdsignal']) &\n            (dataframe['macdhist'] < dataframe['macdhist'].shift(1))\n        )\n        \n        # Bollinger Band top\n        conditions.append(\n            (dataframe['close'] >= dataframe['bb_upperband']) |\n            (dataframe['bb_percent'] > 0.9)\n        )\n        \n        # === AI Exit Signals ===\n        \n        if self.use_ai_signals.value:\n            # AI bearish signal\n            conditions.append(\n                (dataframe['ai_signal'] < -0.3) &\n                (dataframe['ai_confidence'] >= 0.6)\n            )\n        \n        # === Risk Management Exits ===\n        \n        if self.use_ai_risk_management.value:\n            # High risk score exit\n            conditions.append(dataframe['ai_risk_score'] > 8.5)\n        \n        # === Multi-timeframe Exits ===\n        \n        if self.use_multi_timeframe.value and 'rsi_1h' in dataframe.columns:\n            # Higher timeframe overbought\n            conditions.append(dataframe['rsi_1h'] > 80)\n        \n        # Combine exit conditions (any condition triggers exit)\n        if conditions:\n            dataframe.loc[\n                reduce(lambda x, y: x | y, conditions),\n                'exit_long'\n            ] = 1\n        \n        return dataframe\n    \n    def custom_stoploss(self, pair: str, trade: 'Trade', current_time: datetime,\n                       current_rate: float, current_profit: float, **kwargs) -> float:\n        """Dynamic stoploss based on AI risk assessment"""\n        \n        if not self.use_ai_risk_management.value:\n            return self.stoploss\n        \n        try:\n            # Get current risk assessment\n            risk_data = self.get_mcp_data_sync("risk_metrics")\n            \n            if risk_data:\n                risk_score = risk_data.get('overall_risk_score', 5.0)\n                \n                # Adjust stoploss based on risk\n                if risk_score > 8.0:\n                    # High risk - tighter stop\n                    return -0.08\n                elif risk_score < 4.0:\n                    # Low risk - wider stop\n                    return -0.18\n            \n            # Default stoploss\n            return self.stoploss\n            \n        except Exception as e:\n            logger.error(f"Custom stoploss error: {e}")\n            return self.stoploss\n    \n    def custom_exit(self, pair: str, trade: 'Trade', current_time: datetime, \n                   current_rate: float, current_profit: float, **kwargs) -> Optional[str]:\n        """Custom exit logic with AI portfolio optimization"""\n        \n        try:\n            # Portfolio optimization check\n            if self.use_ai_risk_management.value:\n                portfolio_data = self.get_mcp_data_sync("portfolio_optimization")\n                \n                if portfolio_data:\n                    recommendations = portfolio_data.get('recommendations', {})\n                    \n                    # Check if position should be reduced\n                    for symbol, action in recommendations.items():\n                        if symbol.upper() in pair.upper() and action.get('action') == 'reduce':\n                            return f"AI portfolio optimization: reduce {symbol}"\n            \n            # Profit target based on AI confidence\n            if current_profit > 0.15:  # 15% profit\n                ai_data = self.ai_signals_cache\n                if ai_data.get('confidence', 0) < 0.5:\n                    return "Low AI confidence - take profit"\n            \n            return None\n            \n        except Exception as e:\n            logger.error(f"Custom exit error: {e}")\n            return None\n    \n    def leverage(self, pair: str, current_time: datetime, current_rate: float,\n                proposed_leverage: float, max_leverage: float, entry_tag: Optional[str], side: str,\n                **kwargs) -> float:\n        """Dynamic leverage based on AI risk assessment"""\n        \n        if not self.use_ai_risk_management.value:\n            return 1.0  # No leverage\n        \n        try:\n            risk_data = self.get_mcp_data_sync("risk_metrics")\n            \n            if risk_data:\n                risk_score = risk_data.get('overall_risk_score', 5.0)\n                portfolio_heat = risk_data.get('portfolio_heat', 0.5)\n                \n                # Calculate safe leverage\n                if risk_score > 7.0 or portfolio_heat > 0.8:\n                    return 1.0  # No leverage in high risk\n                elif risk_score < 4.0 and portfolio_heat < 0.3:\n                    return min(2.0, max_leverage)  # Conservative leverage\n                else:\n                    return 1.0  # Default no leverage\n            \n            return 1.0\n            \n        except Exception as e:\n            logger.error(f"Leverage calculation error: {e}")\n            return 1.0\n    \n    def informative_pairs(self):\n        """Define informative pairs for multi-timeframe analysis"""\n        pairs = self.dp.current_whitelist()\n        informative_pairs = []\n        \n        for timeframe in self.informative_timeframes:\n            informative_pairs.extend([(pair, timeframe) for pair in pairs])\n        \n        return informative_pairs\n    \n    def confirm_trade_entry(self, pair: str, order_type: str, amount: float,\n                           rate: float, time_in_force: str, current_time: datetime,\n                           entry_tag: Optional[str], side: str, **kwargs) -> bool:\n        """Final trade confirmation with AI validation"""\n        \n        try:\n            if self.use_ai_signals.value:\n                # Get real-time AI validation\n                signal_data = self.get_mcp_data_sync(\n                    "trading_signal",\n                    symbol=pair.replace('/', ''),\n                    strategy=str(self.strategy_mode.value)\n                )\n                \n                if signal_data:\n                    ai_signal = signal_data.get('signal_strength', 0)\n                    confidence = signal_data.get('confidence', 0)\n                    \n                    # Require positive AI signal for entry\n                    if ai_signal <= 0 or confidence < 0.6:\n                        logger.info(f"AI rejected entry for {pair}: signal={ai_signal}, confidence={confidence}")\n                        return False\n            \n            # Portfolio heat check\n            if self.use_ai_risk_management.value:\n                risk_data = self.get_mcp_data_sync("risk_metrics")\n                if risk_data:\n                    portfolio_heat = risk_data.get('portfolio_heat', 0)\n                    if portfolio_heat > 0.9:\n                        logger.info(f"Portfolio heat too high: {portfolio_heat}")\n                        return False\n            \n            return True\n            \n        except Exception as e:\n            logger.error(f"Trade confirmation error: {e}")\n            return True  # Default to allow trade\n    \n    def bot_start(self, **kwargs) -> None:\n        """Initialize strategy on bot start"""\n        logger.info("🚀 Enhanced VictoryChain MCP Strategy initialized")\n        logger.info(f"Strategy mode: {self.strategy_mode.value}")\n        logger.info(f"AI signals enabled: {self.use_ai_signals.value}")\n        logger.info(f"AI risk management enabled: {self.use_ai_risk_management.value}")\n        \n        # Initialize MCP connection\n        self._init_mcp_connection()\n    \n    def bot_loop_start(self, **kwargs) -> None:\n        """Called at the start of each bot iteration"""\n        # Update AI cache periodically\n        current_time = datetime.now().timestamp()\n        \n        for cache_key in list(self.last_mcp_update.keys()):\n            if current_time - self.last_mcp_update.get(cache_key, 0) > 60:  # Update every minute\n                # Refresh cache in background\n                self.last_mcp_update[cache_key] = current_time
