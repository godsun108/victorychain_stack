    # Prompt generation methods
    async def _generate_market_analysis_prompt(self, focus: str = None) -> str:
        """Generate market analysis prompt"""
        market_data = await self._get_market_data()
        portfolio_data = await self._get_portfolio_data()
        
        prompt = f"""
Analyze the current cryptocurrency market conditions based on the following data:

Market Data:
{json.dumps(market_data, indent=2)}

Portfolio Data:
{json.dumps(portfolio_data, indent=2)}

Please provide:
1. Overall market sentiment analysis
2. Key trends and patterns
3. Risk factors to monitor
4. Trading opportunities
5. Portfolio-specific recommendations

"""
        if focus:
            prompt += f"Focus particularly on: {focus}\n"
        
        return prompt
    
    async def _generate_risk_assessment_prompt(self, timeframe: str = "1w") -> str:
        """Generate risk assessment prompt"""
        risk_data = await self._get_risk_analysis()
        portfolio_data = await self._get_portfolio_data()
        
        return f"""
Conduct a comprehensive risk assessment for the VictoryChain portfolio:

Risk Analysis:
{json.dumps(risk_data, indent=2)}

Portfolio Data:
{json.dumps(portfolio_data, indent=2)}

Timeframe: {timeframe}

Please assess:
1. Current risk exposure levels
2. Concentration risk analysis
3. Market correlation risks
4. Liquidity concerns
5. Stress test scenarios
6. Risk mitigation recommendations
7. Position sizing adjustments

Provide specific, actionable recommendations for risk management.
"""
    
    async def _generate_strategy_recommendation_prompt(self, risk_profile: str = "medium") -> str:
        """Generate strategy recommendation prompt"""
        portfolio_data = await self._get_portfolio_data()
        market_data = await self._get_market_data()
        strategies_data = await self._get_strategies()
        
        return f"""
Recommend optimal trading strategies based on current conditions:

Portfolio Status:
{json.dumps(portfolio_data, indent=2)}

Market Conditions:
{json.dumps(market_data, indent=2)}

Current Strategies:
{json.dumps(strategies_data, indent=2)}

Risk Profile: {risk_profile}

Please recommend:
1. Strategy adjustments for current market conditions
2. New strategy opportunities
3. Entry/exit timing considerations
4. Risk management parameters
5. Portfolio rebalancing suggestions
6. Performance optimization tactics

Tailor recommendations to the {risk_profile} risk profile.
"""

class VictoryChainMCPHTTPServer(VictoryChainMCPServer):
    """
    HTTP wrapper for MCP server to support REST API access
    Enables integration with any trading framework via HTTP
    """
    
    def __init__(self, port: int = 8080):
        super().__init__()
        self.port = port
        self.app = Flask(__name__)
        CORS(self.app)  # Enable CORS for web access
        self.setup_routes()
    
    def setup_routes(self):
        """Setup HTTP routes for MCP functions"""
        
        @self.app.route('/mcp/initialize', methods=['POST'])
        async def http_initialize():
            """HTTP endpoint for MCP initialize"""
            params = request.json or {}
            result = await self.handle_initialize(params)
            return jsonify(result)
        
        @self.app.route('/mcp/resources', methods=['GET'])
        async def http_list_resources():
            """HTTP endpoint for listing resources"""
            result = await self.handle_list_resources()
            return jsonify(result)
        
        @self.app.route('/mcp/resources/<path:uri>', methods=['GET'])
        async def http_read_resource(uri):
            """HTTP endpoint for reading resources"""
            # Decode URI
            full_uri = f"victorychain://{uri}"
            result = await self.handle_read_resource(full_uri)
            return jsonify(result)
        
        @self.app.route('/mcp/tools', methods=['GET'])
        async def http_list_tools():
            """HTTP endpoint for listing tools"""
            result = await self.handle_list_tools()
            return jsonify(result)
        
        @self.app.route('/mcp/tools/<tool_name>', methods=['POST'])
        async def http_call_tool(tool_name):
            """HTTP endpoint for calling tools"""
            arguments = request.json or {}
            result = await self.handle_call_tool(tool_name, arguments)
            return jsonify(result)
        
        @self.app.route('/mcp/prompts', methods=['GET'])
        async def http_list_prompts():
            """HTTP endpoint for listing prompts"""
            result = await self.handle_list_prompts()
            return jsonify(result)
        
        @self.app.route('/mcp/prompts/<prompt_name>', methods=['POST'])
        async def http_get_prompt(prompt_name):
            """HTTP endpoint for getting prompts"""
            arguments = request.json or {}
            result = await self.handle_get_prompt(prompt_name, arguments)
            return jsonify(result)
        
        # Convenience endpoints for trading frameworks
        @self.app.route('/api/portfolio', methods=['GET'])
        async def api_portfolio():
            """Simple portfolio API"""
            portfolio = await self._get_portfolio_data()
            return jsonify(portfolio)
        
        @self.app.route('/api/market/<symbol>', methods=['GET'])
        async def api_market_symbol(symbol):
            """Get market data for specific symbol"""
            analysis = await self._analyze_token(symbol)
            return jsonify(analysis)
        
        @self.app.route('/api/signal/<symbol>', methods=['GET'])
        async def api_trading_signal(symbol):
            """Get trading signal for symbol"""
            strategy = request.args.get('strategy', 'momentum')
            risk_tolerance = request.args.get('risk', 'medium')
            
            signal = await self._generate_trading_signal(
                symbol, strategy, risk_tolerance
            )
            return jsonify(signal)
        
        @self.app.route('/api/risk', methods=['GET'])
        async def api_risk_metrics():
            """Get portfolio risk metrics"""
            scope = request.args.get('scope', 'portfolio')
            timeframe = request.args.get('timeframe', '1w')
            
            risk = await self._calculate_risk_metrics(scope, None, timeframe)
            return jsonify(risk)
        
        @self.app.route('/api/optimize', methods=['POST'])
        async def api_optimize_portfolio():
            """Portfolio optimization API"""
            params = request.json or {}
            target_risk = params.get('target_risk', 0.15)
            rebalance_threshold = params.get('rebalance_threshold', 0.05)
            max_position_size = params.get('max_position_size', 0.3)
            
            optimization = await self._optimize_portfolio(
                target_risk, rebalance_threshold, max_position_size
            )
            return jsonify(optimization)
        
        @self.app.route('/health', methods=['GET'])
        def health_check():
            """Health check endpoint"""
            return jsonify({
                "status": "healthy",
                "server": "VictoryChain MCP Server",
                "version": "1.0.0",
                "timestamp": datetime.now().isoformat(),
                "capabilities": ["resources", "tools", "prompts", "http_api"]
            })
    
    def run(self):
        """Run the HTTP MCP server"""
        print(f"🌐 VictoryChain MCP HTTP Server starting on port {self.port}")
        print(f"📊 Available endpoints:")
        print(f"   • GET  /health - Health check")
        print(f"   • GET  /mcp/resources - List data resources")
        print(f"   • GET  /mcp/resources/<uri> - Read resource")
        print(f"   • GET  /mcp/tools - List available tools")
        print(f"   • POST /mcp/tools/<name> - Call tool")
        print(f"   • GET  /api/portfolio - Portfolio data")
        print(f"   • GET  /api/market/<symbol> - Market analysis")
        print(f"   • GET  /api/signal/<symbol> - Trading signals")
        print(f"   • GET  /api/risk - Risk metrics")
        print(f"   • POST /api/optimize - Portfolio optimization")
        
        self.app.run(host='0.0.0.0', port=self.port, debug=False)

def main():
    """Main entry point for MCP server"""
    import argparse
    import asyncio
    import json
    import sys
    
    parser = argparse.ArgumentParser(description="VictoryChain MCP Server")
    parser.add_argument("--port", type=int, default=8080, help="Server port")
    parser.add_argument("--host", default="localhost", help="Server host")
    parser.add_argument("--log-level", default="INFO", help="Logging level")
    
    args = parser.parse_args()
    
    # Configure logging
    logging.basicConfig(
        level=getattr(logging, args.log_level.upper()),
        format='%(asctime)s - %(name)s - %(levelname)s - %(message)s'
    )
    
    # Initialize MCP server
    server = VictoryChainMCPServer()
    
    print(f"🔗 VictoryChain MCP Server starting on {args.host}:{args.port}")
    print("🚀 Ready to serve AI models with trading intelligence")
    print("📊 Available resources: portfolio, market_data, trading_history, risk_analysis, strategies")
    print("🛠️  Available tools: analyze_token, calculate_risk_metrics, generate_trading_signal, optimize_portfolio, backtest_strategy")
    print("💡 Available prompts: analyze_market_conditions, risk_assessment, strategy_recommendation")
    
    # Keep server running
    try:
        asyncio.run(server_loop(server, args.host, args.port))
    except KeyboardInterrupt:
        print("\n🛑 Server shutting down...")

async def server_loop(server, host, port):
    """Simple server loop for demonstration"""
    while True:
        await asyncio.sleep(1)

if __name__ == "__main__":
    main()
