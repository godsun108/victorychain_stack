import asyncio
import json
import logging
from typing import Dict, List, Optional, Any, Union
from dataclasses import dataclass, asdict
from datetime import datetime, timedelta
from pathlib import Path
import sys
import os

# Add project root to path
project_root = Path(__file__).parent.parent.parent
sys.path.insert(0, str(project_root))

from binance.client import Client
from dotenv import load_dotenv

# Load environment variables
load_dotenv(dotenv_path=project_root / 'config' / '.env')

# Add Flask support for HTTP MCP endpoints
from flask import Flask, request, jsonify
from flask_cors import CORS

@dataclass
class MCPResource:
    """MCP Resource representation"""
    uri: str
    name: str
    description: str
    mimeType: str = "application/json"

@dataclass
class MCPTool:
    """MCP Tool representation"""
    name: str
    description: str
    inputSchema: Dict[str, Any]

@dataclass
class MCPPrompt:
    """MCP Prompt representation"""
    name: str
    description: str
    arguments: List[Dict[str, Any]]

class VictoryChainMCPServer:
    """
    Model Context Protocol server for VictoryChain trading system
    Provides AI models with structured access to trading data and operations
    """
    
    def __init__(self):
        self.logger = logging.getLogger(__name__)
        self.binance_client = None
        self.portfolio_data = {}
        self.market_data = {}
        self.trading_history = []
        
        # Initialize Binance client
        self._init_binance_client()
        
        # MCP Server capabilities
        self.capabilities = {
            "resources": True,
            "tools": True,
            "prompts": True,
            "logging": True
        }
        
        # Define available resources
        self.resources = [
            MCPResource(
                uri="victorychain://portfolio",
                name="portfolio",
                description="Real-time portfolio data with positions, P&L, and risk metrics"
            ),
            MCPResource(
                uri="victorychain://market_data",
                name="market_data",
                description="Live market data including prices, volumes, and technical indicators"
            ),
            MCPResource(
                uri="victorychain://trading_history",
                name="trading_history",
                description="Historical trading data and performance analytics"
            ),
            MCPResource(
                uri="victorychain://risk_analysis",
                name="risk_analysis",
                description="Comprehensive risk analysis and exposure metrics"
            ),
            MCPResource(
                uri="victorychain://strategies",
                name="strategies",
                description="Active trading strategies and their performance"
            )
        ]
        
        # Define available tools
        self.tools = [
            MCPTool(
                name="analyze_token",
                description="Perform comprehensive analysis of a specific token",
                inputSchema={
                    "type": "object",
                    "properties": {
                        "symbol": {"type": "string", "description": "Token symbol (e.g., MAGIC, BTC)"},
                        "timeframe": {"type": "string", "enum": ["1h", "4h", "1d", "1w"], "default": "1d"},
                        "include_technical": {"type": "boolean", "default": True},
                        "include_sentiment": {"type": "boolean", "default": True}
                    },
                    "required": ["symbol"]
                }
            ),
            MCPTool(
                name="calculate_risk_metrics",
                description="Calculate comprehensive risk metrics for portfolio or position",
                inputSchema={
                    "type": "object",
                    "properties": {
                        "scope": {"type": "string", "enum": ["portfolio", "position"], "default": "portfolio"},
                        "symbol": {"type": "string", "description": "Token symbol for position analysis"},
                        "timeframe": {"type": "string", "enum": ["1d", "1w", "1m"], "default": "1w"}
                    }
                }
            ),
            MCPTool(
                name="generate_trading_signal",
                description="Generate AI-powered trading signals based on analysis",
                inputSchema={
                    "type": "object",
                    "properties": {
                        "symbol": {"type": "string", "description": "Token symbol"},
                        "strategy": {"type": "string", "enum": ["momentum", "mean_reversion", "breakout"], "default": "momentum"},
                        "risk_tolerance": {"type": "string", "enum": ["low", "medium", "high"], "default": "medium"}
                    },
                    "required": ["symbol"]
                }
            ),
            MCPTool(
                name="optimize_portfolio",
                description="Suggest portfolio optimization based on risk and return analysis",
                inputSchema={
                    "type": "object",
                    "properties": {
                        "target_risk": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.15},
                        "rebalance_threshold": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.05},
                        "max_position_size": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.3}
                    }
                }
            ),
            MCPTool(
                name="backtest_strategy",
                description="Backtest trading strategy with historical data",
                inputSchema={
                    "type": "object",
                    "properties": {
                        "strategy_name": {"type": "string", "description": "Name of strategy to backtest"},
                        "start_date": {"type": "string", "format": "date", "description": "Start date for backtest"},
                        "end_date": {"type": "string", "format": "date", "description": "End date for backtest"},
                        "initial_capital": {"type": "number", "minimum": 1000, "default": 10000}
                    },
                    "required": ["strategy_name", "start_date", "end_date"]
                }
            )
        ]
        
        # Define available prompts
        self.prompts = [
            MCPPrompt(
                name="analyze_market_conditions",
                description="Analyze current market conditions and provide trading insights",
                arguments=[
                    {"name": "focus", "description": "Market focus area", "required": False}
                ]
            ),
            MCPPrompt(
                name="risk_assessment",
                description="Comprehensive risk assessment of current portfolio",
                arguments=[
                    {"name": "timeframe", "description": "Assessment timeframe", "required": False}
                ]
            ),
            MCPPrompt(
                name="strategy_recommendation",
                description="Recommend optimal trading strategies based on current conditions",
                arguments=[
                    {"name": "risk_profile", "description": "Risk tolerance level", "required": False}
                ]
            )
        ]
    
    def _init_binance_client(self):
        """Initialize Binance client for market data"""
        try:
            api_key = os.getenv('BINANCEUS_KEY')
            secret_key = os.getenv('BINANCEUS_SECRET')
            if api_key and secret_key:
                self.binance_client = Client(api_key, secret_key, tld='us')
                self.logger.info("Binance client initialized for MCP server")
            else:
                self.logger.warning("Binance API keys not found - using mock data")
        except Exception as e:
            self.logger.error(f"Failed to initialize Binance client: {e}")
    
    async def handle_initialize(self, params: Dict[str, Any]) -> Dict[str, Any]:
        """Handle MCP initialize request"""
        return {
            "protocolVersion": "2024-11-05",
            "capabilities": self.capabilities,
            "serverInfo": {
                "name": "victorychain-mcp-server",
                "version": "1.0.0",
                "description": "VictoryChain AI Trading System MCP Server"
            }
        }
    
    async def handle_list_resources(self) -> Dict[str, Any]:
        """Handle list resources request"""
        return {
            "resources": [asdict(resource) for resource in self.resources]
        }
    
    async def handle_list_tools(self) -> Dict[str, Any]:
        """Handle list tools request"""
        return {
            "tools": [asdict(tool) for tool in self.tools]
        }
    
    async def handle_list_prompts(self) -> Dict[str, Any]:
        """Handle list prompts request"""
        return {
            "prompts": [asdict(prompt) for prompt in self.prompts]
        }
    
    async def handle_read_resource(self, uri: str) -> Dict[str, Any]:
        """Handle read resource request"""
        try:
            if uri == "victorychain://portfolio":
                portfolio_data = await self._get_portfolio_data()
                return {
                    "contents": [{
                        "uri": uri,
                        "mimeType": "application/json",
                        "text": json.dumps(portfolio_data, indent=2)
                    }]
                }
            elif uri == "victorychain://market_data":
                market_data = await self._get_market_data()
                return {
                    "contents": [{
                        "uri": uri,
                        "mimeType": "application/json",
                        "text": json.dumps(market_data, indent=2)
                    }]
                }
            elif uri == "victorychain://trading_history":
                trading_history = await self._get_trading_history()
                return {
                    "contents": [{
                        "uri": uri,
                        "mimeType": "application/json",
                        "text": json.dumps(trading_history, indent=2)
                    }]
                }
            elif uri == "victorychain://risk_analysis":
                risk_analysis = await self._get_risk_analysis()
                return {
                    "contents": [{
                        "uri": uri,
                        "mimeType": "application/json",
                        "text": json.dumps(risk_analysis, indent=2)
                    }]
                }
            elif uri == "victorychain://strategies":
                strategies = await self._get_strategies()
                return {
                    "contents": [{
                        "uri": uri,
                        "mimeType": "application/json",
                        "text": json.dumps(strategies, indent=2)
                    }]
                }
            else:
                raise ValueError(f"Unknown resource URI: {uri}")
        except Exception as e:
            self.logger.error(f"Error reading resource {uri}: {e}")
            raise
    
    async def handle_call_tool(self, name: str, arguments: Dict[str, Any]) -> Dict[str, Any]:
        """Handle tool call request"""
        try:
            if name == "analyze_token":
                result = await self._analyze_token(**arguments)
            elif name == "calculate_risk_metrics":
                result = await self._calculate_risk_metrics(**arguments)
            elif name == "generate_trading_signal":
                result = await self._generate_trading_signal(**arguments)
            elif name == "optimize_portfolio":
                result = await self._optimize_portfolio(**arguments)
            elif name == "backtest_strategy":
                result = await self._backtest_strategy(**arguments)
            else:
                raise ValueError(f"Unknown tool: {name}")
            
            return {
                "content": [{
                    "type": "text",
                    "text": json.dumps(result, indent=2)
                }]
            }
        except Exception as e:
            self.logger.error(f"Error calling tool {name}: {e}")
            return {
                "content": [{
                    "type": "text",
                    "text": f"Error: {str(e)}"
                }],
                "isError": True
            }
    
    async def handle_get_prompt(self, name: str, arguments: Dict[str, Any]) -> Dict[str, Any]:
        """Handle get prompt request"""
        try:
            if name == "analyze_market_conditions":
                prompt = await self._generate_market_analysis_prompt(**arguments)
            elif name == "risk_assessment":
                prompt = await self._generate_risk_assessment_prompt(**arguments)
            elif name == "strategy_recommendation":
                prompt = await self._generate_strategy_recommendation_prompt(**arguments)
            else:
                raise ValueError(f"Unknown prompt: {name}")
            
            return {
                "description": f"Generated prompt for {name}",
                "messages": [{
                    "role": "user",
                    "content": {
                        "type": "text",
                        "text": prompt
                    }
                }]
            }
        except Exception as e:
            self.logger.error(f"Error generating prompt {name}: {e}")
            raise
    
    # Resource data methods
    async def _get_portfolio_data(self) -> Dict[str, Any]:
        """Get current portfolio data"""
        try:
            if self.binance_client:
                account = self.binance_client.get_account()
                balances = [
                    {
                        "asset": balance['asset'],
                        "free": float(balance['free']),
                        "locked": float(balance['locked']),
                        "total": float(balance['free']) + float(balance['locked'])
                    }
                    for balance in account['balances']
                    if float(balance['free']) > 0 or float(balance['locked']) > 0
                ]
                
                return {
                    "timestamp": datetime.now().isoformat(),
                    "total_value_usd": 191.80,  # Example value
                    "balances": balances,
                    "positions": [
                        {
                            "symbol": "MAGIC",
                            "amount": 660.1455,
                            "value_usd": 187.35,
                            "percentage": 97.7,
                            "unrealized_pnl": 58.95
                        }
                    ],
                    "risk_metrics": {
                        "concentration_risk": "VERY HIGH",
                        "volatility_score": 0.85,
                        "var_95": 0.12
                    }
                }
            else:
                # Mock data
                return {
                    "timestamp": datetime.now().isoformat(),
                    "total_value_usd": 191.80,
                    "positions": [{"symbol": "MAGIC", "amount": 660.1455, "value_usd": 187.35}],
                    "status": "mock_data"
                }
        except Exception as e:
            self.logger.error(f"Error getting portfolio data: {e}")
            return {"error": str(e)}
    
    async def _get_market_data(self) -> Dict[str, Any]:
        """Get current market data"""
        try:
            if self.binance_client:
                # Get ticker data for major pairs
                btc_ticker = self.binance_client.get_symbol_ticker(symbol="BTCUSDT")
                eth_ticker = self.binance_client.get_symbol_ticker(symbol="ETHUSDT")
                magic_ticker = self.binance_client.get_symbol_ticker(symbol="MAGICUSDT")
                
                return {
                    "timestamp": datetime.now().isoformat(),
                    "prices": {
                        "BTC": float(btc_ticker['price']),
                        "ETH": float(eth_ticker['price']),
                        "MAGIC": float(magic_ticker['price'])
                    },
                    "market_cap": {
                        "total": 1200000000000,  # $1.2T
                        "btc_dominance": 45.2
                    },
                    "fear_greed_index": 72,
                    "volatility_index": 0.65
                }
            else:
                return {
                    "timestamp": datetime.now().isoformat(),
                    "prices": {"BTC": 45000, "ETH": 2800, "MAGIC": 0.2838},
                    "status": "mock_data"
                }
        except Exception as e:
            self.logger.error(f"Error getting market data: {e}")
            return {"error": str(e)}
    
